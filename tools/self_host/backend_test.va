// ============================================================================
// Verification Suite for Vanta-C Native Backend (in pure Vanta)
// ============================================================================

mod backend;

import backend::{
    make_backend_emitter, compute_frame_layout, FrameLayout,
    REG_RAX, REG_RCX, REG_RDX, REG_RBX, REG_RSP, REG_RBP, REG_RSI, REG_RDI,
    REG_R8, REG_R9, REG_R10, REG_R11, REG_R12, REG_R13, REG_R14, REG_R15,
    abi_arg_reg, abi_ret_reg,
    CC_EQ, CC_NE, CC_LT, CC_LE, CC_GT, CC_GE,
    rex_prefix, modrm_byte, sib_byte, elf64_machine_x86_64,
    elf64_magic_0, elf64_magic_1, elf64_magic_2, elf64_magic_3
};

fn test_registers() -> i64 {
    if REG_RAX() != 0 { return 1; }
    if REG_RCX() != 1 { return 2; }
    if REG_RDX() != 2 { return 3; }
    if REG_RBX() != 3 { return 4; }
    if REG_RSP() != 4 { return 5; }
    if REG_RBP() != 5 { return 6; }
    if REG_RSI() != 6 { return 7; }
    if REG_RDI() != 7 { return 8; }
    if REG_R8()  != 8 { return 9; }
    if REG_R9()  != 9 { return 10; }
    if REG_R15() != 15 { return 11; }
    return 0;
}

fn test_abi_calling_convention() -> i64 {
    if abi_arg_reg(0) != REG_RDI() { return 12; }
    if abi_arg_reg(1) != REG_RSI() { return 13; }
    if abi_arg_reg(2) != REG_RDX() { return 14; }
    if abi_arg_reg(3) != REG_RCX() { return 15; }
    if abi_arg_reg(4) != REG_R8()  { return 16; }
    if abi_arg_reg(5) != REG_R9()  { return 17; }
    if abi_ret_reg()  != REG_RAX() { return 18; }
    return 0;
}

fn test_frame_layout_alignment() -> i64 {
    let mut i = 0;
    while i < 20 {
        let layout = compute_frame_layout(i, 3);
        let rem = layout.stack_size % 16;
        if rem != 0 {
            return 19;
        }
        if layout.stack_size < 32 {
            return 20;
        }
        i = i + 1;
    }
    return 0;
}

fn test_condition_codes() -> i64 {
    if CC_EQ() != 0 { return 21; }
    if CC_NE() != 1 { return 22; }
    if CC_LT() != 2 { return 23; }
    if CC_LE() != 3 { return 24; }
    if CC_GT() != 4 { return 25; }
    if CC_GE() != 5 { return 26; }
    return 0;
}

fn test_binary_encoding() -> i64 {
    // REX.W prefix: 0x48 = 72
    let rex_w = rex_prefix(1, 0, 0, 0);
    if rex_w != 72 { return 27; }

    // REX.WRXB prefix: 0x4F = 79
    let rex_all = rex_prefix(1, 1, 1, 1);
    if rex_all != 79 { return 28; }

    // ModR/M byte: mode=3 (register-direct), reg=0 (rax), rm=3 (rbx) => 3*64 + 0*8 + 3 = 195 (0xC3)
    let m = modrm_byte(3, 0, 3);
    if m != 195 { return 29; }

    // SIB byte: scale=2, index=1, base=5 => 2*64 + 1*8 + 5 = 141 (0x8D)
    let s = sib_byte(2, 1, 5);
    if s != 141 { return 30; }

    // ELF64 AMD64 machine id = 62 (0x3E)
    if elf64_machine_x86_64() != 62 { return 31; }

    // ELF64 Magic: 0x7F, 'E', 'L', 'F' (127, 69, 76, 70)
    if elf64_magic_0() != 127 { return 32; }
    if elf64_magic_1() != 69  { return 33; }
    if elf64_magic_2() != 76  { return 34; }
    if elf64_magic_3() != 70  { return 35; }

    return 0;
}

fn test_emitter_labels() -> i64 {
    let mut emitter = make_backend_emitter();
    let l0 = emitter.new_label_id();
    let l1 = emitter.new_label_id();
    let l2 = emitter.new_label_id();
    if l0 != 0 { return 36; }
    if l1 != 1 { return 37; }
    if l2 != 2 { return 38; }
    return 0;
}

fn main() -> i64 {
    let mut err = test_registers();
    if err != 0 { return err; }

    err = test_abi_calling_convention();
    if err != 0 { return err; }

    err = test_frame_layout_alignment();
    if err != 0 { return err; }

    err = test_condition_codes();
    if err != 0 { return err; }

    err = test_binary_encoding();
    if err != 0 { return err; }

    err = test_emitter_labels();
    if err != 0 { return err; }

    // All tests passed! Return success code 100
    return 100;
}
