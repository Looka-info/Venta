fn test_eq(a: i64, b: i64) -> i64 {
    if a == b { return 1; } else { return 0; }
}

fn test_ne(a: i64, b: i64) -> i64 {
    if a != b { return 1; } else { return 0; }
}

fn test_lt(a: i64, b: i64) -> i64 {
    if a < b { return 1; } else { return 0; }
}

fn test_le(a: i64, b: i64) -> i64 {
    if a <= b { return 1; } else { return 0; }
}

fn test_gt(a: i64, b: i64) -> i64 {
    if a > b { return 1; } else { return 0; }
}

fn test_ge(a: i64, b: i64) -> i64 {
    if a >= b { return 1; } else { return 0; }
}

fn main() -> i64 {
    let mut score = 0;
    if test_eq(5, 5) == 1 { score = score + 1; }
    if test_ne(5, 6) == 1 { score = score + 2; }
    if test_lt(4, 9) == 1 { score = score + 4; }
    if test_le(9, 9) == 1 { score = score + 8; }
    if test_gt(8, 3) == 1 { score = score + 16; }
    if test_ge(7, 7) == 1 { score = score + 32; }
    return score;
}
