{
  "name": "venta-lang",
  "version": "1.0.0-rc.2",
  "description": "Venta - Performance-first, memory-safe systems programming language with a custom SSA optimizer, multi-platform native backends (Linux, Windows, macOS ARM64), and a pure-Rust linker",
  "main": "packages/vanta-lang/bin/venta.js",
  "bin": {
    "venta": "packages/vanta-lang/bin/venta.js",
    "ventac": "packages/vanta-lang/bin/ventac.js",
    "vanta": "packages/vanta-lang/bin/vanta.js",
    "vantac": "packages/vanta-lang/bin/vantac.js"
  },
  "scripts": {
    "start": "node packages/vanta-lang/bin/venta.js run www/server.va",
    "serve": "node packages/vanta-lang/bin/venta.js run www/server.va",
    "page": "node packages/vanta-lang/bin/venta.js run www/main.va",
    "ventanext": "node packages/vanta-lang/bin/venta.js run ventanext/main.va",
    "postinstall": "node packages/vanta-lang/scripts/install-binary.js",
    "test": "node packages/vanta-lang/bin/venta.js --version"
  },
  "keywords": [
    "venta",
    "vanta",
    "compiler",
    "systems-programming",
    "x86-64",
    "aarch64",
    "arm64",
    "windows",
    "macos",
    "linux",
    "apple-silicon",
    "native",
    "no-llvm",
    "no-gc",
    "programming-language"
  ],
  "author": "Venta Language Contributors",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Looka-info/Venta.git"
  },
  "bugs": {
    "url": "https://github.com/Looka-info/Venta/issues"
  },
  "homepage": "https://github.com/Looka-info/Venta#readme",
  "engines": {
    "node": ">=16.0.0"
  }
}
