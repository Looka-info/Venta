{
  "name": "vanta-lang",
  "version": "1.0.0-rc.2",
  "description": "Vanta - Performance-first, memory-safe systems programming language with a custom SSA optimizer and native x86-64 backend (no LLVM)",
  "main": "packages/vanta-lang/bin/vanta.js",
  "bin": {
    "vanta": "packages/vanta-lang/bin/vanta.js",
    "vantac": "packages/vanta-lang/bin/vantac.js"
  },
  "scripts": {
    "start": "node packages/vanta-lang/bin/vanta.js run www/server.va",
    "serve": "node packages/vanta-lang/bin/vanta.js run www/server.va",
    "page": "node packages/vanta-lang/bin/vanta.js run www/main.va",
    "ventanext": "node packages/vanta-lang/bin/vanta.js run ventanext/main.va",
    "postinstall": "node packages/vanta-lang/scripts/install-binary.js",
    "test": "node packages/vanta-lang/bin/vanta.js --version"
  },
  "keywords": [
    "vanta",
    "venta",
    "compiler",
    "systems-programming",
    "x86-64",
    "native",
    "no-llvm",
    "no-gc",
    "programming-language"
  ],
  "author": "Vanta Language Contributors",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Looka-info/Venta.git"
  },
  "bugs": {
    "url": "https://github.com/Looka-info/Venta/issues"
  },
  "homepage": "https://github.com/Looka-info/Venta#readme",
  "engines": {
    "node": ">=16.0.0"
  }
}
