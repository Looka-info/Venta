// ============================================================================
// Vanta-C Compiler: Lexical Scanner (pure Vanta)
// ============================================================================

import tokens::{
    Token, make_token,
    TOK_EOF, TOK_FN, TOK_LET, TOK_MUT, TOK_RETURN, TOK_IF, TOK_ELSE, TOK_WHILE,
    TOK_IDENT, TOK_INT, TOK_LPAREN, TOK_RPAREN, TOK_LBRACE, TOK_RBRACE,
    TOK_SEMI, TOK_COMMA, TOK_COLON, TOK_ARROW, TOK_ASSIGN,
    TOK_PLUS, TOK_MINUS, TOK_STAR, TOK_SLASH,
    TOK_EQ, TOK_NE, TOK_LT, TOK_LE, TOK_GT, TOK_GE
};

import std::string::String;
import std::option::Option;

pub struct Lexer {
    pub src: String,
    pub pos: i64,
    pub len: i64,
}

pub fn make_lexer(source: &str) -> Lexer {
    let s = String::from_str(source);
    let l = s.len_bytes();
    Lexer {
        src: s,
        pos: 0,
        len: l,
    }
}

impl Lexer {
    pub fn skip_whitespace(self: &mut Self) {
        let s: &str = self.src.as_str();
        while self.pos < self.len {
            let ch: i64 = s[self.pos];
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                self.pos = self.pos + 1;
            } else if ch == 47 && self.pos + 1 < self.len && s[self.pos + 1] == 47 {
                // Single line comment //
                self.pos = self.pos + 2;
                while self.pos < self.len && s[self.pos] != 10 {
                    self.pos = self.pos + 1;
                }
                if self.pos < self.len {
                    self.pos = self.pos + 1;
                }
            } else {
                break;
            }
        }
    }

    pub fn next_token(self: &mut Self) -> Token {
        self.skip_whitespace();
        if self.pos >= self.len {
            return make_token(TOK_EOF(), 0, "");
        }

        let s: &str = self.src.as_str();
        let ch: i64 = s[self.pos];

        // 1. Numbers
        if ch >= 48 && ch <= 57 {
            let mut val = 0;
            while self.pos < self.len {
                let digit_ch: i64 = s[self.pos];
                if digit_ch >= 48 && digit_ch <= 57 {
                    val = val * 10 + (digit_ch - 48);
                    self.pos = self.pos + 1;
                } else {
                    break;
                }
            }
            return make_token(TOK_INT(), val, "");
        }

        // 2. Identifiers & Keywords
        if (ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || ch == 95 {
            let start = self.pos;
            while self.pos < self.len {
                let id_ch: i64 = s[self.pos];
                if (id_ch >= 97 && id_ch <= 122) || (id_ch >= 65 && id_ch <= 90) || (id_ch >= 48 && id_ch <= 57) || id_ch == 95 {
                    self.pos = self.pos + 1;
                } else {
                    break;
                }
            }
            let sub_opt = self.src.slice_bytes(start, self.pos);
            let mut id_str = "";
            match sub_opt {
                Option::Some(sl) => {
                    id_str = sl;
                }
                Option::None => {}
            }

            if id_str.equals("fn") { return make_token(TOK_FN(), 0, "fn"); }
            if id_str.equals("let") { return make_token(TOK_LET(), 0, "let"); }
            if id_str.equals("mut") { return make_token(TOK_MUT(), 0, "mut"); }
            if id_str.equals("return") { return make_token(TOK_RETURN(), 0, "return"); }
            if id_str.equals("if") { return make_token(TOK_IF(), 0, "if"); }
            if id_str.equals("else") { return make_token(TOK_ELSE(), 0, "else"); }
            if id_str.equals("while") { return make_token(TOK_WHILE(), 0, "while"); }

            return make_token(TOK_IDENT(), 0, id_str);
        }

        // 3. Two-character operators
        if self.pos + 1 < self.len {
            let ch2: i64 = s[self.pos + 1];
            if ch == 45 && ch2 == 62 { // ->
                self.pos = self.pos + 2;
                return make_token(TOK_ARROW(), 0, "->");
            }
            if ch == 61 && ch2 == 61 { // ==
                self.pos = self.pos + 2;
                return make_token(TOK_EQ(), 0, "==");
            }
            if ch == 33 && ch2 == 61 { // !=
                self.pos = self.pos + 2;
                return make_token(TOK_NE(), 0, "!=");
            }
            if ch == 60 && ch2 == 61 { // <=
                self.pos = self.pos + 2;
                return make_token(TOK_LE(), 0, "<=");
            }
            if ch == 62 && ch2 == 61 { // >=
                self.pos = self.pos + 2;
                return make_token(TOK_GE(), 0, ">=");
            }
        }

        // 4. Single-character symbols
        self.pos = self.pos + 1;
        if ch == 40 { return make_token(TOK_LPAREN(), 0, "("); }
        if ch == 41 { return make_token(TOK_RPAREN(), 0, ")"); }
        if ch == 123 { return make_token(TOK_LBRACE(), 0, "{"); }
        if ch == 125 { return make_token(TOK_RBRACE(), 0, "}"); }
        if ch == 59 { return make_token(TOK_SEMI(), 0, ";"); }
        if ch == 44 { return make_token(TOK_COMMA(), 0, ","); }
        if ch == 58 { return make_token(TOK_COLON(), 0, ":"); }
        if ch == 61 { return make_token(TOK_ASSIGN(), 0, "="); }
        if ch == 43 { return make_token(TOK_PLUS(), 0, "+"); }
        if ch == 45 { return make_token(TOK_MINUS(), 0, "-"); }
        if ch == 42 { return make_token(TOK_STAR(), 0, "*"); }
        if ch == 47 { return make_token(TOK_SLASH(), 0, "/"); }
        if ch == 60 { return make_token(TOK_LT(), 0, "<"); }
        if ch == 62 { return make_token(TOK_GT(), 0, ">"); }

        return make_token(TOK_EOF(), 0, "");
    }
}
