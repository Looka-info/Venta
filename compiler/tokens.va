// ============================================================================
// Vanta-C Compiler: Token Definitions (pure Vanta)
// ============================================================================

import std::string::String;

pub fn TOK_EOF() -> i64 { 0 }
pub fn TOK_FN() -> i64 { 1 }
pub fn TOK_LET() -> i64 { 2 }
pub fn TOK_MUT() -> i64 { 3 }
pub fn TOK_RETURN() -> i64 { 4 }
pub fn TOK_IF() -> i64 { 5 }
pub fn TOK_ELSE() -> i64 { 6 }
pub fn TOK_WHILE() -> i64 { 7 }
pub fn TOK_IDENT() -> i64 { 8 }
pub fn TOK_INT() -> i64 { 9 }
pub fn TOK_LPAREN() -> i64 { 10 }
pub fn TOK_RPAREN() -> i64 { 11 }
pub fn TOK_LBRACE() -> i64 { 12 }
pub fn TOK_RBRACE() -> i64 { 13 }
pub fn TOK_SEMI() -> i64 { 14 }
pub fn TOK_COMMA() -> i64 { 15 }
pub fn TOK_COLON() -> i64 { 16 }
pub fn TOK_ARROW() -> i64 { 17 }
pub fn TOK_ASSIGN() -> i64 { 18 }
pub fn TOK_PLUS() -> i64 { 19 }
pub fn TOK_MINUS() -> i64 { 20 }
pub fn TOK_STAR() -> i64 { 21 }
pub fn TOK_SLASH() -> i64 { 22 }
pub fn TOK_EQ() -> i64 { 23 }
pub fn TOK_NE() -> i64 { 24 }
pub fn TOK_LT() -> i64 { 25 }
pub fn TOK_LE() -> i64 { 26 }
pub fn TOK_GT() -> i64 { 27 }
pub fn TOK_GE() -> i64 { 28 }

pub struct Token {
    pub kind: i64,
    pub int_val: i64,
    pub str_val: String,
}

pub fn make_token(kind: i64, int_val: i64, str_val: &str) -> Token {
    Token {
        kind: kind,
        int_val: int_val,
        str_val: String::from_str(str_val),
    }
}
