fn tail_sum(n: i64, acc: i64) -> i64 {
    if n == 0 {
        return acc;
    }
    return tail_sum(n - 1, (acc + n) % 1000000007);
}

fn main() -> i64 {
    let mut total: i64 = 0;
    let mut i: i64 = 0;
    while i < 10000 {
        total = (total + tail_sum(1000, 0)) % 1000000007;
        i = i + 1;
    }
    print_i64(total);
    print_str("\n");
    return 0;
}
