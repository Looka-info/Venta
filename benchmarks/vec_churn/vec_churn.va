fn churn(count: i64) -> i64 {
    let mut v: Vec<i64> = Vec::new();
    let mut i: i64 = 0;
    while i < count {
        v.push(i);
        i = i + 1;
    }
    let mut sum: i64 = 0;
    let mut j: i64 = 0;
    while j < v.len() {
        sum = sum + v[j];
        j = j + 1;
    }
    return sum;
}

fn main() -> i64 {
    let mut total: i64 = 0;
    let mut iter: i64 = 0;
    while iter < 200 {
        total = total + churn(10000);
        iter = iter + 1;
    }
    print_i64(total);
    print_str("\n");
    return 0;
}
