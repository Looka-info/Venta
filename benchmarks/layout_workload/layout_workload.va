fn classify(x: i64) -> i64 {
    if x % 2 == 0 {
        return x / 2;
    } else if x % 3 == 0 {
        return x / 3 + 1;
    } else if x % 5 == 0 {
        return x / 5 + 2;
    } else {
        return x + 7;
    }
}

fn main() -> i64 {
    let mut sum: i64 = 0;
    let mut i: i64 = 0;
    while i < 10000000 {
        sum = (sum + classify(i)) % 1000000007;
        i = i + 1;
    }
    print_i64(sum);
    print_str("\n");
    return 0;
}
