(* Vanta Formal Grammar (EBNF) *)

Program = { Item } ;

Item = ModDecl | ImportDecl | FunctionDecl | StructDecl | EnumDecl | TraitDecl | ImplBlock ;

ModDecl    = [ "pub" ] "mod" Identifier ";" ;
ImportDecl = [ "pub" ] "import" ModulePath "::" ( "{" ImportItemList "}" | Identifier ) ";" ;

ModulePath     = Identifier { "::" Identifier } ;
ImportItemList = Identifier { "," Identifier } [ "," ] ;

FunctionDecl = [ "pub" ] "fn" Identifier [ "<" GenericParamList ">" ] "(" [ ParameterList ] ")" [ "->" Type ] Block ;

GenericParamList = GenericParam { "," GenericParam } [ "," ] ;
GenericParam     = Lifetime | TypeParam ;
Lifetime         = "'" Identifier ;
TypeParam        = Identifier [ ":" TypePath ] ;
TypeArgList      = TypeArg { "," TypeArg } [ "," ] ;
TypeArg          = Lifetime | Type ;
TypePath         = Identifier { "::" Identifier } ;

ParameterList = Parameter { "," Parameter } [ "," ] ;
Parameter     = [ "mut" ] Identifier ":" Type ;

StructDecl    = [ "pub" ] "struct" Identifier [ "<" GenericParamList ">" ] "{" [ StructFields ] "}" ;
StructFields  = StructField { "," StructField } [ "," ] ;
StructField   = [ "pub" ] Identifier ":" Type ;

EnumDecl      = [ "pub" ] "enum" Identifier [ "<" GenericParamList ">" ] "{" [ VariantList ] "}" ;
VariantList   = Variant { "," Variant } [ "," ] ;
Variant       = Identifier [ "(" TypeList ")" ] ;
TypeList      = Type { "," Type } [ "," ] ;

TraitDecl     = [ "pub" ] "trait" Identifier [ "<" GenericParamList ">" ] "{" { TraitMethodDecl } "}" ;
TraitMethodDecl = "fn" Identifier [ "<" GenericParamList ">" ] "(" [ ParameterList ] ")" [ "->" Type ] ";" ;

ImplBlock     = "impl" [ "<" GenericParamList ">" ] [ TraitPath "for" ] TypeRef "{" { FunctionDecl } "}" ;
TraitPath     = Identifier [ "<" TypeArgList ">" ] ;
TypeRef       = Identifier [ "<" TypeArgList ">" ] ;

Type = PrimitiveType
     | ReferenceType
     | ArrayType
     | SliceType
     | GenericType
     | StructType
     | TupleType ;

PrimitiveType = "i8" | "i16" | "i32" | "i64"
              | "u8" | "u16" | "u32" | "u64"
              | "f32" | "f64"
              | "bool"
              | "str" ;

ReferenceType = "&" [ Lifetime ] [ "mut" ] Type ;
ArrayType     = "[" Type ";" IntegerLiteral "]" ;
SliceType     = [ Lifetime ] "[" Type "]" ;
GenericType   = Identifier "<" TypeArgList ">" ;
StructType    = Identifier ;
TupleType     = "(" [ Type { "," Type } ] ")" ;

Block = "{" { Statement } [ Expression ] "}" ;

Statement = LetStmt
          | AssignmentStmt
          | WhileStmt
          | LoopStmt
          | ForStmt
          | ReturnStmt
          | BreakStmt
          | ContinueStmt
          | ExpressionStmt ;

LetStmt        = "let" [ "mut" ] Identifier [ ":" Type ] [ "=" Expression ] ";" ;
AssignmentStmt = LValue ( "=" | "+=" | "-=" | "*=" | "/=" | "%=" ) Expression ";" ;
WhileStmt      = "while" Expression Block ;
LoopStmt       = "loop" Block ;
ForStmt        = "for" Identifier "in" Expression Block ;
ReturnStmt     = "return" [ Expression ] ";" ;
BreakStmt      = "break" ";" ;
ContinueStmt   = "continue" ";" ;
ExpressionStmt = Expression ";" ;

LValue = Identifier
       | LValue "." Identifier
       | LValue "[" Expression "]"
       | "*" LValue ;

Expression = LogicalOrExpr ;

LogicalOrExpr  = LogicalAndExpr { "||" LogicalAndExpr } ;
LogicalAndExpr = BitwiseOrExpr { "&&" BitwiseOrExpr } ;
BitwiseOrExpr  = BitwiseXorExpr { "|" BitwiseXorExpr } ;
BitwiseXorExpr = BitwiseAndExpr { "^" BitwiseAndExpr } ;
BitwiseAndExpr = EqualityExpr { "&" EqualityExpr } ;
EqualityExpr   = RelationalExpr { ( "==" | "!=" ) RelationalExpr } ;
RelationalExpr = ShiftExpr { ( "<" | "<=" | ">" | ">=" ) ShiftExpr } ;
ShiftExpr      = AdditiveExpr { ( "<<" | ">>" ) AdditiveExpr } ;
AdditiveExpr   = MultiplicativeExpr { ( "+" | "-" ) MultiplicativeExpr } ;
MultiplicativeExpr = UnaryExpr { ( "*" | "/" | "%" ) UnaryExpr } ;

UnaryExpr = ( "-" | "!" | "*" | "&" | "&" "mut" ) UnaryExpr
          | PostfixExpr ;

PostfixExpr = PrimaryExpr { CallSuffix | MethodCallSuffix | MemberSuffix | IndexSuffix | TrySuffix } ;
CallSuffix       = [ "<" TypeArgList ">" ] "(" [ ArgumentList ] ")"
                 | [ "<" TypeArgList ">" ] "::" Identifier "(" [ ArgumentList ] ")" ;
MethodCallSuffix = "." Identifier "(" [ ArgumentList ] ")" ;
MemberSuffix     = "." Identifier ;
IndexSuffix      = "[" Expression "]" ;
TrySuffix        = "?" ;

ArgumentList = Expression { "," Expression } [ "," ] ;

PrimaryExpr = IntegerLiteral
            | BooleanLiteral
            | StringLiteral
            | Identifier
            | IfExpr
            | MatchExpr
            | Block
            | ArrayLiteral
            | StructLiteral
            | "(" Expression ")" ;

IfExpr = "if" Expression Block [ "else" ( IfExpr | Block ) ] ;

MatchExpr = "match" Expression "{" [ MatchArmList ] "}" ;
MatchArmList = MatchArm { "," MatchArm } [ "," ] ;
MatchArm = Pattern "=>" Expression ;

Pattern = "_"
        | BooleanLiteral
        | IntegerLiteral
        | [ Identifier "::" ] Identifier [ "(" [ PatternList ] ")" ] ;
PatternList = Pattern { "," Pattern } [ "," ] ;

ArrayLiteral = "[" [ Expression { "," Expression } [ "," ] ] "]" ;
StructLiteral = Identifier [ "<" TypeArgList ">" ] "{" [ StructFieldInits ] "}" ;
StructFieldInits = StructFieldInit { "," StructFieldInit } [ "," ] ;
StructFieldInit = Identifier ":" Expression ;

Identifier = ( Letter | "_" ) { Letter | Digit | "_" } ;
IntegerLiteral = DecimalLiteral | HexLiteral | BinaryLiteral ;
BooleanLiteral = "true" | "false" ;
StringLiteral  = '"' { Character - ( '"' | "\" ) | EscapeSequence } '"' ;
EscapeSequence = "\" ( "n" | "r" | "t" | "\" | '"' | "0" ) ;
