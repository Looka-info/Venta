{
  "id": "admin-dashboard",
  "name": "Admin Dashboard",
  "category": "Admin dashboards",
  "description": "Ledgerly Admin financial dashboard with real-time revenue counters ($128,430), horizontal metric charts, recent orders table, and account preferences.",
  "version": "1.0.0",
  "framework_compatibility": ">=1.0.0-rc.2",
  "entry_point": "main.va",
  "preview_asset": "preview.svg",
  "download_source": "local://templates/admin-dashboard",
  "features": [
    "Top Navigation with User Avatar",
    "Live Revenue Counter Animation",
    "Horizontal Metric Vector Charts",
    "Recent Orders Status Table",
    "Toggle Preference Switches",
    "Financial Telemetry JSON API"
  ],
  "pages": [
    {
      "path": "/",
      "title": "Overview",
      "description": "Revenue counter, KPI pills, metric vector charts, and orders"
    },
    {
      "path": "/analytics",
      "title": "Analytics",
      "description": "Throughput metrics and latency percentile SLAs"
    },
    {
      "path": "/users",
      "title": "Customers",
      "description": "Subscriber accounts and billing status table"
    },
    {
      "path": "/settings",
      "title": "Preferences",
      "description": "Notification settings and security toggles"
    },
    {
      "path": "/api/metrics",
      "title": "Metrics API",
      "description": "Revenue and conversion telemetry endpoint"
    },
    {
      "path": "/api/users",
      "title": "Users API",
      "description": "Customer accounts list endpoint"
    }
  ],
  "dependencies": {
    "vanta": ">=1.0.0-rc.2",
    "ventanext": ">=1.0.0-rc.2"
  },
