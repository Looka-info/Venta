import std::string::String;

pub fn render_page() -> String {
    let mut html = String::from_str("<section class=\"sec pad\" style=\"padding-top:120px;\"><h2 class=\"big\">Platform Capabilities.</h2><div class=\"g c3\">\n");
    html.push_str("<div class=\"card\"><h4>Zero-Config Ingestion</h4><p style=\"color:var(--mut);\">Direct webhook bindings for Stripe, Paddle, Chargebee, and App Store Connect with automated idempotency.</p></div>\n");
    html.push_str("<div class=\"card\"><h4>Cohort Matrix Engine</h4><p style=\"color:var(--mut);\">Track NRR, gross churn, and expansion velocity broken down by acquisition source and industry segment.</p></div>\n");
    html.push_str("<div class=\"card\"><h4>Predictive Churn Warnings</h4><p style=\"color:var(--mut);\">Early indicator heuristics trigger alerts before renewals lapse, based on product feature engagement drop-offs.</p></div>\n");
    html.push_str("</div></section>");
    html
}
