import std::string::String;

pub fn render_layout(child_content: &str) -> String {
    let mut html = String::from_str("<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Lumen: revenue analytics for SaaS teams</title><style>\n");
    html.push_str(":root{--bg:#f6f5f0;--fg:#14151a;--mut:#6b6b64;--line:#dcdbd2;--acc:#2f4bff;--font:-apple-system,\"Segoe UI\",Helvetica,Arial,sans-serif}*{box-sizing:border-box}html{background:var(--bg)}body{margin:0;background:var(--bg);color:var(--fg);font:17px/1.5 var(--font);overflow-x:hidden;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}:focus-visible{outline:2px solid var(--acc);outline-offset:3px}\n");
    html.push_str(".pad{padding-left:clamp(20px,4vw,56px);padding-right:clamp(20px,4vw,56px)}\n");
    html.push_str("nav{position:fixed;top:0;left:0;right:0;z-index:20;display:flex;justify-content:space-between;align-items:center;gap:20px;padding-top:16px;padding-bottom:16px}nav b{font-size:20px;letter-spacing:-.04em}nav ul{display:flex;gap:26px;list-style:none;margin:0;padding:0;font-size:15px}\n");
    html.push_str(".btn{display:inline-block;background:var(--fg);color:var(--bg);padding:12px 22px;border-radius:99px;font:600 15px var(--font);border:0;cursor:pointer}\n");
    html.push_str(".big{font-family:var(--disp,var(--font));font-weight:800;line-height:.86;letter-spacing:-.06em}\n");
    html.push_str(".hero{min-height:100vh;min-height:100svh;display:flex;flex-direction:column;justify-content:flex-end;padding-top:110px;padding-bottom:36px}.hero h1{font-size:clamp(58px,14vw,260px);margin:0}.m{display:block;overflow:hidden;padding-bottom:.06em}.m>span{display:block}\n");
    html.push_str(".hero .r{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-top:34px}.hero p{margin:0;max-width:34ch;font-size:clamp(18px,2vw,24px);line-height:1.3}\n");
    html.push_str(".mq{overflow:hidden;white-space:nowrap;border-block:1px solid var(--line);padding:14px 0}.mq div{display:inline-block;font-size:clamp(44px,8vw,130px)}.mq span{margin-right:.45em}\n");
    html.push_str(".hs{overflow:hidden}.track{display:flex;width:max-content;max-width:100%;height:100vh;height:100svh;overflow-x:auto}.js .track{overflow:visible;max-width:none}\n");
    html.push_str(".p{flex:none;width:min(82vw,920px);height:100%;display:flex;flex-direction:column;justify-content:flex-end;padding:100px clamp(24px,4vw,56px) clamp(40px,8vh,90px);border-left:1px solid var(--line)}.p h3{font-size:clamp(50px,9vw,160px);margin:0 0 18px}.p p{margin:0;max-width:40ch;color:var(--mut);font-size:clamp(16px,1.6vw,21px)}.p svg{width:min(100%,520px);max-height:34vh;margin-bottom:auto}\n");
    html.push_str(".sec{padding-top:clamp(64px,12vh,130px);padding-bottom:clamp(64px,12vh,130px);border-top:1px solid var(--line)}.sec h2{font-size:clamp(44px,8.5vw,150px);margin:0 0 clamp(28px,5vh,60px)}\n");
    html.push_str("footer{border-top:1px solid var(--line);padding-top:60px;padding-bottom:28px;overflow:hidden}.fw{font-size:clamp(70px,24vw,440px);margin:0 0 36px;white-space:nowrap}.fl{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;color:var(--mut);font-size:14px}\n");
    html.push_str("details{border-top:1px solid var(--line);padding:18px 0}summary{cursor:pointer;font-size:22px;letter-spacing:-.02em;font-weight:600}details p{color:var(--mut);max-width:60ch}\n");
    html.push_str(".g{display:grid;gap:16px}.c3{grid-template-columns:repeat(3,1fr)}.c4{grid-template-columns:repeat(4,1fr)}.card{border:1px solid var(--line);border-radius:14px;padding:26px}\n");
    html.push_str("@media(max-width:820px){nav ul{display:none}.p{width:86vw}.c3,.c4{grid-template-columns:1fr 1fr}}@media(max-width:560px){.c3,.c4{grid-template-columns:1fr}}\n");
    html.push_str("\n");
    html.push_str("nav{background:rgba(246,245,240,.9)}.big{font-weight:700}.mq div{color:transparent;-webkit-text-stroke:1px #b9b8ae}.p svg{stroke:var(--acc);fill:none;stroke-width:3}.pr b{font-size:56px;letter-spacing:-.05em;display:block;margin:6px 0}.pr .h{background:var(--fg);color:var(--bg)}.pr .h .btn{background:var(--bg);color:var(--fg)}.pr li{list-style:none;padding:8px 0;border-top:1px solid #8884;font-size:15px}.pr ul{padding:0;margin:14px 0 20px}\n");
    html.push_str("</style></head><body><nav class=\"pad\"><b><a href=\"/\">Lumen</a></b><ul><li><a href=\"/features\">Product</a></li><li><a href=\"/#price\">Customers</a></li><li><a href=\"/pricing\">Pricing</a></li><li><a href=\"/changelog\">Changelog</a></li></ul><a class=\"btn\" href=\"/pricing\">Start free</a></nav>\n");
    html.push_str("<main id=\"main\">");
    html.push_str(child_content);
    html.push_str("</main>\n");
    html.push_str("<footer class=\"pad\"><div class=\"fw big\">Lumen</div><div class=\"fl\"><span>&copy; 2026 Lumen Analytics, Inc.</span><span>Privacy &middot; Terms &middot; Status</span></div></footer><script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js\"></script><script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js\"></script><script src=\"https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js\"></script><script>(function(){var rm=matchMedia(\"(prefers-reduced-motion:reduce)\").matches;if(!window.gsap||!window.ScrollTrigger||rm)return;document.documentElement.classList.add(\"js\");gsap.registerPlugin(ScrollTrigger);\n");
    html.push_str("try{var l=new Lenis({lerp:.09});l.on(\"scroll\",ScrollTrigger.update);gsap.ticker.add(function(t){l.raf(t*1000)});gsap.ticker.lagSmoothing(0)}catch(e){}\n");
    html.push_str("gsap.from(\".hero h1 .m>span\",{yPercent:110,duration:1.3,ease:\"expo.out\",stagger:.1,delay:.1});\n");
    html.push_str("var t=document.querySelector(\".track\");if(t){var d=function(){return Math.max(0,t.scrollWidth-innerWidth)};gsap.to(t,{x:function(){return -d()},ease:\"none\",scrollTrigger:{trigger:\".hs\",start:\"top top\",end:function(){return\"+=\"+d()},pin:true,scrub:.8,invalidateOnRefresh:true,anticipatePin:1}})}\n");
    html.push_str("gsap.to(\".mq div\",{xPercent:-40,ease:\"none\",scrollTrigger:{trigger:\".mq\",start:\"top bottom\",end:\"bottom top\",scrub:true}});\n");
    html.push_str("gsap.utils.toArray(\".cnt\").forEach(function(c){var to=+c.dataset.to,d=+(c.dataset.d||0),o={v:0};gsap.to(o,{v:to,duration:1.8,ease:\"power2.out\",delay:.3,scrollTrigger:{trigger:c,start:\"top 95%\",once:true},onUpdate:function(){c.textContent=(c.dataset.pre||\"\")+o.v.toLocaleString(undefined,{minimumFractionDigits:d,maximumFractionDigits:d})+(c.dataset.suf||\"\")}})});\n");
    html.push_str("gsap.from(\".fw\",{yPercent:35,opacity:0,ease:\"none\",scrollTrigger:{trigger:\"footer\",start:\"top 92%\",end:\"top 35%\",scrub:true}});\n");
    html.push_str("var r=function(){ScrollTrigger.refresh()};document.fonts&&document.fonts.ready.then(r);addEventListener(\"load\",r)})();\n");
    html.push_str("</script></body></html>");
    html
}
