import std::string::String;

pub fn render_page() -> String {
    let mut html = String::from_str("<header class=\"hero pad\"><h1 class=\"big\"><span class=\"m\"><span>Brands</span></span><span class=\"m\"><span><em>people</em></span></span><span class=\"m\"><span>remember.</span></span></h1><div class=\"r\"><p>An independent studio in Berlin and Lagos. Identities, websites, and launch campaigns for companies that would rather be known than loud.</p><a class=\"btn\" href=\"#contact\">Start a project</a></div></header>\n");
    html.push_str("<div class=\"mq big\" aria-hidden=\"true\"><div><span>Identity</span><span>Web</span><span>Motion</span><span>Packaging</span><span>Campaigns</span><span>Identity</span><span>Web</span><span>Motion</span></div></div>\n");
    html.push_str("<section class=\"hs\"><div class=\"track\">\n");
    html.push_str("<div class=\"p\"><svg viewBox=\"0 0 400 200\" preserveAspectRatio=\"xMidYMid slice\"><rect width=\"400\" height=\"200\" fill=\"#f3f0e8\"/><circle cx=\"200\" cy=\"100\" r=\"70\" fill=\"#ff5a1f\"/></svg><h3 class=\"big\">Marrow Coffee</h3><p>Identity and packaging for a roaster with 40 cafés.</p></div>\n");
    html.push_str("<div class=\"p\"><svg viewBox=\"0 0 400 200\" preserveAspectRatio=\"xMidYMid slice\"><rect width=\"400\" height=\"200\" fill=\"#1f3d2b\"/><path d=\"M0 200L200 30L400 200Z\" fill=\"#f3f0e8\"/></svg><h3 class=\"big\">Alpine Rail</h3><p>Website and wayfinding for a regional railway.</p></div>\n");
    html.push_str("<div class=\"p\"><svg viewBox=\"0 0 400 200\" preserveAspectRatio=\"xMidYMid slice\"><rect width=\"400\" height=\"200\" fill=\"#c9c3ff\"/><rect x=\"70\" y=\"30\" width=\"100\" height=\"150\" fill=\"#0e0e0e\"/><rect x=\"220\" y=\"70\" width=\"100\" height=\"110\" fill=\"#ff5a1f\"/></svg><h3 class=\"big\">Plume Bank</h3><p>Brand system and app design for a challenger bank.</p></div>\n");
    html.push_str("<div class=\"p\"><svg viewBox=\"0 0 400 200\" preserveAspectRatio=\"xMidYMid slice\"><rect width=\"400\" height=\"200\" fill=\"#ffd9c7\"/><g fill=\"#0e0e0e\"><circle cx=\"110\" cy=\"100\" r=\"40\"/><rect x=\"190\" y=\"60\" width=\"80\" height=\"80\"/><path d=\"M300 140L340 60L380 140Z\"/></g></svg><h3 class=\"big\">Kite Foods</h3><p>Launch campaign and motion kit for a snack brand.</p></div></div></section>\n");
    html.push_str("<section class=\"sec pad\"><div class=\"case\"><div><h2 class=\"big\">Marrow Coffee</h2><p style=\"max-width:34ch;font-size:19px;margin:16px 0 0\">New identity and an e-commerce site rebuilt around subscriptions.</p></div><div><b class=\"big\"><span class=\"cnt\" data-to=\"212\" data-pre=\"+\" data-suf=\"%\">+212%</span></b><p>online subscription revenue in six months.</p></div></div></section>\n");
    html.push_str("<section class=\"sec pad\" id=\"team\"><h2 class=\"big\">The team.</h2><div class=\"g c4 team\"><div><i>AK</i><b>Amara Kone</b><span>Creative director</span></div><div><i>LS</i><b>Lukas Stein</b><span>Head of design</span></div><div><i>NO</i><b>Ngozi Obi</b><span>Engineering lead</span></div><div><i>JM</i><b>Jonas Miller</b><span>Strategy</span></div></div></section>\n");
    html.push_str("<section class=\"sec pad\"><blockquote>They gave us a brand we were proud of in six weeks.<cite>Sana Idris, CEO of Plume Bank</cite></blockquote></section>");
    html
}
