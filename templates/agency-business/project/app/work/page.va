import std::string::String;

pub fn render_page() -> String {
    let mut html = String::from_str("<section class=\"sec pad\" style=\"padding-top:120px;\"><h2 class=\"big\">Selected Cases.</h2><div class=\"g\" style=\"grid-template-columns:1fr; gap:32px;\">\n");
    html.push_str("<div class=\"case\"><div><h2 class=\"big\">Alpine Rail</h2><p style=\"max-width:34ch;font-size:19px;margin:16px 0 0\">Unified bilingual digital ticketing and live Alpine transit wayfinding across 120 mountain stations.</p></div><div><b class=\"big\">+41%</b><p>digital ticket volume in first season.</p></div></div>\n");
    html.push_str("<div class=\"case\" style=\"background:#c9c3ff; color:#0e0e0e;\"><div><h2 class=\"big\">Plume Bank</h2><p style=\"max-width:34ch;font-size:19px;margin:16px 0 0\">Identity and iOS/Android interface design for Europe's fastest growing fintech for creative freelancers.</p></div><div><b class=\"big\">4.9★</b><p>App Store rating across 80,000 reviews.</p></div></div>\n");
    html.push_str("</div></section>");
    html
}
