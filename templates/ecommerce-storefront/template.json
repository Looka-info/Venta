{
  "id": "ecommerce-storefront",
  "name": "E-commerce Storefront",
  "category": "E-commerce storefronts",
  "description": "Fieldnote Goods everyday stoneware ceramics and washed linen store with interactive shopping bag counter, horizontal category track, and bestseller product cards.",
  "version": "1.0.0",
  "framework_compatibility": ">=1.0.0-rc.2",
  "entry_point": "main.va",
  "preview_asset": "preview.svg",
  "download_source": "local://templates/ecommerce-storefront",
  "features": [
    "Free Shipping Announcement Bar",
    "Horizontal Ceramic Collection Track",
    "Inline SVG Product Illustrations",
    "Interactive Bag (N) Counter",
    "Full Shop Catalog Grid",
    "Shopping Cart Simulator"
  ],
  "pages": [
    {
      "path": "/",
      "title": "Home",
      "description": "Artisanal stoneware hero, collection track, and bestseller cards"
    },
    {
      "path": "/shop",
      "title": "Catalog",
      "description": "Complete collection of ceramics, linen, and kitchenware"
    },
    {
      "path": "/cart",
      "title": "Bag",
      "description": "Active shopping bag summary with free shipping threshold"
    },
    {
      "path": "/api/products",
      "title": "Products API",
      "description": "Live product catalog endpoint"
    },
    {
      "path": "/api/cart",
      "title": "Cart API",
      "description": "Current session cart totals endpoint"
    }
  ],
