import std::string::String;

pub fn render_page() -> String {
    let mut html = String::from_str("<section class=\"sec pad\" style=\"padding-top:120px;\"><h2 class=\"big\">Selected Work.</h2><div class=\"g\" style=\"grid-template-columns:1fr; gap:32px;\">\n");
    html.push_str("<div class=\"card\"><h4>Quill — Embedded Columnar Store (Rust)</h4><p style=\"color:var(--mut);\">Zero-allocation SIMD vectorization engine designed for immutable append-only logs.</p><div class=\"m2\">3,120 GitHub stars &middot; 48 contributors &middot; MIT</div></div>\n");
    html.push_str("<div class=\"card\"><h4>Mosaic — Printable DOM Engine (TypeScript)</h4><p style=\"color:var(--mut);\">High-precision pagination and typographic flow solver for PDF and client-side print drivers.</p><div class=\"m2\">1,410 GitHub stars &middot; Apache 2.0</div></div>\n");
    html.push_str("<div class=\"card\"><h4>Ledgerline — Double-Entry Engine (Go)</h4><p style=\"color:var(--mut);\">Multi-currency ledger with cryptographically verifiable audit trails and hot-spare failover.</p><div class=\"m2\">860 GitHub stars &middot; BSD-3</div></div>\n");
    html.push_str("</div></section>");
    html
}
