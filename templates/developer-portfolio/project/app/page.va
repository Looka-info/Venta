import std::string::String;

pub fn render_page() -> String {
    let mut html = String::from_str("<header class=\"hero pad\"><h1 class=\"big\"><span class=\"m\"><span>Maya</span></span><span class=\"m\"><span>Okafor.</span></span></h1><div class=\"r\"><p>Software engineer in Lisbon building fast, quiet tools for teams that ship.</p><a class=\"btn\" href=\"#contact\">Say hello</a></div></header>\n");
    html.push_str("<div class=\"mq big\" aria-hidden=\"true\"><div><span>Rust</span><span>TypeScript</span><span>Go</span><span>PostgreSQL</span><span>WebAssembly</span><span>Rust</span><span>TypeScript</span><span>Go</span></div></div>\n");
    html.push_str("<section class=\"hs\"><div class=\"track\">\n");
    html.push_str("<div class=\"p\"><svg viewBox=\"0 0 400 160\"><path d=\"M20 130L100 50L180 100L260 30L380 90\"/><circle class=\"a\" cx=\"100\" cy=\"50\" r=\"9\"/><circle class=\"a\" cx=\"260\" cy=\"30\" r=\"9\"/></svg><h3 class=\"big\">Quill</h3><p>A tiny columnar database for logs, written in Rust.</p><div class=\"m2\">Rust &middot; 3.1k stars</div></div>\n");
    html.push_str("<div class=\"p\"><svg viewBox=\"0 0 400 160\"><rect x=\"40\" y=\"30\" width=\"140\" height=\"100\"/><rect class=\"a\" x=\"220\" y=\"30\" width=\"140\" height=\"100\"/></svg><h3 class=\"big\">Mosaic</h3><p>A layout engine for printable reports in the browser.</p><div class=\"m2\">TypeScript &middot; 1.4k stars</div></div>\n");
    html.push_str("<div class=\"p\"><svg viewBox=\"0 0 400 160\"><path d=\"M20 130H380M20 90H380M20 50H380\"/><path d=\"M130 20V140M260 20V140\" stroke=\"#c2410c\"/></svg><h3 class=\"big\">Ledgerline</h3><p>Plain-text accounting for small teams, with a friendly web UI.</p><div class=\"m2\">Go &middot; 860 stars</div></div>\n");
    html.push_str("<div class=\"p\"><svg viewBox=\"0 0 400 160\"><circle cx=\"110\" cy=\"80\" r=\"46\"/><circle class=\"a\" cx=\"200\" cy=\"80\" r=\"46\"/><circle cx=\"290\" cy=\"80\" r=\"46\"/></svg><h3 class=\"big\">Tidepool</h3><p>Feature flags with audit trails and instant rollbacks.</p><div class=\"m2\">Go &middot; 540 stars</div></div></div></section>\n");
    html.push_str("<section class=\"sec pad\" id=\"about\"><h2 class=\"big\">About.</h2><p style=\"font-size:clamp(22px,3vw,40px);line-height:1.25;letter-spacing:-.02em;max-width:30ch;margin:0\">Eight years in developer tools and data infrastructure. I care about small APIs, honest error messages, and software that is pleasant to maintain.</p></section>\n");
    html.push_str("<section class=\"sec pad\" id=\"exp\"><h2 class=\"big\">Experience.</h2><div class=\"job\"><span class=\"m2\">2023 to now</span><div><h4>Staff Engineer, Fathom</h4><p>Rewrote the query planner. P95 latency fell from 1.8 s to 240 ms.</p></div></div><div class=\"job\"><span class=\"m2\">2020 to 2023</span><div><h4>Senior Engineer, Basecamp&amp;Co</h4><p>Built the realtime sync layer for 2M daily users.</p></div></div><div class=\"job\"><span class=\"m2\">2017 to 2020</span><div><h4>Engineer, Orbit Labs</h4><p>Shipped the first CLI and the plugin system.</p></div></div></section>");
    html
}
