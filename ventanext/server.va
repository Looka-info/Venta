// ============================================================================
// ⚡ VentaNext Framework — Server Application Engine
// Connection Lifecycle, Route Manifest Dispatching, Middleware Pipeline, & SSR
// ============================================================================

import http::{
    Request, Response, parse_http_request, response_html, response_json,
    response_not_found, response_bad_request, response_method_not_allowed,
    response_not_modified, response_error, compute_etag, etag_matches, add_etag, add_cache_control,
    to_wire_format, to_wire_format_ex, clone_param_map
};
import router::{
    RouteManifest, RouteMatch, make_route_manifest, match_route, normalize_request_path,
    render_mode_static, render_mode_dynamic, render_mode_isr
};
import middleware::{apply_security_headers, apply_cors_headers, handle_options_preflight, log_request};
import ssr::{
    RenderContext, make_render_context, resolve_layout,
    layout_root, layout_root_and_dashboard, layout_root_and_docs,
    render_home_page, render_dashboard_page, render_docs_page, render_post_detail_page,
    render_about_page, render_blog_slug_page, render_docs_path_page, render_404_page
};

import std::net;
import std::string::String;
import std::option::Option;
import std::result::Result;

pub fn build_default_manifest() -> RouteManifest {
    let mut m = make_route_manifest();

    // 1. App Router Page Routes (with Layout Hierarchy)
    m.add_page_route("/", layout_root(), 100);
    m.add_page_route("/dashboard", layout_root_and_dashboard(), 101);
    m.add_page_route("/docs", layout_root_and_docs(), 102);
    m.add_page_route("/posts/[id]", layout_root(), 103);
    m.add_page_route("/about", layout_root(), 104);
    m.add_page_route("/blog/[slug]", layout_root(), 105);
    m.add_page_route("/docs/[...path]", layout_root_and_docs(), 106);

    // 2. Typed API Routes
    m.add_api_route("GET", "/api/status", 200);
    m.add_api_route("GET", "/api/posts", 201);
    m.add_api_route("GET", "/api/posts/[id]", 202);
    m.add_api_route("POST", "/api/echo", 203);
    m.add_api_route("GET", "/api/health", 204);

    m
}

pub fn print_server_banner(port: i64) {
    print_str("\n====================================================================\n");
    print_str("   ⚡ VentaNext Framework — Full-Stack Server-Side Engine           \n");
    print_str("   Inspired by Next.js • Written 100% in Pure Venta Language        \n");
    print_str("====================================================================\n");
    print_str("   Architecture: System V AMD64 Native Machine Code (No LLVM)       \n");
    print_str("   Environment:  Production (v1.0-RC2 Runtime)                      \n");
    print_str("   App Router:   Deterministic Route Manifest with Specificity       \n");
    print_str("   TCP Port:     ");
    print_i64(port);
    print_str("\n");
    print_str("   Listening:    http://127.0.0.1:");
    print_i64(port);
    print_str("/\n");
    print_str("====================================================================\n");
    print_str("   Configured Manifest Routes:\n");
    print_str("     - GET  /              -> Home Page (Root Layout)\n");
    print_str("     - GET  /dashboard     -> Telemetry (Root > Dashboard Layout)\n");
    print_str("     - GET  /docs          -> Documentation (Root > Docs Layout)\n");
    print_str("     - GET  /posts/[id]    -> Post Detail (Dynamic Param [id])\n");
    print_str("     - GET  /api/status    -> System Diagnostics (JSON API)\n");
    print_str("     - GET  /api/posts     -> Posts Collection (JSON API)\n");
    print_str("     - GET  /api/posts/[id]-> Dynamic Entity Lookup (JSON API)\n");
    print_str("     - POST /api/echo      -> Payload Reflection (JSON API)\n");
    print_str("====================================================================\n\n");
}

pub fn dispatch_request_with_manifest(manifest: &RouteManifest, req: &mut Request) -> Response {
    let method = req.method.as_str();

    // 0. Path Normalization & Traversal Rejection
    let norm_res = normalize_request_path(req.path.as_str());
    match norm_res {
        Result::Ok(norm_path) => {
            req.path = norm_path;
        }
        Result::Err(err_msg) => {
            return response_bad_request("<h1>400 Bad Request: Path traversal rejected</h1>");
        }
    }
    let path = req.path.as_str();

    // 1. Handle HTTP OPTIONS Preflight
    if method.equals("OPTIONS") {
        return handle_options_preflight();
    }

    // 2. Resolve Route via App Router Engine
    let mut match_method = "GET";
    if method.equals("POST") {
        match_method = "POST";
    }
    let match_opt = match_route(manifest, path, match_method);
    match match_opt {
        Option::Some(m_res) => {
            req.params = clone_param_map(&m_res.params);

            // Route Response Processing (API or Page Component)
            let mut resp = response_error("Unhandled route");
            if m_res.is_api {
                if m_res.page_id == 200 {
                    let json = "{\"framework\":\"VentaNext\",\"version\":\"1.0.0-rc.2\",\"architecture\":\"x86_64-unknown-linux-gnu\",\"status\":\"operational\",\"memory_safety\":\"guaranteed\",\"features\":[\"App Router Manifest\",\"Nested Layouts\",\"Dynamic Params ([slug])\",\"Catch-All ([...path])\",\"Typed API Routes\",\"Middleware Pipeline\"]}\n";
                    resp = response_json(json);
                } else if m_res.page_id == 201 {
                    let json = "{\"posts\":[{\"id\":\"1\",\"title\":\"Introducing VentaNext\",\"author\":\"Antigravity\"},{\"id\":\"2\",\"title\":\"Server-Side Rendering at 60 MB/s\",\"author\":\"Looka\"},{\"id\":\"3\",\"title\":\"Affine Borrowing in Web Backends\",\"author\":\"Venta Team\"}]}\n";
                    resp = response_json(json);
                } else if m_res.page_id == 202 {
                    let id_opt = req.params.get("id");
                    let mut id_str = String::from_str("1");
                    match id_opt {
                        Option::Some(s) => { id_str = s; }
                        Option::None => {}
                    }
                    let mut json = String::from_str("{\"id\":\"");
                    json.push_str(id_str.as_str());
                    json.push_str("\",\"title\":\"Dynamic Post #");
                    json.push_str(id_str.as_str());
                    json.push_str("\",\"body\":\"Fetched dynamically via VentaNext App Router dynamic parameter.\",\"framework\":\"VentaNext\"}\n");
                    resp = response_json(json.as_str());
                } else if m_res.page_id == 203 {
                    let mut json = String::from_str("{\"status\":\"received\",\"method\":\"POST\",\"echo_payload\":");
                    if req.body.is_empty() {
                        json.push_str("null");
                    } else {
                        json.push_str("\"");
                        json.push_str(req.body.as_str());
                        json.push_str("\"");
                    }
                    json.push_str("}\n");
                    resp = response_json(json.as_str());
                } else if m_res.page_id == 204 {
                    let json = "{\"status\":\"ok\",\"service\":\"ventanext-health\",\"version\":\"1.0.0-rc.2\"}\n";
                    resp = response_json(json);
                }
            } else {
                // Handle Page Routes (with Nested Layout Resolution)
                let mut title = "Venta";
                let mut active_nav = "none";
                if m_res.page_id == 100 {
                    title = "Home";
                    active_nav = "home";
                } else if m_res.page_id == 101 {
                    title = "Dashboard";
                    active_nav = "dashboard";
                } else if m_res.page_id == 102 {
                    title = "Docs";
                    active_nav = "docs";
                } else if m_res.page_id == 103 {
                    title = "Post Detail";
                    active_nav = "dashboard";
                } else if m_res.page_id == 104 {
                    title = "About";
                    active_nav = "home";
                } else if m_res.page_id == 105 {
                    title = "Blog Post";
                    active_nav = "home";
                } else if m_res.page_id == 106 {
                    title = "Documentation";
                    active_nav = "docs";
                }

                let ctx = make_render_context(
                    path,
                    title,
                    active_nav,
                    clone_param_map(&req.params),
                    http::make_query_map(),
                    http::make_header_map(),
                    http::make_cookie_map(),
                );

                let mut page_markup = String::new();
                if m_res.page_id == 100 {
                    page_markup = render_home_page(&ctx);
                } else if m_res.page_id == 101 {
                    page_markup = render_dashboard_page(&ctx);
                } else if m_res.page_id == 102 {
                    page_markup = render_docs_page(&ctx);
                } else if m_res.page_id == 103 {
                    page_markup = render_post_detail_page(&ctx);
                } else if m_res.page_id == 104 {
                    page_markup = render_about_page(&ctx);
                } else if m_res.page_id == 105 {
                    page_markup = render_blog_slug_page(&ctx);
                } else if m_res.page_id == 106 {
                    page_markup = render_docs_path_page(&ctx);
                }

                let final_html = resolve_layout(m_res.layout_id, &ctx, page_markup.as_str());
                resp = response_html(final_html.as_str());
            }

            // Cache-Control Policy based on RenderMode
            if m_res.render_mode == render_mode_static() {
                add_cache_control(&mut resp, "public, max-age=0, must-revalidate");
            } else if m_res.render_mode == render_mode_isr() {
                add_cache_control(&mut resp, "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400");
            } else {
                add_cache_control(&mut resp, "private, no-cache, no-store, must-revalidate");
            }

            // ETag & Conditional Request (If-None-Match -> 304 Not Modified)
            if resp.status == 200 {
                let etag = compute_etag(resp.body.as_str());
                add_etag(&mut resp, etag.as_str());

                let inm_opt = req.headers.get("if-none-match");
                match inm_opt {
                    Option::Some(inm) => {
                        if etag_matches(inm.as_str(), etag.as_str()) {
                            let mut not_mod = response_not_modified();
                            add_etag(&mut not_mod, etag.as_str());
                            let cc_opt = resp.headers.get("cache-control");
                            match cc_opt {
                                Option::Some(cc) => { add_cache_control(&mut not_mod, cc.as_str()); }
                                Option::None => {}
                            }
                            return not_mod;
                        }
                    }
                    Option::None => {}
                }
            }

            return resp;
        }
        Option::None => {}
    }

    // Check if route exists for other methods (405 Method Not Allowed)
    let any_match = match_route(manifest, path, "*");
    match any_match {
        Option::Some(any_res) => {
            return response_method_not_allowed("GET, HEAD, OPTIONS");
        }
        Option::None => {}
    }

    // 3. Fallback: 404 Boundary
    let not_found_html = render_404_page(path);
    response_not_found(not_found_html.as_str())
}

pub fn dispatch_request(req: &mut Request) -> Response {
    let manifest = build_default_manifest();
    dispatch_request_with_manifest(&manifest, req)
}

pub fn run_server(port: i64, serve_once: bool) -> i64 {
    print_server_banner(port);

    let manifest = build_default_manifest();
    let val_res = manifest.validate();
    match val_res {
        Result::Ok(route_count) => {
            print_str("[VentaNext] Route manifest validated successfully: ");
            print_i64(route_count);
            print_str(" routes registered.\n");
        }
        Result::Err(err) => {
            print_str("[VentaNext] Fatal error: Route manifest conflict: ");
            print_str(err.as_str());
            print_str("\n");
            return 1;
        }
    }

    let server_fd = net::listen(port);
    if server_fd < 0 {
        print_str("[VentaNext] Error: Failed to bind TCP listener on port ");
        print_i64(port);
        print_str(" (error code: ");
        print_i64(server_fd);
        print_str(")\n");
        return 1;
    }

    print_str("[VentaNext] Server active and accepting connections...\n\n");

    let mut running: bool = true;
    let mut req_counter: i64 = 0;

    while running {
        let client_fd = net::accept(server_fd);
        if client_fd < 0 {
            print_str("[VentaNext] Warning: Connection accept error\n");
        } else {
            req_counter = req_counter + 1;

            let mut raw_buf = String::new();
            let bytes_read = net::read(client_fd, &mut raw_buf);

            if bytes_read > 0 {
                let mut req = parse_http_request(raw_buf.as_str());
                let is_head = req.method.as_str().equals("HEAD");
                let mut resp = dispatch_request_with_manifest(&manifest, &mut req);

                // Execute Middleware Pipeline
                apply_security_headers(&mut resp);
                apply_cors_headers(&mut resp);

                let wire = to_wire_format_ex(&resp, is_head);
                net::write(client_fd, wire.as_str());

                // Log request through middleware logger
                log_request(req_counter, &req, &resp);
            }

            net::close(client_fd);

            if serve_once {
                print_str("[VentaNext] --once flag received. Terminating server loop.\n");
                running = false;
            }
        }
    }

    net::close(server_fd);
    print_str("[VentaNext] Server gracefully stopped.\n");
    0
}
