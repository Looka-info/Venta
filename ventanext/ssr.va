pub fn render_home_page(ctx: &RenderContext) -> String {
    let mut c = String::from_str("<div class=\"hero\">\n");
    c.push_str("    <div class=\"hero-badge\">⚡ Venta Systems Programming Language • Next-Gen Compiler</div>\n");
    c.push_str("    <h1>PURE <span class=\"gradient-gold\">VELOCITY.</span><br>ABSOLUTE SAFETY.<br>ZERO <span class=\"gradient-gold\">OVERHEAD.</span></h1>\n");
    c.push_str("    <p>A memory-safe systems programming language featuring a 14-pass SSA optimizer, native x86-64 machine code generation, and affine borrow semantics. Compiles in 0.24 seconds with zero LLVM bloat.</p>\n");
    c.push_str("    <div class=\"btn-group\">\n");
    c.push_str("        <a href=\"/dashboard\" class=\"btn btn-gold\">⚡ Live Telemetry Dashboard →</a>\n");
    c.push_str("        <a href=\"/docs\" class=\"btn btn-ghost\">Read Documentation</a>\n");
    c.push_str("        <a href=\"/api/status\" class=\"btn btn-ghost\">JSON API Endpoint</a>\n");
    c.push_str("    </div>\n</div>\n");

    c.push_str("<div class=\"grid-bento\">\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\"><img src=\"vanta-file-icon.svg\" width=\"28\" alt=\"SSA\"></div>\n");
    c.push_str("        <h3>14-Pass SSA Optimizer</h3>\n");
    c.push_str("        <p>Custom Static Single Assignment optimization passes (GVN, SCCP, SROA, DCE, Inlining, TCO) delivering hyper-optimized machine representation.</p>\n    </div>\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\">🛡</div>\n");
    c.push_str("        <h3>Affine Ownership Safety</h3>\n");
    c.push_str("        <p>Deterministic move semantics and non-overlapping borrow checking. Absolute memory safety without garbage collection pauses.</p>\n    </div>\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\">⚡</div>\n");
    c.push_str("        <h3>Native x86-64 ELF64</h3>\n");
    c.push_str("        <p>Linear scan register allocator and direct System V AMD64 ELF writer outputting 22.5 KB standalone native binaries in 0.24s.</p>\n    </div>\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\">🤖</div>\n");
    c.push_str("        <h3>AI-First JSON Diagnostics</h3>\n");
    c.push_str("        <p>Built-in --emit-json flag emitting machine-parseable spans, tokens, and type diagnostics designed for autonomous AI agents.</p>\n    </div>\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\">🌐</div>\n");
    c.push_str("        <h3>VentaNext Framework</h3>\n");
    c.push_str("        <p>Next.js-style App Router, deterministic route manifest, nested layouts, and high-performance native HTTP lifecycle written in pure Venta.</p>\n    </div>\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\">🎨</div>\n");
    c.push_str("        <h3>3D Gold File Icons</h3>\n");
    c.push_str("        <p>Official VS Code extension featuring custom 3D gold faceted lightning file icons for all .va and .vanta source files.</p>\n    </div>\n");
    c.push_str("</div>\n");

    let sample_code = "// VentaNext Route Manifest & App Router\nimport ventanext::router::{RouteManifest, make_route_manifest};\nimport ventanext::http::{Request, Response};\n\nlet mut m = make_route_manifest();\nm.add_page_route(\"/\", layout_root(), 100);\nm.add_page_route(\"/dashboard\", layout_root_and_dashboard(), 101);\nm.add_page_route(\"/posts/[slug]\", layout_root(), 102);\nm.add_api_route(\"GET\", \"/api/status\", 200);\nm.validate();";
    c.push_str(component_code_block("app/manifest.va", sample_code).as_str());

    c
}

pub fn render_dashboard_page(ctx: &RenderContext) -> String {
    let mut c = String::from_str("<h1 style=\"font-family: var(--font-display); font-size: 2.4rem; font-weight: 800; margin-bottom: 8px;\">Server Telemetry & Telemetry Dashboard</h1>\n");
    c.push_str("<p style=\"color: var(--text-muted); margin-bottom: 36px;\">Live runtime metrics rendered inside a nested dashboard layout in pure Venta.</p>\n");

    c.push_str("<div class=\"grid-bento\" style=\"margin-top: 0; margin-bottom: 36px;\">\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\">⚡</div>\n");
    c.push_str("        <h3>0.24s</h3>\n        <p>Cold Compilation Time (vantac)</p>\n    </div>\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\">📦</div>\n");
    c.push_str("        <h3>22.5 KB</h3>\n        <p>Native Server Executable Size</p>\n    </div>\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\">🛡</div>\n");
    c.push_str("        <h3>100% Guaranteed</h3>\n        <p>Memory Safety (Affine Borrowing)</p>\n    </div>\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\">🚀</div>\n");
    c.push_str("        <h3>63.8 MB/s</h3>\n        <p>Raw HTTP Throughput (Loopback)</p>\n    </div>\n");
    c.push_str("</div>\n");

    c.push_str("<h2 style=\"font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; margin-bottom: 16px;\">Deterministic App Router Routes</h2>\n");
    c.push_str("<table>\n    <thead>\n        <tr>\n            <th>Method</th>\n            <th>Route Pattern</th>\n            <th>Layout Chain</th>\n            <th>Status</th>\n        </tr>\n    </thead>\n    <tbody>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-gold\">GET</span></td><td><code>/</code></td><td>Root Layout</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-gold\">GET</span></td><td><code>/dashboard</code></td><td>Root &gt; Dashboard</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-gold\">GET</span></td><td><code>/docs</code></td><td>Root &gt; Docs</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-gold\">GET</span></td><td><code>/posts/[id]</code></td><td>Root Layout</td><td><span class=\"status-pill pill-green\">Dynamic Param</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-green\">GET</span></td><td><code>/api/status</code></td><td>None (JSON API)</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-green\">GET</span></td><td><code>/api/posts</code></td><td>None (JSON API)</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-green\">GET</span></td><td><code>/api/posts/[id]</code></td><td>None (JSON API)</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-green\">POST</span></td><td><code>/api/echo</code></td><td>None (JSON API)</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("    </tbody>\n</table>\n");

    c
}

pub fn render_docs_page(ctx: &RenderContext) -> String {
    let mut c = String::from_str("<h1 style=\"font-family: var(--font-display); font-size: 2.4rem; font-weight: 800; margin-bottom: 8px;\">⚡ Venta Documentation</h1>\n");
    c.push_str("<p style=\"color: var(--text-muted); margin-bottom: 36px;\">Complete guide to building high-performance systems and web applications with Venta.</p>\n");

    c.push_str("<h2 style=\"font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; margin-top: 24px; margin-bottom: 12px;\">1. App Router & Route Manifest</h2>\n");
    c.push_str("<p style=\"color: var(--text-muted);\">VentaNext registers routes deterministically into a route manifest at compile/start time:</p>\n");
    let code1 = "import ventanext::router::{RouteManifest, make_route_manifest};\nimport ventanext::http::{Request, Response};\n\nlet mut m = make_route_manifest();\nm.add_page_route(\"/about\", 1, 101);\nm.validate();";
    c.push_str(component_code_block("app/manifest.va", code1).as_str());

    c.push_str("<h2 style=\"font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; margin-top: 32px; margin-bottom: 12px;\">2. Dynamic Route Parameters ([id], [slug])</h2>\n");
    c.push_str("<p style=\"color: var(--text-muted);\">Dynamic routes automatically capture parameterized URL path segments into <code>req.params</code>:</p>\n");
    let code2 = "pub fn handle_post(req: &Request) -> Response {\n    let post_id = req.params.get(\"id\");\n    // Render post detail with id...\n}";
    c.push_str(component_code_block("routes/post.va", code2).as_str());

    c
}

pub fn render_about_page(ctx: &RenderContext) -> String {
    let mut c = String::from_str("<h1 style=\"font-family: var(--font-display); font-size: 2.2rem; font-weight: 800; margin-bottom: 12px;\">About VentaNext</h1>\n");
    c.push_str("<p style=\"color: var(--text-muted); margin-bottom: 24px;\">Next.js-class full-stack framework engineered specifically for the Venta language.</p>\n");
    c.push_str("<div class=\"card-bento\">\n    <h3>Native Architecture</h3>\n    <p>Zero dependencies on Node.js, V8, React, or Python runtimes. Direct native machine execution with sub-millisecond SSR latency.</p>\n</div>\n");
    c
}

pub fn render_blog_slug_page(ctx: &RenderContext) -> String {
    let slug_opt = ctx.params.get("slug");
    let mut slug = String::from_str("hello");
    match slug_opt {
        Option::Some(val) => { slug = val; }
        Option::None => {}
    }

    let mut c = String::from_str("<h1 style=\"font-family: var(--font-display); font-size: 2.2rem; font-weight: 800; margin-bottom: 12px;\">Blog Post: ");
    c.push_str(slug.as_str());
    c.push_str("</h1>\n<p style=\"color: var(--text-muted); margin-bottom: 24px;\">Dynamic parameter <code>slug = ");
    c.push_str(slug.as_str());
    c.push_str("</code> resolved server-side via VentaNext App Router.</p>\n");
    c
}

pub fn render_docs_path_page(ctx: &RenderContext) -> String {
    let path_opt = ctx.params.get("path");
    let mut p_val = String::from_str("getting-started");
    match path_opt {
        Option::Some(val) => { p_val = val; }
        Option::None => {}
    }

    let mut c = String::from_str("<h1 style=\"font-family: var(--font-display); font-size: 2.2rem; font-weight: 800; margin-bottom: 12px;\">Docs: ");
    c.push_str(p_val.as_str());
    c.push_str("</h1>\n<p style=\"color: var(--text-muted); margin-bottom: 24px;\">Catch-all parameter <code>path = ");
    c.push_str(p_val.as_str());
    c.push_str("</code> resolved server-side via VentaNext App Router.</p>\n");
    c
}

pub fn render_post_detail_page(ctx: &RenderContext) -> String {
    let id_opt = ctx.params.get("id");
    let mut post_id = String::from_str("1");
    match id_opt {
        Option::Some(id_val) => {
            post_id = id_val;
        }
        Option::None => {}
    }

    let mut c = String::from_str("<h1 style=\"font-family: var(--font-display); font-size: 2.2rem; font-weight: 800; margin-bottom: 12px;\">Post #");
    c.push_str(post_id.as_str());
    c.push_str("</h1>\n<p style=\"color: var(--text-muted); margin-bottom: 24px;\">Dynamic server-rendered route parameter resolved via VentaNext App Router.</p>\n");
    c.push_str("<div class=\"card-bento\">\n    <h3>Dynamic SSR Execution</h3>\n    <p>Captured parameter <code>id = ");
    c.push_str(post_id.as_str());
    c.push_str("</code></p>\n    <p style=\"margin-top: 16px;\"><a href=\"/dashboard\" class=\"btn btn-gold\" style=\"padding: 6px 16px; font-size: 0.8rem;\">← Back to Dashboard</a></p>\n</div>\n");
    c
}

pub fn render_404_page(path: &str) -> String {
    let mut c = String::from_str("<div style=\"text-align: center; padding: 60px 0;\">\n");
    c.push_str("    <h1 style=\"font-family: var(--font-display); font-size: 4.5rem; font-weight: 900; color: var(--gold-core); margin-bottom: 12px;\">404</h1>\n");
    c.push_str("    <h2 style=\"font-size: 1.6rem; font-weight: 700; margin-bottom: 12px;\">Page Not Found</h2>\n");
    c.push_str("    <p style=\"color: var(--text-muted); margin-bottom: 24px;\">The requested path <code>");
    c.push_str(path);
    c.push_str("</code> does not exist in the VentaNext App Router manifest.</p>\n");
    c.push_str("    <a href=\"/\" class=\"btn btn-gold\">Return Home →</a>\n</div>\n");
    render_root_layout("404 Not Found", "none", c.as_str())
}
