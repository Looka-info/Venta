    html.push_str("        footer { border-top: 1px solid var(--border-subtle); padding: 50px 24px 40px; text-align: center; color: var(--text-muted); font-size: 0.88rem; margin-top: auto; background: #040406; position: relative; z-index: 1; }\n");
