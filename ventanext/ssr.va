// ============================================================================
// ⚡ VentaNext Framework — Server-Side Rendering (SSR) & Component Engine
// Next.js-Style Layouts, Reusable HTML Components, and Server-Side Page Renderers
// ============================================================================

import std::string::String;

// ----------------------------------------------------------------------------
// 1. Root Layout (like Next.js app/layout.tsx)
// ----------------------------------------------------------------------------

pub fn render_layout(title: &str, active_nav: &str, content: &str) -> String {
    let mut html = String::from_str("<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n");
    html.push_str("    <meta charset=\"UTF-8\">\n");
    html.push_str("    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n");
    html.push_str("    <title>");
    html.push_str(title);
    html.push_str(" | ⚡ VentaNext</title>\n");
    html.push_str("    <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚡</text></svg>\">\n");
    html.push_str("    <style>\n");
    html.push_str("        :root {\n");
    html.push_str("            --bg-base: #0d1117;\n");
    html.push_str("            --bg-surface: #161b22;\n");
    html.push_str("            --bg-card: #21262d;\n");
    html.push_str("            --bg-code: #0b0e14;\n");
    html.push_str("            --border: #30363d;\n");
    html.push_str("            --text: #f0f6fc;\n");
    html.push_str("            --text-muted: #8b949e;\n");
    html.push_str("            --accent: #8b5cf6;\n");
    html.push_str("            --accent-glow: rgba(139, 92, 246, 0.25);\n");
    html.push_str("            --cyan: #06b6d4;\n");
    html.push_str("            --green: #238636;\n");
    html.push_str("            --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n");
    html.push_str("        }\n");
    html.push_str("        * { box-sizing: border-box; margin: 0; padding: 0; }\n");
    html.push_str("        body { background: var(--bg-base); color: var(--text); font-family: var(--font); line-height: 1.6; min-height: 100vh; display: flex; flex-direction: column; }\n");
    html.push_str("        header { border-bottom: 1px solid var(--border); background: rgba(13, 17, 23, 0.85); backdrop-filter: blur(12px); position: sticky; top: 0; z-index: 100; }\n");
    html.push_str("        .nav-inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; }\n");
    html.push_str("        .brand { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.25rem; color: var(--text); text-decoration: none; letter-spacing: -0.5px; }\n");
    html.push_str("        .brand span { color: var(--accent); }\n");
    html.push_str("        .nav-links { display: flex; align-items: center; gap: 20px; list-style: none; }\n");
    html.push_str("        .nav-links a { color: var(--text-muted); text-decoration: none; font-size: 0.95rem; font-weight: 500; transition: color 0.15s; }\n");
    html.push_str("        .nav-links a:hover, .nav-links a.active { color: var(--text); }\n");
    html.push_str("        .nav-links a.active { color: var(--accent); font-weight: 600; }\n");
    html.push_str("        .nav-pill { background: rgba(139, 92, 246, 0.15); color: #c4b5fd; padding: 4px 12px; border-radius: 9999px; border: 1px solid rgba(139, 92, 246, 0.3); font-size: 0.8rem; font-weight: 600; }\n");
    html.push_str("        main { flex: 1; max-width: 1200px; width: 100%; margin: 0 auto; padding: 40px 24px; }\n");
    html.push_str("        footer { border-top: 1px solid var(--border); padding: 32px 24px; text-align: center; color: var(--text-muted); font-size: 0.9rem; margin-top: auto; }\n");
    html.push_str("        .hero { text-align: center; padding: 60px 0 40px; }\n");
    html.push_str("        .badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(139, 92, 246, 0.15); border: 1px solid rgba(139, 92, 246, 0.3); color: #c4b5fd; padding: 6px 16px; border-radius: 9999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 24px; }\n");
    html.push_str("        .hero h1 { font-size: 3.2rem; font-weight: 900; letter-spacing: -1.5px; line-height: 1.15; margin-bottom: 20px; }\n");
    html.push_str("        .gradient-text { background: linear-gradient(135deg, #f0f6fc 30%, #8b5cf6 70%, #06b6d4 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }\n");
    html.push_str("        .hero p { font-size: 1.25rem; color: var(--text-muted); max-width: 720px; margin: 0 auto 32px; }\n");
    html.push_str("        .btn-group { display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; }\n");
    html.push_str("        .btn { padding: 12px 28px; border-radius: 8px; font-weight: 600; text-decoration: none; font-size: 1rem; transition: all 0.15s; display: inline-flex; align-items: center; gap: 8px; }\n");
    html.push_str("        .btn-primary { background: var(--accent); color: white; box-shadow: 0 0 20px var(--accent-glow); }\n");
    html.push_str("        .btn-primary:hover { background: #7c3aed; transform: translateY(-1px); }\n");
    html.push_str("        .btn-secondary { background: var(--bg-surface); color: var(--text); border: 1px solid var(--border); }\n");
    html.push_str("        .btn-secondary:hover { border-color: var(--text-muted); background: var(--bg-card); }\n");
    html.push_str("        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; margin-top: 40px; }\n");
    html.push_str("        .card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: 12px; padding: 28px; transition: border-color 0.15s, transform 0.15s; }\n");
    html.push_str("        .card:hover { border-color: #58a6ff; transform: translateY(-2px); }\n");
    html.push_str("        .card-icon { font-size: 1.75rem; margin-bottom: 16px; }\n");
    html.push_str("        .card h3 { font-size: 1.25rem; font-weight: 700; margin-bottom: 8px; color: var(--text); }\n");
    html.push_str("        .card p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; }\n");
    html.push_str("        .code-container { background: var(--bg-code); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; margin: 24px 0; font-family: 'SF Mono', Consolas, monospace; font-size: 0.9rem; }\n");
    html.push_str("        .code-header { background: var(--bg-surface); padding: 10px 16px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; color: var(--text-muted); font-size: 0.8rem; }\n");
    html.push_str("        .code-content { padding: 20px; overflow-x: auto; color: #e6edf3; line-height: 1.6; white-space: pre; }\n");
    html.push_str("        table { width: 100%; border-collapse: collapse; margin-top: 20px; background: var(--bg-surface); border-radius: 10px; overflow: hidden; border: 1px solid var(--border); }\n");
    html.push_str("        th, td { padding: 14px 20px; text-align: left; border-bottom: 1px solid var(--border); }\n");
    html.push_str("        th { background: var(--bg-card); color: var(--text); font-weight: 600; font-size: 0.9rem; }\n");
    html.push_str("        td { color: var(--text-muted); font-size: 0.9rem; }\n");
    html.push_str("        tr:last-child td { border-bottom: none; }\n");
    html.push_str("        .status-pill { display: inline-block; padding: 4px 10px; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; }\n");
    html.push_str("        .pill-green { background: rgba(35, 134, 54, 0.2); color: #3fb950; border: 1px solid rgba(35, 134, 54, 0.4); }\n");
    html.push_str("        .pill-purple { background: rgba(139, 92, 246, 0.2); color: #c4b5fd; border: 1px solid rgba(139, 92, 246, 0.4); }\n");
    html.push_str("        .pill-cyan { background: rgba(6, 182, 212, 0.2); color: #67e8f9; border: 1px solid rgba(6, 182, 212, 0.4); }\n");
    html.push_str("    </style>\n</head>\n<body>\n");

    // Header & Navbar
    html.push_str("<header>\n    <div class=\"nav-inner\">\n");
    html.push_str("        <a href=\"/\" class=\"brand\">⚡ Venta<span>Next</span></a>\n");
    html.push_str("        <ul class=\"nav-links\">\n");

    let is_home = active_nav.equals("home");
    let is_dash = active_nav.equals("dashboard");
    let is_docs = active_nav.equals("docs");
    let is_api = active_nav.equals("api");

    html.push_str("            <li><a href=\"/\"");
    if is_home { html.push_str(" class=\"active\""); }
    html.push_str(">Home</a></li>\n");

    html.push_str("            <li><a href=\"/dashboard\"");
    if is_dash { html.push_str(" class=\"active\""); }
    html.push_str(">Dashboard</a></li>\n");

    html.push_str("            <li><a href=\"/docs\"");
    if is_docs { html.push_str(" class=\"active\""); }
    html.push_str(">Docs</a></li>\n");

    html.push_str("            <li><a href=\"/api/status\"");
    if is_api { html.push_str(" class=\"active\""); }
    html.push_str(">API Routes</a></li>\n");

    html.push_str("            <li><span class=\"nav-pill\">Next.js for Venta</span></li>\n");
    html.push_str("        </ul>\n    </div>\n</header>\n");

    // Injected Content
    html.push_str("<main>\n");
    html.push_str(content);
    html.push_str("\n</main>\n");

    // Footer
    html.push_str("<footer>\n");
    html.push_str("    <p>⚡ <strong>VentaNext</strong> — The Full-Stack Server-Side Framework for the Venta Language.</p>\n");
    html.push_str("    <p style=\"margin-top: 8px; font-size: 0.85rem;\">Zero LLVM • System V AMD64 Native Backend • 100% Memory Safe</p>\n");
    html.push_str("</footer>\n</body>\n</html>\n");

    html
}

// ----------------------------------------------------------------------------
// 2. Component Helpers
// ----------------------------------------------------------------------------

pub fn component_code_block(title: &str, code: &str) -> String {
    let mut s = String::from_str("<div class=\"code-container\">\n");
    s.push_str("    <div class=\"code-header\">\n        <span>");
    s.push_str(title);
    s.push_str("</span>\n        <span>Venta (.va)</span>\n    </div>\n");
    s.push_str("    <div class=\"code-content\">");
    s.push_str(code);
    s.push_str("</div>\n</div>\n");
    s
}

// ----------------------------------------------------------------------------
// 3. Page Renderers
// ----------------------------------------------------------------------------

pub fn render_home_page() -> String {
    let mut c = String::from_str("<div class=\"hero\">\n");
    c.push_str("    <div class=\"badge\">⚡ Next.js Architecture • Powered by Venta Native Runtime</div>\n");
    c.push_str("    <h1>The Full-Stack Web Framework<br><span class=\"gradient-text\">Built for Venta in Venta</span></h1>\n");
    c.push_str("    <p>Declarative SSR routing, dynamic route parameters, typed API handlers, and composable server middleware — compiled directly to bare-metal x86-64 assembly.</p>\n");
    c.push_str("    <div class=\"btn-group\">\n");
    c.push_str("        <a href=\"/dashboard\" class=\"btn btn-primary\">Live Telemetry Dashboard →</a>\n");
    c.push_str("        <a href=\"/docs\" class=\"btn btn-secondary\">Read Documentation</a>\n");
    c.push_str("        <a href=\"/api/status\" class=\"btn btn-secondary\">JSON API Endpoint</a>\n");
    c.push_str("    </div>\n</div>\n");

    c.push_str("<div class=\"grid\">\n");
    c.push_str("    <div class=\"card\">\n        <div class=\"card-icon\">🗂</div>\n");
    c.push_str("        <h3>File & Pattern Routing</h3>\n");
    c.push_str("        <p>Support for exact paths, dynamic route parameters like <code>/posts/:id</code>, and Next.js-style nested layout composition.</p>\n    </div>\n");
    c.push_str("    <div class=\"card\">\n        <div class=\"card-icon\">⚡</div>\n");
    c.push_str("        <h3>Server-Side Rendering (SSR)</h3>\n");
    c.push_str("        <p>Pure Venta component functions render HTML on the server in microseconds with zero virtual DOM overhead.</p>\n    </div>\n");
    c.push_str("    <div class=\"card\">\n        <div class=\"card-icon\">🔌</div>\n");
    c.push_str("        <h3>Typed API Routes</h3>\n");
    c.push_str("        <p>Build JSON microservices and REST endpoints seamlessly with <code>Response::json</code> and typed status codes.</p>\n    </div>\n");
    c.push_str("    <div class=\"card\">\n        <div class=\"card-icon\">🛡</div>\n");
    c.push_str("        <h3>Middleware Pipeline</h3>\n");
    c.push_str("        <p>Composable middleware for request logging, CORS, security headers, and error boundaries.</p>\n    </div>\n");
    c.push_str("    <div class=\"card\">\n        <div class=\"card-icon\">🏎</div>\n");
    c.push_str("        <h3>Sub-Millisecond Response</h3>\n");
    c.push_str("        <p>Compiled to a standalone native Linux ELF executable without JVM, V8, or Python interpreter runtime cost.</p>\n    </div>\n");
    c.push_str("    <div class=\"card\">\n        <div class=\"card-icon\">📦</div>\n");
    c.push_str("        <h3>37 KB Standalone Binary</h3>\n");
    c.push_str("        <p>The entire web application and native HTTP engine bundles into an ultra-lean binary ready for Docker or micro-VMs.</p>\n    </div>\n");
    c.push_str("</div>\n");

    let sample_code = "// VentaNext Route Handler\nimport ventanext::http::{Request, Response};\n\npub fn handle_index(req: &Request) -> Response {\n    Response::html(\"<h1>Welcome to VentaNext!</h1>\")\n}\n\npub fn handle_api_status(req: &Request) -> Response {\n    Response::json(\"{\\\"status\\\": \\\"healthy\\\", \\\"runtime\\\": \\\"Venta\\\"}\")\n}";
    c.push_str(component_code_block("app/routes.va", sample_code).as_str());

    render_layout("Home", "home", c.as_str())
}

pub fn render_dashboard_page() -> String {
    let mut c = String::from_str("<h1 style=\"font-size: 2rem; font-weight: 800; margin-bottom: 8px;\">Server Telemetry & Performance Dashboard</h1>\n");
    c.push_str("<p style=\"color: var(--text-muted); margin-bottom: 32px;\">Live runtime metrics rendered via Server-Side Rendering (SSR) in pure Venta.</p>\n");

    c.push_str("<div class=\"grid\" style=\"margin-top: 0; margin-bottom: 32px;\">\n");
    c.push_str("    <div class=\"card\">\n        <div class=\"card-icon\">⚡</div>\n");
    c.push_str("        <h3>0.24s</h3>\n        <p>Cold Compilation Time (vantac)</p>\n    </div>\n");
    c.push_str("    <div class=\"card\">\n        <div class=\"card-icon\">📦</div>\n");
    c.push_str("        <h3>37.3 KB</h3>\n        <p>Native Server Executable Size</p>\n    </div>\n");
    c.push_str("    <div class=\"card\">\n        <div class=\"card-icon\">🛡</div>\n");
    c.push_str("        <h3>100% Guaranteed</h3>\n        <p>Memory Safety (Affine Borrowing)</p>\n    </div>\n");
    c.push_str("    <div class=\"card\">\n        <div class=\"card-icon\">🚀</div>\n");
    c.push_str("        <h3>63.8 MB/s</h3>\n        <p>Raw HTTP Throughput (Loopback)</p>\n    </div>\n");
    c.push_str("</div>\n");

    c.push_str("<h2 style=\"font-size: 1.4rem; font-weight: 700; margin-bottom: 16px;\">Configured VentaNext Routes</h2>\n");
    c.push_str("<table>\n    <thead>\n        <tr>\n            <th>Method</th>\n            <th>Route Pattern</th>\n            <th>Kind</th>\n            <th>Status</th>\n        </tr>\n    </thead>\n    <tbody>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-purple\">GET</span></td><td><code>/</code></td><td>Page (SSR)</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-purple\">GET</span></td><td><code>/dashboard</code></td><td>Page (SSR)</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-purple\">GET</span></td><td><code>/docs</code></td><td>Page (SSR)</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-cyan\">GET</span></td><td><code>/posts/:id</code></td><td>Dynamic Route (SSR)</td><td><span class=\"status-pill pill-green\">Active</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-green\">GET</span></td><td><code>/api/status</code></td><td>API Route (JSON)</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-green\">GET</span></td><td><code>/api/posts</code></td><td>API Route (JSON)</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-green\">GET</span></td><td><code>/api/posts/:id</code></td><td>Dynamic API (JSON)</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-green\">POST</span></td><td><code>/api/echo</code></td><td>API Route (JSON)</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("    </tbody>\n</table>\n");

    render_layout("Dashboard", "dashboard", c.as_str())
}

pub fn render_docs_page() -> String {
    let mut c = String::from_str("<h1 style=\"font-size: 2rem; font-weight: 800; margin-bottom: 8px;\">⚡ VentaNext Documentation</h1>\n");
    c.push_str("<p style=\"color: var(--text-muted); margin-bottom: 32px;\">Learn how to build full-stack web applications with Next.js architecture in Venta.</p>\n");

    c.push_str("<h2 style=\"font-size: 1.4rem; font-weight: 700; margin-top: 24px; margin-bottom: 12px;\">1. Defining Page Routes</h2>\n");
    c.push_str("<p style=\"color: var(--text-muted);\">Page routes handle incoming HTTP GET requests and return server-rendered HTML using <code>Response::html</code>:</p>\n");
    let code1 = "import ventanext::http::{Request, Response};\nimport ventanext::ssr::render_layout;\n\npub fn handle_about(req: &Request) -> Response {\n    let content = \"<h1>About Us</h1><p>Built with VentaNext.</p>\";\n    let page_html = render_layout(\"About\", \"about\", content);\n    Response::html(page_html.as_str())\n}";
    c.push_str(component_code_block("routes/about.va", code1).as_str());

    c.push_str("<h2 style=\"font-size: 1.4rem; font-weight: 700; margin-top: 32px; margin-bottom: 12px;\">2. Dynamic Route Parameters (:id, :slug)</h2>\n");
    c.push_str("<p style=\"color: var(--text-muted);\">Dynamic routes automatically capture parameterized URL path segments into <code>req.param_value</code>:</p>\n");
    let code2 = "pub fn handle_post(req: &Request) -> Response {\n    let post_id = req.param_value.as_str();\n    let mut content = String::from_str(\"<h1>Post #\");\n    content.push_str(post_id);\n    content.push_str(\"</h1>\");\n    Response::html(content.as_str())\n}";
    c.push_str(component_code_block("routes/posts/[id].va", code2).as_str());

    c.push_str("<h2 style=\"font-size: 1.4rem; font-weight: 700; margin-top: 32px; margin-bottom: 12px;\">3. JSON API Routes</h2>\n");
    c.push_str("<p style=\"color: var(--text-muted);\">API routes return structured JSON data with appropriate MIME headers and status codes:</p>\n");
    let code3 = "pub fn handle_api_status(req: &Request) -> Response {\n    Response::json(\"{\\\"status\\\": \\\"online\\\", \\\"version\\\": \\\"1.0.0\\\"}\")\n}";
    c.push_str(component_code_block("api/status.va", code3).as_str());

    render_layout("Documentation", "docs", c.as_str())
}

pub fn render_post_detail_page(post_id: &str) -> String {
    let mut c = String::from_str("<div style=\"margin-bottom: 24px;\"><a href=\"/\" style=\"color: var(--accent); text-decoration: none;\">← Back to Overview</a></div>\n");
    c.push_str("<div class=\"badge\">⚡ Dynamic Route Parameter: :id = ");
    c.push_str(post_id);
    c.push_str("</div>\n");
    c.push_str("<h1 style=\"font-size: 2.5rem; font-weight: 800; margin-bottom: 16px;\">Dynamic Post Detail: #");
    c.push_str(post_id);
    c.push_str("</h1>\n");
    c.push_str("<p style=\"color: var(--text-muted); font-size: 1.1rem; margin-bottom: 32px;\">This page was generated on demand by VentaNext's dynamic router, parsing <code>/posts/");
    c.push_str(post_id);
    c.push_str("</code> and extracting the route parameter directly on the server.</p>\n");

    c.push_str("<div class=\"card\" style=\"margin-bottom: 24px;\">\n");
    c.push_str("    <h3>Resource Metadata</h3>\n");
    c.push_str("    <p style=\"margin-top: 8px;\"><strong>Identifier:</strong> ");
    c.push_str(post_id);
    c.push_str("</p>\n    <p style=\"margin-top: 4px;\"><strong>Rendering Mode:</strong> Server-Side Rendered (SSR)</p>\n");
    c.push_str("    <p style=\"margin-top: 4px;\"><strong>Engine:</strong> VentaNext Native x86-64 Pipeline</p>\n</div>\n");

    let mut title = String::from_str("Post #");
    title.push_str(post_id);
    render_layout(title.as_str(), "posts", c.as_str())
}

pub fn render_404_page(path: &str) -> String {
    let mut c = String::from_str("<div style=\"text-align: center; padding: 60px 0;\">\n");
    c.push_str("    <div class=\"badge\" style=\"background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.3); color: #fca5a5;\">404 • Not Found</div>\n");
    c.push_str("    <h1 style=\"font-size: 4rem; font-weight: 900; letter-spacing: -2px; margin-bottom: 16px;\">This page could not be found.</h1>\n");
    c.push_str("    <p style=\"color: var(--text-muted); font-size: 1.2rem; max-width: 600px; margin: 0 auto 32px;\">No VentaNext page or API handler is registered for path: <code>");
    c.push_str(path);
    c.push_str("</code></p>\n");
    c.push_str("    <a href=\"/\" class=\"btn btn-primary\">Return to Home Page →</a>\n");
    c.push_str("</div>\n");

    render_layout("404 Not Found", "404", c.as_str())
}
