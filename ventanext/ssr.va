    html.push_str("        body { background: var(--bg-void); color: var(--text-body); font-family: var(--font-body); line-height: 1.6; min-height: 100vh; display: flex; flex-direction: column; overflow-x: hidden; }\n");
    html.push_str("        #bg-canvas { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 0; opacity: 0.6; }\n");
    html.push_str("        .ambient-glow { position: fixed; border-radius: 50%; filter: blur(140px); pointer-events: none; z-index: 0; opacity: 0.2; }\n");
    html.push_str("        .glow-1 { top: -150px; left: 50%; transform: translateX(-50%); width: 700px; height: 450px; background: radial-gradient(circle, var(--gold-core), var(--amber-warm), transparent 70%); }\n");
    html.push_str("        .nav-wrapper { position: sticky; top: 16px; z-index: 100; display: flex; justify-content: center; padding: 0 20px; }\n");
