    html.push_str("            --font-display: 'Syne', sans-serif;\n");
    html.push_str("            --font-body: 'Plus Jakarta Sans', sans-serif;\n");
    html.push_str("            --font-code: 'JetBrains Mono', monospace;\n");
    html.push_str("        }\n");
