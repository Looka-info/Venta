// ============================================================================
// ⚡ VentaNext Framework — Server-Side Rendering (SSR) & Component Engine
// Next.js-Style Layouts, Awwwards-Level Showcase UI, and Pure Venta HTML Renderers
// ============================================================================

import std::string::String;

// ----------------------------------------------------------------------------
// 1. Root Layout (like Next.js app/layout.tsx)
// ----------------------------------------------------------------------------

pub fn render_layout(title: &str, active_nav: &str, content: &str) -> String {
    let mut html = String::from_str("<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n");
    html.push_str("    <meta charset=\"UTF-8\">\n");
    html.push_str("    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n");
    html.push_str("    <title>");
    html.push_str(title);
    html.push_str(" | ⚡ Venta</title>\n");
    html.push_str("    <link rel=\"icon\" type=\"image/svg+xml\" href=\"vanta-file-icon.svg\">\n");
    html.push_str("    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n");
    html.push_str("    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n");
    html.push_str("    <link href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Syne:wght@700;800;900&display=swap\" rel=\"stylesheet\">\n");
    html.push_str("    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js\"></script>\n");
    html.push_str("    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js\"></script>\n");
    html.push_str("    <style>\n");
    html.push_str("        :root {\n");
    html.push_str("            --bg-void: #050507;\n");
    html.push_str("            --bg-base: #09090d;\n");
    html.push_str("            --bg-surface: #0f1017;\n");
    html.push_str("            --bg-card: #141520;\n");
    html.push_str("            --border-subtle: rgba(255, 255, 255, 0.08);\n");
    html.push_str("            --border-gold: rgba(255, 215, 0, 0.25);\n");
    html.push_str("            --gold-core: #ffd700;\n");
    html.push_str("            --gold-bright: #ffe642;\n");
    html.push_str("            --gold-glow: rgba(255, 215, 0, 0.35);\n");
    html.push_str("            --amber-warm: #ff9f1c;\n");
    html.push_str("            --text-hero: #ffffff;\n");
    html.push_str("            --text-body: #c9cddb;\n");
    html.push_str("            --text-muted: #7e8499;\n");
    html.push_str("            --font-display: 'Syne', sans-serif;\n");
    html.push_str("            --font-body: 'Plus Jakarta Sans', sans-serif;\n");
    html.push_str("            --font-code: 'JetBrains Mono', monospace;\n");
    html.push_str("        }\n");
    html.push_str("        * { box-sizing: border-box; margin: 0; padding: 0; }\n");
    html.push_str("        body { background: var(--bg-void); color: var(--text-body); font-family: var(--font-body); line-height: 1.6; min-height: 100vh; display: flex; flex-direction: column; overflow-x: hidden; }\n");
    html.push_str("        #bg-canvas { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 0; opacity: 0.6; }\n");
    html.push_str("        .ambient-glow { position: fixed; border-radius: 50%; filter: blur(140px); pointer-events: none; z-index: 0; opacity: 0.2; }\n");
    html.push_str("        .glow-1 { top: -150px; left: 50%; transform: translateX(-50%); width: 700px; height: 450px; background: radial-gradient(circle, var(--gold-core), var(--amber-warm), transparent 70%); }\n");
    html.push_str("        .nav-wrapper { position: sticky; top: 16px; z-index: 100; display: flex; justify-content: center; padding: 0 20px; }\n");
    html.push_str("        .nav-pill { display: flex; align-items: center; justify-content: space-between; gap: 24px; background: rgba(15, 16, 23, 0.85); backdrop-filter: blur(20px); border: 1px solid var(--border-gold); box-shadow: 0 20px 40px rgba(0,0,0,0.6); border-radius: 9999px; padding: 8px 18px 8px 24px; max-width: 1060px; width: 100%; }\n");
    html.push_str("        .nav-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--text-hero); font-family: var(--font-display); font-weight: 800; font-size: 1.25rem; letter-spacing: -0.5px; }\n");
    html.push_str("        .nav-brand img { width: 24px; height: 24px; filter: drop-shadow(0 0 6px var(--gold-core)); }\n");
    html.push_str("        .nav-brand span { background: linear-gradient(135deg, #fff 40%, var(--gold-core) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }\n");
    html.push_str("        .nav-links { display: flex; align-items: center; gap: 20px; list-style: none; }\n");
    html.push_str("        .nav-links a { color: var(--text-muted); text-decoration: none; font-size: 0.88rem; font-weight: 500; transition: color 0.2s; }\n");
    html.push_str("        .nav-links a:hover, .nav-links a.active { color: var(--text-hero); }\n");
    html.push_str("        .nav-links a.active { color: var(--gold-bright); font-weight: 600; }\n");
    html.push_str("        .nav-pill-badge { background: rgba(255, 215, 0, 0.1); border: 1px solid rgba(255, 215, 0, 0.3); color: var(--gold-bright); padding: 4px 10px; border-radius: 9999px; font-family: var(--font-code); font-size: 0.75rem; font-weight: 600; }\n");
    html.push_str("        main { flex: 1; max-width: 1240px; width: 100%; margin: 0 auto; padding: 50px 24px 80px; position: relative; z-index: 1; }\n");
    html.push_str("        footer { border-top: 1px solid var(--border-subtle); padding: 50px 24px 40px; text-align: center; color: var(--text-muted); font-size: 0.88rem; margin-top: auto; background: #040406; position: relative; z-index: 1; }\n");
    html.push_str("        .hero { text-align: center; padding: 60px 0 60px; }\n");
    html.push_str("        .hero-badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(20, 21, 32, 0.8); border: 1px solid var(--border-gold); color: var(--gold-bright); padding: 6px 16px; border-radius: 9999px; font-size: 0.82rem; font-weight: 600; margin-bottom: 24px; }\n");
    html.push_str("        .hero h1 { font-family: var(--font-display); font-size: clamp(2.8rem, 6vw, 5.5rem); font-weight: 900; letter-spacing: -0.04em; line-height: 1.05; margin-bottom: 20px; text-transform: uppercase; }\n");
    html.push_str("        .gradient-gold { background: linear-gradient(135deg, #ffffff 20%, var(--gold-bright) 60%, var(--amber-warm) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 0 25px rgba(255, 215, 0, 0.25)); }\n");
    html.push_str("        .hero p { font-size: 1.2rem; color: var(--text-muted); max-width: 740px; margin: 0 auto 36px; line-height: 1.6; }\n");
    html.push_str("        .btn-group { display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; margin-bottom: 50px; }\n");
    html.push_str("        .btn { padding: 12px 28px; border-radius: 9999px; font-weight: 700; text-decoration: none; font-size: 0.95rem; transition: all 0.25s; display: inline-flex; align-items: center; gap: 8px; border: none; }\n");
    html.push_str("        .btn-gold { background: linear-gradient(135deg, var(--gold-core), var(--amber-warm)); color: #000; box-shadow: 0 4px 20px var(--gold-glow); }\n");
    html.push_str("        .btn-gold:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(255, 215, 0, 0.5); filter: brightness(1.1); }\n");
    html.push_str("        .btn-ghost { background: rgba(20, 21, 32, 0.8); color: var(--text-hero); border: 1px solid var(--border-gold); backdrop-filter: blur(12px); }\n");
    html.push_str("        .btn-ghost:hover { border-color: var(--gold-core); background: rgba(255, 215, 0, 0.1); }\n");
    html.push_str("        .grid-bento { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; margin-top: 40px; }\n");
    html.push_str("        .card-bento { background: rgba(17, 18, 27, 0.75); border: 1px solid var(--border-subtle); border-radius: 20px; padding: 32px; backdrop-filter: blur(20px); transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s; }\n");
    html.push_str("        .card-bento:hover { transform: translateY(-4px); border-color: var(--border-gold); box-shadow: 0 20px 40px rgba(0,0,0,0.6), 0 0 25px rgba(255, 215, 0, 0.08); }\n");
    html.push_str("        .card-icon { font-size: 1.8rem; margin-bottom: 16px; color: var(--gold-bright); }\n");
    html.push_str("        .card-bento h3 { font-family: var(--font-display); font-size: 1.35rem; font-weight: 800; margin-bottom: 10px; color: var(--text-hero); letter-spacing: -0.02em; }\n");
    html.push_str("        .card-bento p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; }\n");
    html.push_str("        .code-container { background: #090a10; border: 1px solid var(--border-gold); border-radius: 16px; overflow: hidden; margin: 36px 0; font-family: var(--font-code); font-size: 0.88rem; box-shadow: 0 20px 50px rgba(0,0,0,0.7); }\n");
    html.push_str("        .code-header { background: #0f1017; padding: 12px 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); display: flex; align-items: center; justify-content: space-between; color: var(--text-muted); font-size: 0.82rem; }\n");
    html.push_str("        .code-content { padding: 24px; overflow-x: auto; color: #e6edf3; line-height: 1.7; white-space: pre; }\n");
    html.push_str("        table { width: 100%; border-collapse: collapse; margin-top: 24px; background: rgba(17, 18, 27, 0.75); border-radius: 16px; overflow: hidden; border: 1px solid var(--border-gold); }\n");
    html.push_str("        th, td { padding: 14px 20px; text-align: left; border-bottom: 1px solid rgba(255, 255, 255, 0.06); font-family: var(--font-code); font-size: 0.85rem; }\n");
    html.push_str("        th { background: #0f1017; color: var(--text-hero); font-weight: 700; }\n");
    html.push_str("        td { color: var(--text-muted); }\n");
    html.push_str("        tr:last-child td { border-bottom: none; }\n");
    html.push_str("        .status-pill { display: inline-block; padding: 4px 10px; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; }\n");
    html.push_str("        .pill-gold { background: rgba(255, 215, 0, 0.12); color: var(--gold-bright); border: 1px solid rgba(255, 215, 0, 0.3); }\n");
    html.push_str("        .pill-green { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }\n");
    html.push_str("    </style>\n</head>\n<body>\n");
    html.push_str("    <canvas id=\"bg-canvas\"></canvas>\n");
    html.push_str("    <div class=\"ambient-glow glow-1\"></div>\n");

    // Header & Floating Navbar
    html.push_str("<div class=\"nav-wrapper\">\n    <nav class=\"nav-pill\">\n");
    html.push_str("        <a href=\"/\" class=\"nav-brand\">\n");
    html.push_str("            <img src=\"vanta-file-icon.svg\" alt=\"Venta\">\n");
    html.push_str("            <span>VENTA</span>\n        </a>\n");
    html.push_str("        <ul class=\"nav-links\">\n");

    let is_home = active_nav.equals("home");
    let is_dash = active_nav.equals("dashboard");
    let is_docs = active_nav.equals("docs");
    let is_api = active_nav.equals("api");

    html.push_str("            <li><a href=\"/\"");
    if is_home { html.push_str(" class=\"active\""); }
    html.push_str(">Home</a></li>\n");

    html.push_str("            <li><a href=\"/dashboard\"");
    if is_dash { html.push_str(" class=\"active\""); }
    html.push_str(">Dashboard</a></li>\n");

    html.push_str("            <li><a href=\"/docs\"");
    if is_docs { html.push_str(" class=\"active\""); }
    html.push_str(">Docs</a></li>\n");

    html.push_str("            <li><a href=\"/api/status\"");
    if is_api { html.push_str(" class=\"active\""); }
    html.push_str(">API Routes</a></li>\n");

    html.push_str("        </ul>\n");
    html.push_str("        <div style=\"display: flex; align-items: center; gap: 12px;\">\n");
    html.push_str("            <span class=\"nav-pill-badge\">⚡ v1.0-RC2</span>\n");
    html.push_str("            <a href=\"/docs\" class=\"btn btn-gold\" style=\"padding: 6px 16px; font-size: 0.8rem;\">Get Started</a>\n");
    html.push_str("        </div>\n    </nav>\n</div>\n");

    // Main Content
    html.push_str("<main>\n");
    html.push_str(content);
    html.push_str("\n</main>\n");

    // Luxury Footer
    html.push_str("<footer>\n");
    html.push_str("    <p style=\"display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 8px;\">\n");
    html.push_str("        <img src=\"vanta-file-icon.svg\" width=\"16\" alt=\"Venta\">\n");
    html.push_str("        <strong>Venta Systems Programming Language</strong> • Dual Licensed under MIT OR Apache-2.0\n    </p>\n");
    html.push_str("    <p style=\"color: #6b7280; font-size: 0.82rem;\">Zero LLVM • System V AMD64 Native Backend • 100% Memory Safe</p>\n");
    html.push_str("</footer>\n");

    // Canvas script
    html.push_str("<script>\n");
    html.push_str("const c = document.getElementById('bg-canvas');\n");
    html.push_str("if (c) {\n");
    html.push_str("    const ctx = c.getContext('2d');\n");
    html.push_str("    let w = c.width = window.innerWidth;\n");
    html.push_str("    let h = c.height = window.innerHeight;\n");
    html.push_str("    window.addEventListener('resize', () => { w = c.width = window.innerWidth; h = c.height = window.innerHeight; });\n");
    html.push_str("    const pts = Array.from({length: 45}, () => ({x: Math.random()*w, y: Math.random()*h, s: Math.random()*2+0.5, vy: -Math.random()*0.5-0.2, a: Math.random()*0.5+0.2}));\n");
    html.push_str("    function draw() {\n");
    html.push_str("        ctx.clearRect(0, 0, w, h);\n");
    html.push_str("        pts.forEach(p => {\n");
    html.push_str("            p.y += p.vy; if (p.y < 0) { p.y = h; p.x = Math.random()*w; }\n");
    html.push_str("            ctx.beginPath(); ctx.arc(p.x, p.y, p.s, 0, Math.PI*2);\n");
    html.push_str("            ctx.fillStyle = 'rgba(255, 215, 0, ' + p.a + ')'; ctx.fill();\n");
    html.push_str("        });\n");
    html.push_str("        requestAnimationFrame(draw);\n");
    html.push_str("    }\n");
    html.push_str("    draw();\n");
    html.push_str("}\n");
    html.push_str("</script>\n</body>\n</html>\n");

    html
}

// ----------------------------------------------------------------------------
// 2. Component Helpers
// ----------------------------------------------------------------------------

pub fn component_code_block(title: &str, code: &str) -> String {
    let mut s = String::from_str("<div class=\"code-container\">\n");
    s.push_str("    <div class=\"code-header\">\n        <span style=\"display: flex; align-items: center; gap: 8px;\"><img src=\"vanta-file-icon.svg\" width=\"16\" alt=\".va\"> ");
    s.push_str(title);
    s.push_str("</span>\n        <span style=\"color: #ffd700; font-weight: 600;\">Venta (.va)</span>\n    </div>\n");
    s.push_str("    <div class=\"code-content\">");
    s.push_str(code);
    s.push_str("</div>\n</div>\n");
    s
}

// ----------------------------------------------------------------------------
// 3. Page Renderers
// ----------------------------------------------------------------------------

pub fn render_home_page() -> String {
    let mut c = String::from_str("<div class=\"hero\">\n");
    c.push_str("    <div class=\"hero-badge\">⚡ Venta Systems Programming Language • Next-Gen Compiler</div>\n");
    c.push_str("    <h1>PURE <span class=\"gradient-gold\">VELOCITY.</span><br>ABSOLUTE SAFETY.<br>ZERO <span class=\"gradient-gold\">OVERHEAD.</span></h1>\n");
    c.push_str("    <p>A memory-safe systems programming language featuring a 14-pass SSA optimizer, native x86-64 machine code generation, and affine borrow semantics. Compiles in 0.24 seconds with zero LLVM bloat.</p>\n");
    c.push_str("    <div class=\"btn-group\">\n");
    c.push_str("        <a href=\"/dashboard\" class=\"btn btn-gold\">⚡ Live Telemetry Dashboard →</a>\n");
    c.push_str("        <a href=\"/docs\" class=\"btn btn-ghost\">Read Documentation</a>\n");
    c.push_str("        <a href=\"/api/status\" class=\"btn btn-ghost\">JSON API Endpoint</a>\n");
    c.push_str("    </div>\n</div>\n");

    c.push_str("<div class=\"grid-bento\">\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\"><img src=\"vanta-file-icon.svg\" width=\"28\" alt=\"SSA\"></div>\n");
    c.push_str("        <h3>14-Pass SSA Optimizer</h3>\n");
    c.push_str("        <p>Custom Static Single Assignment optimization passes (GVN, SCCP, SROA, DCE, Inlining, TCO) delivering hyper-optimized machine representation.</p>\n    </div>\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\">🛡</div>\n");
    c.push_str("        <h3>Affine Ownership Safety</h3>\n");
    c.push_str("        <p>Deterministic move semantics and non-overlapping borrow checking. Absolute memory safety without garbage collection pauses.</p>\n    </div>\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\">⚡</div>\n");
    c.push_str("        <h3>Native x86-64 ELF64</h3>\n");
    c.push_str("        <p>Linear scan register allocator and direct System V AMD64 ELF writer outputting 22.5 KB standalone native binaries in 0.24s.</p>\n    </div>\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\">🤖</div>\n");
    c.push_str("        <h3>AI-First JSON Diagnostics</h3>\n");
    c.push_str("        <p>Built-in --emit-json flag emitting machine-parseable spans, tokens, and type diagnostics designed for autonomous AI agents.</p>\n    </div>\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\">🌐</div>\n");
    c.push_str("        <h3>VentaNext Framework</h3>\n");
    c.push_str("        <p>Next.js-style server-side rendering, dynamic route parameters, and high-performance native HTTP engine written in pure Venta.</p>\n    </div>\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\">🎨</div>\n");
    c.push_str("        <h3>3D Gold File Icons</h3>\n");
    c.push_str("        <p>Official VS Code extension featuring custom 3D gold faceted lightning file icons for all .va and .vanta source files.</p>\n    </div>\n");
    c.push_str("</div>\n");

    let sample_code = "// VentaNext Route Handler\nimport ventanext::http::{Request, Response};\n\npub fn handle_index(req: &Request) -> Response {\n    Response::html(\"<h1>Welcome to Venta!</h1>\")\n}\n\npub fn handle_api_status(req: &Request) -> Response {\n    Response::json(\"{\\\"status\\\": \\\"healthy\\\", \\\"runtime\\\": \\\"Venta\\\"}\")\n}";
    c.push_str(component_code_block("app/routes.va", sample_code).as_str());

    render_layout("Home", "home", c.as_str())
}

pub fn render_dashboard_page() -> String {
    let mut c = String::from_str("<h1 style=\"font-family: var(--font-display); font-size: 2.4rem; font-weight: 800; margin-bottom: 8px;\">Server Telemetry & Telemetry Dashboard</h1>\n");
    c.push_str("<p style=\"color: var(--text-muted); margin-bottom: 36px;\">Live runtime metrics rendered via Server-Side Rendering (SSR) in pure Venta.</p>\n");

    c.push_str("<div class=\"grid-bento\" style=\"margin-top: 0; margin-bottom: 36px;\">\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\">⚡</div>\n");
    c.push_str("        <h3>0.24s</h3>\n        <p>Cold Compilation Time (vantac)</p>\n    </div>\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\">📦</div>\n");
    c.push_str("        <h3>22.5 KB</h3>\n        <p>Native Server Executable Size</p>\n    </div>\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\">🛡</div>\n");
    c.push_str("        <h3>100% Guaranteed</h3>\n        <p>Memory Safety (Affine Borrowing)</p>\n    </div>\n");
    c.push_str("    <div class=\"card-bento\">\n        <div class=\"card-icon\">🚀</div>\n");
    c.push_str("        <h3>63.8 MB/s</h3>\n        <p>Raw HTTP Throughput (Loopback)</p>\n    </div>\n");
    c.push_str("</div>\n");

    c.push_str("<h2 style=\"font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; margin-bottom: 16px;\">Configured VentaNext Routes</h2>\n");
    c.push_str("<table>\n    <thead>\n        <tr>\n            <th>Method</th>\n            <th>Route Pattern</th>\n            <th>Kind</th>\n            <th>Status</th>\n        </tr>\n    </thead>\n    <tbody>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-gold\">GET</span></td><td><code>/</code></td><td>Page (SSR)</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-gold\">GET</span></td><td><code>/dashboard</code></td><td>Page (SSR)</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-gold\">GET</span></td><td><code>/docs</code></td><td>Page (SSR)</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-gold\">GET</span></td><td><code>/posts/:id</code></td><td>Dynamic Route (SSR)</td><td><span class=\"status-pill pill-green\">Active</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-green\">GET</span></td><td><code>/api/status</code></td><td>API Route (JSON)</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-green\">GET</span></td><td><code>/api/posts</code></td><td>API Route (JSON)</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-green\">GET</span></td><td><code>/api/posts/:id</code></td><td>Dynamic API (JSON)</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("        <tr><td><span class=\"status-pill pill-green\">POST</span></td><td><code>/api/echo</code></td><td>API Route (JSON)</td><td><span class=\"status-pill pill-green\">200 OK</span></td></tr>\n");
    c.push_str("    </tbody>\n</table>\n");

    render_layout("Dashboard", "dashboard", c.as_str())
}

pub fn render_docs_page() -> String {
    let mut c = String::from_str("<h1 style=\"font-family: var(--font-display); font-size: 2.4rem; font-weight: 800; margin-bottom: 8px;\">⚡ Venta Documentation</h1>\n");
    c.push_str("<p style=\"color: var(--text-muted); margin-bottom: 36px;\">Complete guide to building high-performance systems and web applications with Venta.</p>\n");

    c.push_str("<h2 style=\"font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; margin-top: 24px; margin-bottom: 12px;\">1. Defining Page Routes</h2>\n");
    c.push_str("<p style=\"color: var(--text-muted);\">Page routes handle incoming HTTP GET requests and return server-rendered HTML using <code>Response::html</code>:</p>\n");
    let code1 = "import ventanext::http::{Request, Response};\nimport ventanext::ssr::render_layout;\n\npub fn handle_about(req: &Request) -> Response {\n    let content = \"<h1>About Us</h1><p>Built with VentaNext.</p>\";\n    let page_html = render_layout(\"About\", \"about\", content);\n    Response::html(page_html.as_str())\n}";
    c.push_str(component_code_block("routes/about.va", code1).as_str());

    c.push_str("<h2 style=\"font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; margin-top: 32px; margin-bottom: 12px;\">2. Dynamic Route Parameters (:id, :slug)</h2>\n");
    c.push_str("<p style=\"color: var(--text-muted);\">Dynamic routes automatically capture parameterized URL path segments into <code>req.param_value</code>:</p>\n");
    let code2 = "pub fn handle_post(req: &Request) -> Response {\n    let post_id = req.param_value.as_str();\n    let mut content = String::from_str(\"<h1>Post #\");\n    content.push_str(post_id);\n    content.push_str(\"</h1>\");\n    Response::html(content.as_str())\n}";
    c.push_str(component_code_block("routes/post.va", code2).as_str());

    render_layout("Docs", "docs", c.as_str())
}

pub fn render_post_detail_page(post_id: &str) -> String {
    let mut c = String::from_str("<h1 style=\"font-family: var(--font-display); font-size: 2.2rem; font-weight: 800; margin-bottom: 12px;\">Post #");
    c.push_str(post_id);
    c.push_str("</h1>\n<p style=\"color: var(--text-muted); margin-bottom: 24px;\">Dynamic server-rendered route parameter resolved via VentaNext.</p>\n");
    c.push_str("<div class=\"card-bento\">\n    <h3>Dynamic SSR Execution</h3>\n    <p>Route parameter: <code>");
    c.push_str(post_id);
    c.push_str("</code></p>\n    <p style=\"margin-top: 16px;\"><a href=\"/dashboard\" class=\"btn btn-gold\" style=\"padding: 6px 16px; font-size: 0.8rem;\">← Back to Dashboard</a></p>\n</div>\n");
    render_layout("Post Detail", "dashboard", c.as_str())
}

pub fn render_404_page(path: &str) -> String {
    let mut c = String::from_str("<div style=\"text-align: center; padding: 60px 0;\">\n");
    c.push_str("    <h1 style=\"font-family: var(--font-display); font-size: 4.5rem; font-weight: 900; color: var(--gold-core); margin-bottom: 12px;\">404</h1>\n");
    c.push_str("    <h2 style=\"font-size: 1.6rem; font-weight: 700; margin-bottom: 12px;\">Page Not Found</h2>\n");
    c.push_str("    <p style=\"color: var(--text-muted); margin-bottom: 24px;\">The requested path <code>");
    c.push_str(path);
    c.push_str("</code> does not exist on this server.</p>\n");
    c.push_str("    <a href=\"/\" class=\"btn btn-gold\">Return Home →</a>\n</div>\n");
    render_layout("404 Not Found", "none", c.as_str())
}
