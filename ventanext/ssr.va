// ============================================================================
// ⚡ VentaNext Framework — Server-Side Rendering (SSR) & Component Engine
// Next.js-Class App Router Nested Layouts, Component Interface, and Render Context
// ============================================================================

import http::{ParamMap, QueryMap, HeaderMap, CookieMap, make_param_map, make_query_map, make_header_map, make_cookie_map};
import std::string::String;
import std::option::Option;

// ----------------------------------------------------------------------------
// 1. Render Context
// ----------------------------------------------------------------------------

pub struct RenderContext {
    pub path: String,
    pub title: String,
    pub active_nav: String,
    pub params: ParamMap,
    pub query: QueryMap,
    pub headers: HeaderMap,
    pub cookies: CookieMap,
}

pub fn make_render_context(
    path: &str,
    title: &str,
    active_nav: &str,
    params: ParamMap,
    query: QueryMap,
    headers: HeaderMap,
    cookies: CookieMap,
) -> RenderContext {
    RenderContext {
        path: String::from_str(path),
        title: String::from_str(title),
        active_nav: String::from_str(active_nav),
        params: params,
        query: query,
        headers: headers,
        cookies: cookies,
    }
}

// ----------------------------------------------------------------------------
// 2. Nested Layout Resolution Engine
// ----------------------------------------------------------------------------

pub fn layout_none() -> i64 { 0 }
pub fn layout_root() -> i64 { 1 }
pub fn layout_root_and_dashboard() -> i64 { 2 }
pub fn layout_root_and_docs() -> i64 { 3 }

pub fn render_root_layout(title: &str, active_nav: &str, content: &str) -> String {
    let mut html = String::from_str("<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n");
    html.push_str("    <meta charset=\"UTF-8\">\n");
    html.push_str("    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n");
    html.push_str("    <title>");
