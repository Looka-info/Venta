    html.push_str("<script>\n");
    html.push_str("const currentTemplateId = '");
    html.push_str(tid);
    html.push_str("';\n");
    html.push_str("let currentOpenFileName = 'app/page.va';\n");
    html.push_str("let projectFiles = {};\n");

    // Populate projectFiles dynamically based on template
    if tid.equals("developer-portfolio") {
        html.push_str("projectFiles = {\n");
        html.push_str("  'app/page.va': 'import std::string::String;\\n\\npub fn render_page() -> String {\\n    let mut html = String::from_str(\"<section class=\\\\\"portfolio-hero\\\\\">\\\\n\");\\n    html.push_str(\"  <h1>Maya Okafor — Systems & Kernel Engineer</h1>\\\\n\");\\n    html.push_str(\"  <p>Building high-throughput storage engines and verified compilers.</p>\\\\n\");\\n    html.push_str(\"</section>\\\\n\");\\n    html\\n}',\n");
        html.push_str("  'app/layout.va': 'import std::string::String;\\n\\npub fn render_layout(body: &str) -> String {\\n    format!(\"<!DOCTYPE html><html><head><title>Maya Okafor</title></head><body>{}</body></html>\", body)\\n}',\n");
        html.push_str("  'app/projects/page.va': 'pub fn render_projects() -> &str { \"<h1>Systems Projects</h1><p>Quill, Mosaic, Ledgerline, Tidepool</p>\" }',\n");
        html.push_str("  'app/blog/page.va': 'pub fn render_blog() -> &str { \"<h1>Engineering Notes</h1><p>Formal verification of affine borrow checkers</p>\" }',\n");
        html.push_str("  'app/about/page.va': 'pub fn render_about() -> &str { \"<h1>About Maya</h1><p>Distributed consensus, SIMD intrinsics, zero-copy I/O.</p>\" }',\n");
        html.push_str("  'app/components/terminal.va': 'pub fn render_terminal() -> &str { \"<div class=\\\\\"terminal\\\\\">$ vanta run kernel.va</div>\" }',\n");
        html.push_str("  'app/api/contact/route.va': 'pub fn handle_api() -> &str { \"{\\\\\"status\\\\\":\\\\\"ok\\\\\",\\\\\"email\\\\\":\\\\\"maya@okafor.dev\\\\\"}\" }',\n");
        html.push_str("  'main.va': 'pub fn main() { println!(\"Starting Developer Portfolio on http://127.0.0.1:3000\"); }',\n");
        html.push_str("  'ventanext.config.json': '{\\n  \"framework\": \"VentaNext\",\\n  \"version\": \"1.0.0-rc.2\",\\n  \"target\": \"x86_64-unknown-linux-gnu\"\\n}',\n");
