    // Set initial editor content
    html.push_str("document.getElementById('code-editor-area').value = projectFiles['app/page.va'] || '';\n");

    // Load file function
    html.push_str("function loadFile(fName, ev) {\n");
    html.push_str("  if (projectFiles[currentOpenFileName] !== undefined) {\n");
    html.push_str("    projectFiles[currentOpenFileName] = document.getElementById('code-editor-area').value;\n");
    html.push_str("  }\n");
    html.push_str("  currentOpenFileName = fName;\n");
    html.push_str("  document.getElementById('active-filename').innerText = fName;\n");
    html.push_str("  const badge = document.getElementById('active-file-badge');\n");
    html.push_str("  if (fName.endsWith('.va')) { badge.innerText = 'Native Venta (.va)'; badge.style.color = 'var(--gold-bright)'; }\n");
    html.push_str("  else if (fName.endsWith('.json')) { badge.innerText = 'JSON Config'; badge.style.color = '#38bdf8'; }\n");
    html.push_str("  else if (fName.endsWith('.md')) { badge.innerText = 'Markdown Document'; badge.style.color = '#a78bfa'; }\n");
    html.push_str("  else { badge.innerText = 'Source File'; badge.style.color = 'var(--text-muted)'; }\n");
    html.push_str("  document.getElementById('code-editor-area').value = projectFiles[fName] || '';\n");
    html.push_str("  document.querySelectorAll('.file-item').forEach(el => el.classList.remove('active'));\n");
    html.push_str("  if (ev && ev.target) ev.target.classList.add('active');\n");
    html.push_str("  document.getElementById('btn-delete-file').style.display = (fName === 'app/page.va') ? 'none' : 'inline-block';\n");
    html.push_str("}\n");

    // Save current file function
    html.push_str("function saveCurrentFile() {\n");
    html.push_str("  projectFiles[currentOpenFileName] = document.getElementById('code-editor-area').value;\n");
    html.push_str("  const badge = document.getElementById('save-badge');\n");
    html.push_str("  badge.innerText = '💾 Recompiling...';\n");
    html.push_str("  badge.style.color = '#ffd700';\n");
    html.push_str("  const term = document.getElementById('terminal-bar');\n");
    html.push_str("  term.innerHTML = '<span style=\"color:#ffd700;\">⚡ [ventanext dev] Rebuilt route(s) in 12ms</span> • Emitted native AMD64 code • Live reload triggered';\n");
    html.push_str("  setTimeout(() => {\n");
    html.push_str("    badge.innerText = '● Saved on Disk';\n");
    html.push_str("    badge.style.color = '#22c55e';\n");
    html.push_str("    reloadLivePreview();\n");
    html.push_str("  }, 150);\n");
    html.push_str("}\n");

    // Add new file prompt
    html.push_str("function addNewFilePrompt() {\n");
    html.push_str("  const path = prompt('Enter new file path (e.g. app/faq/page.va, components/card.va):');\n");
    html.push_str("  if (!path || !path.trim()) return;\n");
    html.push_str("  const cleanPath = path.trim();\n");
    html.push_str("  if (projectFiles[cleanPath] !== undefined) { alert('File already exists: ' + cleanPath); return; }\n");
    html.push_str("  const starterCode = cleanPath.endsWith('.va') ? 'import std::string::String;\\n\\npub fn render_page() -> String {\\n    String::from_str(\"<h1>New Page</h1>\")\\n}' : '';\n");
    html.push_str("  projectFiles[cleanPath] = starterCode;\n");
    html.push_str("  const ul = document.getElementById('file-tree-list');\n");
    html.push_str("  const li = document.createElement('li');\n");
    html.push_str("  li.className = 'file-node';\n");
    html.push_str("  li.innerHTML = '<a href=\"#\" onclick=\"loadFile(\\\\'' + cleanPath + '\\\\', event)\" class=\"file-item\">📄 ' + cleanPath + '</a>';\n");
    html.push_str("  ul.appendChild(li);\n");
    html.push_str("  loadFile(cleanPath);\n");
    html.push_str("  document.getElementById('terminal-bar').innerHTML = '<span style=\"color:#22c55e;\">✨ Created new file:</span> ' + cleanPath;\n");
    html.push_str("}\n");

    // Delete current file
    html.push_str("function deleteCurrentFile() {\n");
    html.push_str("  if (currentOpenFileName === 'app/page.va') { alert('Cannot delete the root page (app/page.va)'); return; }\n");
    html.push_str("  if (!confirm('Are you sure you want to delete ' + currentOpenFileName + '?')) return;\n");
    html.push_str("  const del = currentOpenFileName;\n");
    html.push_str("  delete projectFiles[del];\n");
    html.push_str("  document.querySelectorAll('.file-item').forEach(el => {\n");
    html.push_str("    if (el.innerText.includes(del)) el.parentElement.remove();\n");
    html.push_str("  });\n");
    html.push_str("  loadFile('app/page.va');\n");
    html.push_str("  document.getElementById('terminal-bar').innerHTML = '<span style=\"color:#ef4444;\">🗑️ Deleted file:</span> ' + del;\n");
    html.push_str("}\n");

    // Viewport resizing
    html.push_str("function setViewport(w, btn) {\n");
    html.push_str("  document.getElementById('editor-preview-container').style.width = w;\n");
    html.push_str("  document.querySelectorAll('.btn-vp').forEach(b => {\n");
    html.push_str("    b.style.background = 'transparent'; b.style.color = 'var(--text-muted)'; b.style.borderColor = 'transparent';\n");
    html.push_str("  });\n");
    html.push_str("  btn.style.background = 'rgba(255,215,0,0.15)';\n");
    html.push_str("  btn.style.borderColor = 'var(--border-gold)';\n");
    html.push_str("  btn.style.color = 'var(--gold-bright)';\n");
    html.push_str("}\n");

    // Navigate viewport route
    html.push_str("function navigateViewportRoute(route) {\n");
    html.push_str("  const iframe = document.getElementById('editor-preview-frame');\n");
    html.push_str("  if (route.startsWith('http')) { iframe.src = route; }\n");
    html.push_str("  else if (route === '/' || route === '') { iframe.src = '/templates/preview/' + currentTemplateId; }\n");
    html.push_str("  else { iframe.src = route; }\n");
    html.push_str("}\n");

    // Reload preview
    html.push_str("function reloadLivePreview() {\n");
    html.push_str("  const iframe = document.getElementById('editor-preview-frame');\n");
    html.push_str("  iframe.src = iframe.src;\n");
    html.push_str("}\n");

    // Live reload bridge connection
    html.push_str("function initLiveReloadBridge() {\n");
    html.push_str("  const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';\n");
    html.push_str("  const wsUrl = protocol + '//' + window.location.host + '/_ventanext/reload';\n");
    html.push_str("  try {\n");
    html.push_str("    const ws = new WebSocket(wsUrl);\n");
    html.push_str("    ws.onopen = () => {\n");
    html.push_str("      document.getElementById('live-bridge-badge').innerText = '⚡ Live Bridge: Connected (WS)';\n");
    html.push_str("      document.getElementById('viewport-live-status').innerText = '● Hot Refresh Active (WebSocket)';\n");
    html.push_str("    };\n");
    html.push_str("    ws.onmessage = (e) => {\n");
    html.push_str("      try {\n");
    html.push_str("        const data = JSON.parse(e.data);\n");
    html.push_str("        if (data.type === 'reload') {\n");
    html.push_str("          document.getElementById('terminal-bar').innerHTML = '<span style=\"color:#22c55e;\">⚡ [ventanext dev] File modified (' + (data.file || '') + ')</span> • Rebuilt in ' + (data.rebuild_ms || 14) + 'ms • Viewport refreshed';\n");
    html.push_str("          reloadLivePreview();\n");
    html.push_str("        } else if (data.type === 'error') {\n");
    html.push_str("          document.getElementById('terminal-bar').innerHTML = '<span style=\"color:#ef4444;\">❌ [ventanext compiler error]:</span> ' + (data.error || 'Syntax error');\n");
    html.push_str("        }\n");
    html.push_str("      } catch(err) {}\n");
    html.push_str("    };\n");
    html.push_str("    ws.onerror = () => { fallbackSSE(); };\n");
    html.push_str("  } catch(e) { fallbackSSE(); }\n");
    html.push_str("}\n");

    html.push_str("function fallbackSSE() {\n");
    html.push_str("  if (!window.EventSource) return;\n");
    html.push_str("  const es = new EventSource('/_ventanext/reload');\n");
    html.push_str("  es.onopen = () => {\n");
    html.push_str("    document.getElementById('live-bridge-badge').innerText = '⚡ Live Bridge: Connected (SSE)';\n");
    html.push_str("    document.getElementById('viewport-live-status').innerText = '● Hot Refresh Active (SSE)';\n");
    html.push_str("  };\n");
    html.push_str("  es.onmessage = (e) => {\n");
    html.push_str("    try {\n");
    html.push_str("      const data = JSON.parse(e.data);\n");
    html.push_str("      if (data.type === 'reload') {\n");
    html.push_str("        document.getElementById('terminal-bar').innerHTML = '<span style=\"color:#22c55e;\">⚡ [ventanext dev] File modified (' + (data.file || '') + ')</span> • Rebuilt in ' + (data.rebuild_ms || 14) + 'ms • Viewport refreshed';\n");
    html.push_str("        reloadLivePreview();\n");
    html.push_str("      }\n");
    html.push_str("    } catch(err) {}\n");
    html.push_str("  };\n");
    html.push_str("}\n");

    html.push_str("window.addEventListener('keydown', (e) => {\n");
    html.push_str("  if ((e.ctrlKey || e.metaKey) && e.key === 's') {\n");
    html.push_str("    e.preventDefault();\n");
    html.push_str("    saveCurrentFile();\n");
    html.push_str("  }\n");
    html.push_str("});\n");

    html.push_str("initLiveReloadBridge();\n");
    html.push_str("</script>\n");

    html
}
