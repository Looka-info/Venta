// ----------------------------------------------------------------------------
// 1. Template Catalog Constants
// ----------------------------------------------------------------------------

pub fn get_templates_registry_json() -> String {
    let mut s = String::from_str("{\n");
    s.push_str("  \"version\": \"1.0.0\",\n");
    s.push_str("  \"categories\": [\n");
    s.push_str("    \"Business websites\", \"SaaS landing pages\", \"Developer portfolios\",\n");
    s.push_str("    \"E-commerce storefronts\", \"Admin dashboards\", \"Blogs and publishing\",\n");
    s.push_str("    \"Documentation websites\", \"Agency websites\", \"Startup landing pages\", \"Personal websites\"\n");
    s.push_str("  ],\n");
    s.push_str("  \"templates\": [\n");
    s.push_str("    {\"id\":\"modern-saas\",\"name\":\"Modern SaaS Website\",\"category\":\"SaaS landing pages\",\"version\":\"1.0.0\",\"framework_compatibility\":\">=1.0.0-rc.2\",\"routes\":6,\"files\":12,\"description\":\"Lumen SaaS revenue analytics platform with live MRR metrics track, three-tier pricing cards, interactive FAQ accordion, and clean modern aesthetic.\"},\n");
    s.push_str("    {\"id\":\"developer-portfolio\",\"name\":\"Developer Portfolio\",\"category\":\"Developer portfolios\",\"version\":\"1.0.0\",\"framework_compatibility\":\">=1.0.0-rc.2\",\"routes\":5,\"files\":11,\"description\":\"Maya Okafor systems software engineer portfolio with horizontal project track (Quill, Mosaic, Ledgerline, Tidepool), about section, and career experience timeline.\"},\n");
    s.push_str("    {\"id\":\"agency-business\",\"name\":\"Business & Agency Website\",\"category\":\"Agency websites\",\"version\":\"1.0.0\",\"framework_compatibility\":\">=1.0.0-rc.2\",\"routes\":5,\"files\":10,\"description\":\"Halftone Studio independent brand and digital agency in Berlin and Lagos with horizontal showcase track, revenue case study (+212%), and creative team grid.\"},\n");
    s.push_str("    {\"id\":\"ecommerce-storefront\",\"name\":\"E-commerce Storefront\",\"category\":\"E-commerce storefronts\",\"version\":\"1.0.0\",\"framework_compatibility\":\">=1.0.0-rc.2\",\"routes\":5,\"files\":10,\"description\":\"Fieldnote Goods everyday stoneware ceramics and washed linen store with interactive shopping bag counter, horizontal category track, and bestseller product cards.\"},\n");
    s.push_str("    {\"id\":\"admin-dashboard\",\"name\":\"Admin Dashboard\",\"category\":\"Admin dashboards\",\"version\":\"1.0.0\",\"framework_compatibility\":\">=1.0.0-rc.2\",\"routes\":6,\"files\":11,\"description\":\"Ledgerly Admin financial dashboard with real-time revenue counters ($128,430), horizontal metric charts, recent orders table, and account preferences.\"},\n");
    s.push_str("    {\"id\":\"docs-website\",\"name\":\"Documentation Website\",\"category\":\"Documentation websites\",\"version\":\"1.0.0\",\"framework_compatibility\":\">=1.0.0-rc.2\",\"routes\":5,\"files\":10,\"description\":\"Kiln technical documentation platform with instant client-side search filtering, syntax-highlighted code blocks, horizontal step track, and options reference.\"}\n");
    s.push_str("  ]\n}");
    s
}

// ----------------------------------------------------------------------------
// 2. Render Template Gallery HTML
// ----------------------------------------------------------------------------

pub fn render_template_gallery_html(ctx: &RenderContext) -> String {
    let mut html = String::from_str("<section style=\"padding: 10px 0 40px;\">\n");
    html.push_str("  <div style=\"text-align: center; max-width: 860px; margin: 0 auto 40px;\">\n");
    html.push_str("    <div class=\"hero-badge\">⚡ VentaNext Template Gallery</div>\n");
    html.push_str("    <h1 class=\"hero-title\">Start with a <span class=\"gradient-gold\">Complete Application</span></h1>\n");
    html.push_str("    <p class=\"hero-desc\">Choose from professionally designed, fully functional website templates. Download the entire project into your local workspace, preview it live, and freely edit every part of the website.</p>\n");
    html.push_str("    <div style=\"display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; font-size: 0.8rem; font-family: var(--font-code); color: var(--gold-bright);\">\n");
    html.push_str("      <span style=\"background: rgba(255,215,0,0.1); border: 1px solid var(--border-gold); padding: 4px 12px; border-radius: 9999px;\">✓ 100% Pure Venta</span>\n");
    html.push_str("      <span style=\"background: rgba(255,215,0,0.1); border: 1px solid var(--border-gold); padding: 4px 12px; border-radius: 9999px;\">✓ App Router Manifest</span>\n");
    html.push_str("      <span style=\"background: rgba(255,215,0,0.1); border: 1px solid var(--border-gold); padding: 4px 12px; border-radius: 9999px;\">✓ SHA-256 Verified Checksums</span>\n");
    html.push_str("      <span style=\"background: rgba(255,215,0,0.1); border: 1px solid var(--border-gold); padding: 4px 12px; border-radius: 9999px;\">✓ Sub-Second Native Build</span>\n");
    html.push_str("    </div>\n");
    html.push_str("  </div>\n");

    // Filter & Search Toolbar
    html.push_str("  <div style=\"background: rgba(15,16,23,0.85); border: 1px solid var(--border-gold); border-radius: 16px; padding: 20px 24px; margin-bottom: 36px; backdrop-filter: blur(16px);\">\n");
    html.push_str("    <div style=\"display: flex; gap: 16px; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-bottom: 16px;\">\n");
    html.push_str("      <div style=\"display: flex; align-items: center; gap: 10px; flex: 1; min-width: 280px;\">\n");
    html.push_str("        <span style=\"color: var(--gold-core); font-size: 1.1rem;\">🔍</span>\n");
    html.push_str("        <input type=\"text\" id=\"gallery-search\" placeholder=\"Search templates by name, feature, or keyword...\" style=\"width: 100%; background: #090a10; border: 1px solid var(--border-subtle); color: #fff; padding: 10px 16px; border-radius: 8px; font-size: 0.92rem; outline: none;\">\n");
    html.push_str("      </div>\n");
    html.push_str("      <div style=\"display: flex; gap: 12px; align-items: center;\">\n");
    html.push_str("        <span style=\"color: var(--text-muted); font-size: 0.85rem;\">Sort By:</span>\n");
    html.push_str("        <select id=\"gallery-sort\" style=\"background: #090a10; border: 1px solid var(--border-subtle); color: #fff; padding: 8px 14px; border-radius: 8px; font-size: 0.88rem;\">\n");
    html.push_str("          <option value=\"recommended\">Recommended</option>\n");
    html.push_str("          <option value=\"name\">Name (A-Z)</option>\n");
    html.push_str("          <option value=\"routes\">Most Routes</option>\n");
    html.push_str("          <option value=\"category\">Category</option>\n");
    html.push_str("        </select>\n");
    html.push_str("      </div>\n");
    html.push_str("    </div>\n");

    // Category Filter Pills
    html.push_str("    <div style=\"display: flex; gap: 8px; flex-wrap: wrap;\">\n");
    html.push_str("      <button class=\"filter-pill active\" onclick=\"filterCategory('all', this)\">All Templates (6)</button>\n");
    html.push_str("      <button class=\"filter-pill\" onclick=\"filterCategory('SaaS landing pages', this)\">SaaS Landing Pages (1)</button>\n");
    html.push_str("      <button class=\"filter-pill\" onclick=\"filterCategory('Developer portfolios', this)\">Developer Portfolios (1)</button>\n");
    html.push_str("      <button class=\"filter-pill\" onclick=\"filterCategory('Agency websites', this)\">Agency Websites (1)</button>\n");
    html.push_str("      <button class=\"filter-pill\" onclick=\"filterCategory('E-commerce storefronts', this)\">E-commerce Storefronts (1)</button>\n");
