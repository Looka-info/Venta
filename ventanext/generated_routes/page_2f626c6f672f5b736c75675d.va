import std::string::String;
import component::escape_html;

pub fn render_page(slug: &str) -> String {
    let mut html = String::from_str("<h1>Blog Post: ");
    let clean_slug = escape_html(slug);
    html.push_str(clean_slug.as_str());
    html.push_str("</h1><p>Dynamic route parameter successfully extracted and rendered server-side.</p>");
    html
}

// ----------------------------------------------------------------------------
// Static Invocation Bridge
// ----------------------------------------------------------------------------

pub fn invoke_render_page(slug: &str) -> String {
    render_page(slug)
}
