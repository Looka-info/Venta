// ============================================================================
// ⚡ VentaNext Framework — Static Page Adapter for /shop/[[...filter]]
// Auto-Generated Module — DO NOT EDIT MANUALLY
// ============================================================================

import std::string::String;
import http::QueryMap;
import component::escape_html;
import std::option::Option;

pub fn render_page(filter: &str, query: &QueryMap) -> String {
    let mut html = String::from_str("<h1>Shop Catalog</h1><p>Active Filter: ");
    if filter.is_empty() {
        html.push_str("All Products (No Filter)");
    } else {
        let clean_filter = escape_html(filter);
        html.push_str(clean_filter.as_str());
    }
    html.push_str("</p>");

    let sort_opt = query.get("sort");
    match sort_opt {
        Option::Some(sort_val) => {
            html.push_str("<p>Sort Order: ");
            let clean_sort = escape_html(sort_val.as_str());
            html.push_str(clean_sort.as_str());
            html.push_str("</p>");
        }
        Option::None => {}
    }

    html
}

// ----------------------------------------------------------------------------
// Static Invocation Bridge
// ----------------------------------------------------------------------------

pub fn invoke_render_page(filter: &str, query: &QueryMap) -> String {
    render_page(filter, query)
}
