    test_http_response_and_wire_formatting();
    test_path_normalization_and_traversal_rejection();
    test_response_status_helpers_and_head();
    test_header_crlf_injection_rejection();
    test_repeated_query_and_header_preservation();
    test_method_not_allowed_405_lifecycle();
    test_component_builder_and_xss_escaping();
    test_etag_computation_and_determinism();
