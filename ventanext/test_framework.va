    assert(str_contains(resp_home.body.as_str(), "Next.js-Class Full-Stack Framework"), "1. Body must contain 'Next.js-Class Full-Stack Framework'");
    assert(str_contains(resp_home.body.as_str(), "<!DOCTYPE html>"), "1. Response must be wrapped in root layout");
    assert(!str_contains(resp_home.body.as_str(), "Pattern: /"), "1. Response must not be placeholder");

    // 2. GET /about executes real render_page() from app/about/page.va
    let mut req_about = make_request("GET", "/about", "", make_header_map(), "");
    let resp_about = server::dispatch_request_with_manifest(&gen_manifest, &mut req_about);
    assert(resp_about.status == 200, "2. Expected 200 OK for GET /about");
    assert(str_contains(resp_about.body.as_str(), "About VentaNext"), "2. Body must contain 'About VentaNext'");
    assert(str_contains(resp_about.body.as_str(), "High-performance, pure Venta full-stack"), "2. Body must contain 'High-performance, pure Venta full-stack'");
    assert(str_contains(resp_about.body.as_str(), "<!DOCTYPE html>"), "2. Response must be wrapped in root layout");
    assert(!str_contains(resp_about.body.as_str(), "Pattern: /about"), "2. Response must not be placeholder");

    // 3. GET /blog/venta executes real render_page(slug: &str) from app/blog/[slug]/page.va
    let mut req_blog = make_request("GET", "/blog/venta", "", make_header_map(), "");
    let resp_blog = server::dispatch_request_with_manifest(&gen_manifest, &mut req_blog);
    assert(resp_blog.status == 200, "3. Expected 200 OK for GET /blog/venta");
    assert(str_contains(resp_blog.body.as_str(), "Blog Post: venta"), "3. Body must contain 'Blog Post: venta'");
    assert(str_contains(resp_blog.body.as_str(), "Dynamic route parameter successfully extracted and rendered"), "3. Dynamic parameter must be rendered");
    assert(str_contains(resp_blog.body.as_str(), "<!DOCTYPE html>"), "3. Response must be wrapped in root layout");
    assert(!str_contains(resp_blog.body.as_str(), "slug = "), "3. Response must not be placeholder");

    // 4. GET /pricing executes real render_page() from app/(marketing)/pricing/page.va
    let mut req_pricing = make_request("GET", "/pricing", "", make_header_map(), "");
    let resp_pricing = server::dispatch_request_with_manifest(&gen_manifest, &mut req_pricing);
    assert(resp_pricing.status == 200, "4. Expected 200 OK for GET /pricing");
    assert(str_contains(resp_pricing.body.as_str(), "Pricing Plans"), "4. Body must contain 'Pricing Plans'");
    assert(str_contains(resp_pricing.body.as_str(), "Tier 1: Community (Free)"), "4. Body must contain 'Tier 1: Community (Free)'");
    assert(str_contains(resp_pricing.body.as_str(), "<!DOCTYPE html>"), "4. Response must be wrapped in root layout");

    // 5. GET /dashboard executes real render_page() from app/dashboard/page.va with nested dashboard layout
    let mut req_dash = make_request("GET", "/dashboard", "", make_header_map(), "");
    let resp_dash = server::dispatch_request_with_manifest(&gen_manifest, &mut req_dash);
    assert(resp_dash.status == 200, "5. Expected 200 OK for GET /dashboard");
    assert(str_contains(resp_dash.body.as_str(), "Dashboard Overview"), "5. Body must contain 'Dashboard Overview'");
    assert(str_contains(resp_dash.body.as_str(), "Server Status: Operational"), "5. Body must contain 'Server Status: Operational'");
    assert(str_contains(resp_dash.body.as_str(), "<!DOCTYPE html>"), "5. Response must be wrapped in root layout");
    assert(str_contains(resp_dash.body.as_str(), "Dashboard Section"), "5. Response must be wrapped in dashboard layout");

    // 6. GET /123/bar executes real render_page(id: &str) from app/[id]/bar/page.va
    let mut req_bar = make_request("GET", "/123/bar", "", make_header_map(), "");
    let resp_bar = server::dispatch_request_with_manifest(&gen_manifest, &mut req_bar);
    assert(resp_bar.status == 200, "6. Expected 200 OK for GET /123/bar");
    assert(str_contains(resp_bar.body.as_str(), "Route: /[id]/bar"), "6. Body must contain 'Route: /[id]/bar'");
    assert(str_contains(resp_bar.body.as_str(), "id = 123"), "6. Body must contain dynamic param 'id = 123'");

    // 7. Dispatching route with missing dynamic parameter returns safe error response
    let ctx_empty = ssr::make_render_context(
        "/blog/[slug]",
        "Blog Post",
        "home",
        http::make_param_map(),
        http::make_query_map(),
        http::make_header_map(),
        http::make_cookie_map(),
    );
    let resp_missing_param = generated_routes::dispatch_route(2, &ctx_empty);
    assert(resp_missing_param.status == 400, "7. Expected error status for missing dynamic parameter in dispatch_route");
    assert(str_contains(resp_missing_param.body.as_str(), "Missing required route parameter"), "7. Expected missing parameter error message");

    print_str("OK\n");
}

fn test_phase1_5_http_error_propagation_and_unsupported_routes() {
    print_str("[25/25] Testing Phase 1.5 HTTP Error Status Propagation & Unsupported Routes (1-8)... ");

    let gen_manifest = generated_routes::build_generated_manifest();

    // 1. response_not_implemented helper in http.va: verify status == 501, reason == "Not Implemented", content-type == "text/html; charset=utf-8"
    let resp_501 = response_not_implemented("<h1>501 — Page handler not supported</h1>");
    assert(resp_501.status == 501, "1. Expected status 501 for response_not_implemented");
    let reason_501 = status_reason(resp_501.status);
    assert(reason_501.as_str().equals("Not Implemented"), "1. Expected reason phrase 'Not Implemented'");
    assert(resp_501.content_type.as_str().equals("text/html; charset=utf-8"), "1. Expected Content-Type 'text/html; charset=utf-8'");
    assert(str_contains(resp_501.body.as_str(), "501 — Page handler not supported"), "1. Expected body content");
    let wire_501_helper = to_wire_format(&resp_501);
    assert(str_contains(wire_501_helper.as_str(), "HTTP/1.1 501 Not Implemented"), "1. Wire format must contain 'HTTP/1.1 501 Not Implemented'");

    // 2. Missing dynamic parameter route dispatch: verify status == 400 Bad Request, message present, without invoking render_page
    let ctx_empty = ssr::make_render_context(
        "/blog/[slug]",
        "Blog Post",
        "home",
        http::make_param_map(),
        http::make_query_map(),
        http::make_header_map(),
        http::make_cookie_map(),
    );
    let resp_missing_slug = generated_routes::dispatch_route(2, &ctx_empty);
    assert(resp_missing_slug.status == 400, "2. Expected 400 Bad Request for missing slug in /blog/[slug]");
    let r_400_slug = status_reason(resp_missing_slug.status);
    assert(r_400_slug.as_str().equals("Bad Request"), "2. Expected reason phrase 'Bad Request'");
    assert(str_contains(resp_missing_slug.body.as_str(), "400 — Missing required route parameter"), "2. Expected actionable 400 message in body");
    assert(!str_contains(resp_missing_slug.body.as_str(), "Blog Post:"), "2. Must NOT invoke page handler when dynamic parameter is missing");
    let wire_400_slug = to_wire_format(&resp_missing_slug);
    assert(str_contains(wire_400_slug.as_str(), "HTTP/1.1 400 Bad Request"), "2. Wire format must contain 'HTTP/1.1 400 Bad Request'");

    let resp_missing_id = generated_routes::dispatch_route(9, &ctx_empty);
    assert(resp_missing_id.status == 400, "2. Expected 400 Bad Request for missing id in /[id]/bar");
    let r_400_id = status_reason(resp_missing_id.status);
    assert(r_400_id.as_str().equals("Bad Request"), "2. Expected reason phrase 'Bad Request'");
    assert(str_contains(resp_missing_id.body.as_str(), "400 — Missing required route parameter"), "2. Expected actionable 400 message in /[id]/bar");
    assert(!str_contains(resp_missing_id.body.as_str(), "id = "), "2. Must NOT invoke page handler for /[id]/bar");

    // 3. Unmapped route ID dispatch: verify status == 404 Not Found, Content-Type == "text/html; charset=utf-8"
    let resp_unmapped = generated_routes::dispatch_route(99, &ctx_empty);
    assert(resp_unmapped.status == 404, "3. Expected 404 Not Found for unmapped route in dispatcher");
    let r_404_unmapped = status_reason(resp_unmapped.status);
    assert(r_404_unmapped.as_str().equals("Not Found"), "3. Expected reason phrase 'Not Found'");
    assert(resp_unmapped.content_type.as_str().equals("text/html; charset=utf-8"), "3. Expected Content-Type 'text/html; charset=utf-8'");
    assert(str_contains(resp_unmapped.body.as_str(), "404 — Page Not Found"), "3. Body must contain 404 message");
    let wire_unmapped = to_wire_format(&resp_unmapped);
    assert(str_contains(wire_unmapped.as_str(), "HTTP/1.1 404 Not Found"), "3. Wire format must contain 'HTTP/1.1 404 Not Found'");
    assert(str_contains(wire_unmapped.as_str(), "Content-Type: text/html; charset=utf-8"), "3. Wire format must contain Content-Type");

    // 4. Test manifest with unmapped page route: verify server preserves error status (does NOT convert to 200 or wrap in layout)
    let mut tm_unmapped = make_route_manifest();
    tm_unmapped.add_page_route("/unmapped-page", layout_root(), 99);
    let mut req_unmapped = make_request("GET", "/unmapped-page", "", make_header_map(), "");
    let resp_tm_unmapped = server::dispatch_request_with_manifest(&tm_unmapped, &mut req_unmapped);
    assert(resp_tm_unmapped.status == 404, "4. Expected 404 Not Found for unmapped page route");
    assert(!str_contains(resp_tm_unmapped.body.as_str(), "<!DOCTYPE html>"), "4. Error response must NOT be wrapped in layout");
    assert(resp_tm_unmapped.status != 200, "4. Response status must NOT be converted to 200");

    // 5. HEAD request on unmapped route: verify status == 404, empty body, Content-Length matching unsuppressed body
    let mut req_unmapped_head = make_request("HEAD", "/unmapped-page", "", make_header_map(), "");
    let resp_unmapped_head = server::dispatch_request_with_manifest(&tm_unmapped, &mut req_unmapped_head);
    assert(resp_unmapped_head.status == 404, "5. Expected status 404 for HEAD on unmapped route");
    assert(resp_unmapped_head.body.len_bytes() == 0, "5. HEAD response body must be empty (0 bytes)");
    let unsupp_head_cl = resp_unmapped_head.headers.get("content-length");
    assert(unsupp_head_cl.is_some(), "5. Expected Content-Length header for HEAD response");
    let wire_head_unmapped = to_wire_format(&resp_unmapped_head);
    assert(str_contains(wire_head_unmapped.as_str(), "HTTP/1.1 404 Not Found"), "5. HEAD wire format must contain 'HTTP/1.1 404 Not Found'");

    // 6. Regression tests: verify status 200 for /, /blog/venta (dynamic param & layout), /api/users, /api/health
    let mut req_root = make_request("GET", "/", "", make_header_map(), "");
    let resp_root = server::dispatch_request_with_manifest(&gen_manifest, &mut req_root);
    assert(resp_root.status == 200, "6. Expected 200 OK for GET /");
    let r_200_root = status_reason(resp_root.status);
    assert(r_200_root.as_str().equals("OK"), "6. Expected reason phrase 'OK'");
    assert(str_contains(resp_root.body.as_str(), "Welcome to VentaNext"), "6. Body must contain 'Welcome to VentaNext'");
    assert(str_contains(resp_root.body.as_str(), "<!DOCTYPE html>"), "6. Response must be wrapped in root layout");

    let mut req_blog = make_request("GET", "/blog/venta", "", make_header_map(), "");
    let resp_blog = server::dispatch_request_with_manifest(&gen_manifest, &mut req_blog);
    assert(resp_blog.status == 200, "6. Expected 200 OK for GET /blog/venta");
    let r_200_blog = status_reason(resp_blog.status);
    assert(r_200_blog.as_str().equals("OK"), "6. Expected reason phrase 'OK'");
    assert(str_contains(resp_blog.body.as_str(), "Blog Post: venta"), "6. Dynamic parameter must be rendered");
    assert(str_contains(resp_blog.body.as_str(), "Dynamic route parameter successfully extracted and rendered"), "6. Dynamic parameter message must be present");
    assert(str_contains(resp_blog.body.as_str(), "<!DOCTYPE html>"), "6. Response must be wrapped in root layout");

    let mut req_users = make_request("GET", "/api/users", "", make_header_map(), "");
    let resp_users = server::dispatch_request_with_manifest(&gen_manifest, &mut req_users);
    assert(resp_users.status == 200, "6. Expected 200 OK for GET /api/users");
    let r_200_users = status_reason(resp_users.status);
    assert(r_200_users.as_str().equals("OK"), "6. Expected reason phrase 'OK'");
    assert(str_contains(resp_users.body.as_str(), "Ada Lovelace"), "6. Response must contain user data");

    let mut req_health = make_request("GET", "/api/health", "", make_header_map(), "");
    let resp_health = server::dispatch_request_with_manifest(&gen_manifest, &mut req_health);
    assert(resp_health.status == 200, "6. Expected 200 OK for GET /api/health");
    let r_200_health = status_reason(resp_health.status);
    assert(r_200_health.as_str().equals("OK"), "6. Expected reason phrase 'OK'");
    assert(str_contains(resp_health.body.as_str(), "ventanext-health"), "6. Response must contain health data");
    assert(str_contains(resp_health.body.as_str(), "1.0.0-rc.2"), "6. Response must contain version");

    print_str("OK\n");
}

fn test_phase1_4b_catch_all_page_handler_invocation() {
    print_str("[26/26] Testing Phase 1.4B Catch-All & Optional Catch-All Page Handler Invocation (1-8)... ");

    let gen_manifest = generated_routes::build_generated_manifest();

    // 1. GET /docs/getting-started executes real render_page(path: &str) from app/docs/[...path]/page.va
    let mut req_docs = make_request("GET", "/docs/getting-started", "", make_header_map(), "");
    let resp_docs = server::dispatch_request_with_manifest(&gen_manifest, &mut req_docs);
    assert(resp_docs.status == 200, "1. Expected 200 OK for GET /docs/getting-started");
    assert(str_contains(resp_docs.body.as_str(), "Documentation: getting-started"), "1. Body must contain 'Documentation: getting-started'");
    assert(str_contains(resp_docs.body.as_str(), "Catch-all route pattern successfully resolved nested segments"), "1. Body must contain catch-all success message");
    assert(str_contains(resp_docs.body.as_str(), "<!DOCTYPE html>"), "1. Response must be wrapped in root layout");

    // 2. GET /docs/guide/deep/routing executes with multi-segment slash-separated path
    let mut req_docs_deep = make_request("GET", "/docs/guide/deep/routing", "", make_header_map(), "");
    let resp_docs_deep = server::dispatch_request_with_manifest(&gen_manifest, &mut req_docs_deep);
    assert(resp_docs_deep.status == 200, "2. Expected 200 OK for GET /docs/guide/deep/routing");
