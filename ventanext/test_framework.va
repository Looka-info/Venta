fn assert(condition: bool, message: &str) {
    if condition == false {
        print_str("Assertion FAILED: ");
        print_str(message);
        print_str("\n");
        exit_with_error(1);
    }
}

fn exit_with_error(code: i64) {
    let mut x: [i64; 1] = [code];
    let invalid_idx = 10;
    print_i64(x[invalid_idx]);
}

fn str_contains(haystack: &str, needle: &str) -> bool {
    let h_len = haystack.len();
    let n_len = needle.len();
    if n_len > h_len {
        return false;
    }
    let max_start = h_len - n_len;
    let mut i = 0;
    while i <= max_start {
        let sub = haystack.slice_bytes(i, i + n_len);
        match sub {
            Option::Some(s) => {
                if s.equals(needle) {
                    return true;
                }
            }
            Option::None => {}
        }
        i = i + 1;
    }
    false
}

fn test_route_manifest_registration_and_validation() {
    print_str("[1/22] Testing Route Manifest registration & validation... ");
    let mut m = make_route_manifest();
    m.add_page_route("/", layout_root(), 1);
    m.add_page_route("/about", layout_root(), 2);
    m.add_page_route("/dashboard", layout_root_and_dashboard(), 3);
    m.add_page_route("/posts/[slug]", layout_root(), 4);
    m.add_page_route("/docs/[...slug]", layout_root_and_docs(), 5);
    m.add_page_route("/shop/[[...filter]]", layout_root(), 6);
    m.add_api_route("GET", "/api/health", 100);

    let val_res = m.validate();
    match val_res {
        Result::Ok(count) => {
            assert(count == 7, "Expected 7 validated routes in manifest");
        }
        Result::Err(_) => {
            assert(false, "Valid manifest unexpectedly rejected");
        }
    }
    print_str("OK\n");
}

fn test_route_conflict_detection() {
    print_str("[2/22] Testing Route Conflict detection... ");
    let mut m = make_route_manifest();
    m.add_page_route("/blog/[id]", layout_root(), 10);
    m.add_page_route("/blog/[slug]", layout_root(), 11); // Conflict: ambiguous dynamic parameter

    let conf_res = m.validate();
    match conf_res {
        Result::Ok(_) => {
            assert(false, "Conflicting routes were not caught by validator");
        }
        Result::Err(err) => {
            assert(err.len_bytes() > 0, "Expected non-empty error message on conflict");
        }
    }

    let mut m_dup = make_route_manifest();
    m_dup.add_page_route("/pricing", layout_root(), 20);
    m_dup.add_page_route("/pricing", layout_root(), 21); // Conflict: duplicate static path
    let dup_res = m_dup.validate();
    match dup_res {
        Result::Ok(_) => {
            assert(false, "Duplicate routes were not caught by validator");
        }
        Result::Err(_) => {}
    }
    print_str("OK\n");
}

fn test_specificity_precedence() {
    print_str("[3/22] Testing Specificity Precedence (Static > Dynamic)... ");
    let mut m = make_route_manifest();
    m.add_page_route("/posts/[slug]", layout_root(), 100); // Dynamic
    m.add_page_route("/posts/new", layout_root(), 101);    // Static: higher specificity

    let m_res = match_route(&m, "/posts/new", "GET");
    match m_res {
        Option::Some(matched) => {
            assert(matched.page_id == 101, "Static route /posts/new must win over dynamic route /posts/[slug]");
        }
        Option::None => {
            assert(false, "Failed to match /posts/new");
        }
    }
    print_str("OK\n");
}

fn test_dynamic_param_extraction() {
    print_str("[4/22] Testing Dynamic Parameter Extraction ([param])... ");
    let mut m = make_route_manifest();
    m.add_page_route("/users/[id]", layout_root(), 200);

    let m_res = match_route(&m, "/users/user_9988", "GET");
    match m_res {
        Option::Some(matched) => {
            assert(matched.page_id == 200, "Expected match for /users/[id]");
            let id_param = matched.params.get("id");
            match id_param {
                Option::Some(id_str) => {
                    assert(id_str.as_str().equals("user_9988"), "Extracted param 'id' value mismatch");
                }
                Option::None => {
                    assert(false, "Parameter 'id' was not extracted");
                }
            }
        }
        Option::None => {
            assert(false, "Failed to match /users/user_9988");
        }
    }
    print_str("OK\n");
}

fn test_catch_all_param_extraction() {
    print_str("[5/22] Testing Catch-All Parameter Extraction ([...path])... ");
    let mut m = make_route_manifest();
    m.add_page_route("/docs/[...path]", layout_root(), 300);

    let m_res = match_route(&m, "/docs/routing/app-router/manifest", "GET");
    match m_res {
        Option::Some(matched) => {
            assert(matched.page_id == 300, "Expected match for /docs/[...path]");
            let path_param = matched.params.get("path");
            match path_param {
                Option::Some(p_str) => {
                    assert(p_str.as_str().equals("routing/app-router/manifest"), "Catch-all param value mismatch");
                }
                Option::None => {
                    assert(false, "Catch-all parameter 'path' was not extracted");
                }
            }
        }
        Option::None => {
            assert(false, "Failed to match /docs/routing/app-router/manifest");
        }
    }
    print_str("OK\n");
}

fn test_optional_catch_all_param_extraction() {
    print_str("[6/22] Testing Optional Catch-All Parameter Extraction ([[...filter]])... ");
    let mut m = make_route_manifest();
    m.add_page_route("/shop/[[...filter]]", layout_root(), 400);

    // Case A: 0 segments (base path /shop)
    let m_res_0 = match_route(&m, "/shop", "GET");
    match m_res_0 {
        Option::Some(matched) => {
            assert(matched.page_id == 400, "Expected match for /shop");
            let f_opt = matched.params.get("filter");
            match f_opt {
                Option::Some(f_str) => {
                    assert(f_str.as_str().equals(""), "Empty trailing segments must extract empty string");
                }
                Option::None => { assert(false, "Param 'filter' was not present"); }
            }
        }
        Option::None => { assert(false, "Failed to match optional catch-all with 0 segments"); }
    }

    // Case B: multiple segments (/shop/shoes/men/running)
    let m_res_n = match_route(&m, "/shop/shoes/men/running", "GET");
    match m_res_n {
        Option::Some(matched) => {
            assert(matched.page_id == 400, "Expected match for /shop/shoes/men/running");
            let f_opt = matched.params.get("filter");
            match f_opt {
                Option::Some(f_str) => {
                    assert(f_str.as_str().equals("shoes/men/running"), "Multiple trailing segments mismatch");
                }
                Option::None => { assert(false, "Param 'filter' was not present"); }
            }
        }
        Option::None => { assert(false, "Failed to match optional catch-all with multiple segments"); }
    }
    print_str("OK\n");
}

fn test_route_group_normalization() {
    print_str("[7/22] Testing Route Group Normalization ((group))... ");
    let mut m = make_route_manifest();
    m.add_page_route("/(marketing)/pricing", layout_root(), 500);
    m.add_page_route("/(admin)/settings", layout_root_and_dashboard(), 501);

    // Should match at URL without parenthesis
    let m_pricing = match_route(&m, "/pricing", "GET");
    match m_pricing {
        Option::Some(matched) => {
            assert(matched.page_id == 500, "Expected /pricing to match /(marketing)/pricing");
        }
        Option::None => { assert(false, "Failed to match /pricing"); }
    }

    let m_settings = match_route(&m, "/settings", "GET");
    match m_settings {
        Option::Some(matched) => {
            assert(matched.page_id == 501, "Expected /settings to match /(admin)/settings");
        }
        Option::None => { assert(false, "Failed to match /settings"); }
    }
    print_str("OK\n");
}

fn test_nested_layout_resolution() {
    print_str("[8/22] Testing Nested Layout Resolution (Root > Dashboard > Page)... ");
    let mut params = make_param_map();
    params.add("tab", "metrics");
    let ctx = make_render_context(
        "/dashboard/metrics",
        "Dashboard Metrics",
        "dashboard",
        params,
        make_query_map(),
        make_header_map(),
        make_cookie_map(),
    );

    let page_content = "<h2>Telemetry Metrics Component</h2>";
    let nested_html = resolve_layout(layout_root_and_dashboard(), &ctx, page_content);

    // Verify root layout structure
    assert(nested_html.len_bytes() > 100, "Output HTML must not be empty");
    let doc_slice_opt = nested_html.as_str().slice_bytes(0, 15);
    let mut has_doctype = false;
    match doc_slice_opt {
        Option::Some(s) => {
            if s.equals("<!DOCTYPE html>") {
                has_doctype = true;
            }
        }
        Option::None => {}
    }
    assert(has_doctype, "Must start with DOCTYPE");

    // Verify page content was included
    let has_content = nested_html.len_bytes() > page_content.len();
    assert(has_content, "Nested layout output must contain page content");
    print_str("OK\n");
}

fn test_http_request_parsing_lifecycle() {
    print_str("[9/22] Testing HTTP Request Parsing (Query, Headers, Cookies, Body)... ");
    let raw_http = "POST /api/echo?tag=venta&sort=desc HTTP/1.1\r\nHost: localhost:3000\r\nUser-Agent: VentaClient/1.0\r\nCookie: session_token=tok_98765; theme=midnight\r\nContent-Length: 18\r\n\r\n{\"key\":\"payload1\"}";
    let req = parse_http_request(raw_http);

    assert(req.method.as_str().equals("POST"), "Request method mismatch");
    assert(req.path.as_str().equals("/api/echo"), "Request path mismatch");
    assert(req.raw_query.as_str().equals("tag=venta&sort=desc"), "Raw query mismatch");

    // Query parameters
    let tag_param = req.query.get("tag");
    match tag_param {
        Option::Some(t) => { assert(t.as_str().equals("venta"), "Query param 'tag' mismatch"); }
        Option::None => { assert(false, "Query param 'tag' not found"); }
    }
    let sort_param = req.query.get("sort");
    match sort_param {
        Option::Some(s) => { assert(s.as_str().equals("desc"), "Query param 'sort' mismatch"); }
        Option::None => { assert(false, "Query param 'sort' not found"); }
    }

    // Headers (case-insensitive)
    let ua_header = req.headers.get("user-agent");
    match ua_header {
        Option::Some(ua) => { assert(ua.as_str().equals("VentaClient/1.0"), "Header 'User-Agent' mismatch"); }
        Option::None => { assert(false, "Header 'User-Agent' not found"); }
    }

    // Cookies
    let theme_cookie = req.cookies.get("theme");
    match theme_cookie {
        Option::Some(th) => { assert(th.as_str().equals("midnight"), "Cookie 'theme' mismatch"); }
        Option::None => { assert(false, "Cookie 'theme' not found"); }
    }

    // Body
    assert(req.body.as_str().equals("{\"key\":\"payload1\"}"), "Body mismatch");
    print_str("OK\n");
}

fn test_http_response_and_wire_formatting() {
    print_str("[10/22] Testing HTTP Response Model & Wire Formatting... ");
    let mut resp = response_json("{\"status\":\"ok\"}");
    set_cookie(&mut resp, "visited", "1", "/", 3600, true, true, "Lax");
    add_header(&mut resp, "X-Framework", "VentaNext");

    assert(resp.status == 200, "Expected status 200");
    assert(resp.content_type.as_str().equals("application/json; charset=utf-8"), "Content type mismatch");

    let wire = to_wire_format(&resp);
    let wire_slice_opt = wire.as_str().slice_bytes(0, 15);
    let mut is_wire_status_ok = false;
    match wire_slice_opt {
        Option::Some(s) => {
            if s.equals("HTTP/1.1 200 OK") {
                is_wire_status_ok = true;
            }
        }
        Option::None => {}
    }
    assert(is_wire_status_ok, "Wire format status line mismatch");

    let mut red_resp = response_redirect("/dashboard", 307);
    assert(red_resp.status == 307, "Redirect status mismatch");
    let loc_header = red_resp.headers.get("location");
    match loc_header {
        Option::Some(loc) => { assert(loc.as_str().equals("/dashboard"), "Redirect location mismatch"); }
        Option::None => { assert(false, "Redirect location header missing"); }
    }

    print_str("OK\n");
}

fn test_path_normalization_and_traversal_rejection() {
    print_str("[11/22] Testing Path Normalization & Traversal Rejection... ");
    let norm1 = normalize_request_path("//about///team");
    match norm1 {
        Result::Ok(p) => { assert(p.as_str().equals("/about/team"), "Repeated slashes not collapsed"); }
        Result::Err(_) => { assert(false, "Valid path unexpectedly rejected"); }
    }

    let norm2 = normalize_request_path("/blog/");
    match norm2 {
        Result::Ok(p) => { assert(p.as_str().equals("/blog"), "Trailing slash not stripped"); }
        Result::Err(_) => { assert(false, "Valid path unexpectedly rejected"); }
    }

    let trav1 = normalize_request_path("/../secret");
    match trav1 {
        Result::Ok(_) => { assert(false, "Path traversal /../ was not rejected"); }
        Result::Err(_) => {}
    }

    let trav2 = normalize_request_path("/docs/./intro");
    match trav2 {
        Result::Ok(_) => { assert(false, "Dot segment /./ was not rejected"); }
        Result::Err(_) => {}
    }
    print_str("OK\n");
}

fn test_response_status_helpers_and_head() {
    print_str("[12/22] Testing Response Status Helpers & HEAD Body Suppression... ");
    let bad = response_bad_request("Bad Request");
    assert(bad.status == 400, "Expected status 400");

    let mna = response_method_not_allowed("GET, HEAD");
    assert(mna.status == 405, "Expected status 405");
    let allow = mna.headers.get("allow");
    match allow {
        Option::Some(al) => { assert(al.as_str().equals("GET, HEAD"), "Allow header mismatch"); }
        Option::None => { assert(false, "Allow header missing in 405 response"); }
    }

    let noc = response_no_content();
    assert(noc.status == 204, "Expected status 204");

    let ise = response_internal_server_error("Fatal Error");
    assert(ise.status == 500, "Expected status 500");

    // HEAD Body Suppression test
    let test_resp = response_html("<h1>Big Document Body</h1>");
    let full_wire = to_wire_format_ex(&test_resp, false);
    let head_wire = to_wire_format_ex(&test_resp, true);

    assert(full_wire.len_bytes() > head_wire.len_bytes(), "HEAD response must suppress body content");
    print_str("OK\n");
}

fn test_header_crlf_injection_rejection() {
    print_str("[13/22] Testing CRLF Injection Prevention in Headers... ");
    let mut resp = response_json("{}");
    add_header(&mut resp, "X-Auth\r\nInjected", "Secret\r\nCookie");

    let val_opt = resp.headers.get("x-authinjected");
    match val_opt {
        Option::Some(val) => {
            assert(val.as_str().equals("SecretCookie"), "CRLF characters must be sanitized from header values");
        }
        Option::None => {
            assert(false, "Sanitized header was not stored");
        }
    }
    print_str("OK\n");
}

fn test_repeated_query_and_header_preservation() {
    print_str("[14/22] Testing Repeated Query Parameters & Header Preservation... ");
    let raw = "GET /search?tag=venta&tag=compiler&tag=systems HTTP/1.1\r\nHost: localhost\r\nSet-Cookie: a=1\r\nSet-Cookie: b=2\r\n\r\n";
    let req = parse_http_request(raw);

    let tags = req.query.get_all("tag");
    assert(tags.len() == 3, "Expected 3 repeated query parameter entries");

    let cookies = req.headers.get_all("set-cookie");
    assert(cookies.len() == 2, "Expected 2 repeated Set-Cookie headers");
    print_str("OK\n");
}

fn test_method_not_allowed_405_lifecycle() {
    print_str("[15/22] Testing 405 Method Not Allowed Lifecycle... ");
    let mut m = make_route_manifest();
    m.add_page_route("/about", layout_root(), 10);

    // GET /about matches
    let mut req_get = make_request("GET", "/about", "", make_header_map(), "");
    let resp_get = server::dispatch_request_with_manifest(&m, &mut req_get);
    assert(resp_get.status == 200, "Expected 200 OK for GET /about");

    // POST /about fails with 405 Method Not Allowed
    let mut req_post = make_request("POST", "/about", "", make_header_map(), "");
    let resp_post = server::dispatch_request_with_manifest(&m, &mut req_post);
    assert(resp_post.status == 405, "Expected 405 Method Not Allowed for POST /about");
    let allow = resp_post.headers.get("allow");
    assert(allow.is_some(), "Expected Allow header in 405 response");
    print_str("OK\n");
}

fn test_component_builder_and_xss_escaping() {
    print_str("[16/22] Testing Component Builder & XSS Escaping... ");
    let dangerous = "<script>alert('xss & attack')</script>\"";
    let safe = component::escape_html(dangerous);
    assert(safe.as_str().equals("&lt;script&gt;alert(&#39;xss &amp; attack&#39;)&lt;/script&gt;&quot;"), "XSS characters must be escaped");

    let button_html = component::tag("button", "class=\"btn-gold\"", "Click Me");
    assert(button_html.as_str().equals("<button class=\"btn-gold\">Click Me</button>"), "Tag builder must construct valid element");

    let link_html = component::a("/docs", "class=\"active\"", "Documentation");
    assert(link_html.as_str().equals("<a href=\"/docs\" class=\"active\">Documentation</a>"), "Link component must format href and attrs");
    print_str("OK\n");
}

fn test_etag_computation_and_determinism() {
    print_str("[17/22] Testing ETag Computation & Determinism... ");
    let body1 = "<html><body><h1>Hello VentaNext</h1></body></html>";
    let body2 = "<html><body><h1>Hello VentaNext</h1></body></html>";
    let etag1 = compute_etag(body1);
    let etag2 = compute_etag(body2);

    assert(etag1.as_str().equals(etag2.as_str()), "Identical body content must produce identical ETag");
    assert(etag1.len_bytes() > 6, "ETag must be non-empty");

    // ETag starts with W/"
    let prefix_opt = etag1.slice_bytes(0, 3);
    match prefix_opt {
        Option::Some(p) => {
            assert(p.equals("W/\""), "ETag must use RFC-standard weak validator W/ prefix");
        }
        Option::None => {
            assert(false, "ETag slice failed");
        }
    }
    print_str("OK\n");
}

fn test_conditional_if_none_match_304() {
    print_str("[18/22] Testing Conditional Request (If-None-Match -> 304)... ");
    let mut m = make_route_manifest();
    m.add_page_route("/about", layout_root(), 104);

    // Initial request: 200 OK with ETag
    let mut req1 = make_request("GET", "/about", "", make_header_map(), "");
    let resp1 = server::dispatch_request_with_manifest(&m, &mut req1);
    assert(resp1.status == 200, "Initial request must return 200 OK");
    let etag_opt = resp1.headers.get("etag");
    assert(etag_opt.is_some(), "Response must contain ETag header");

    let mut etag_val = String::new();
    match etag_opt {
        Option::Some(s) => { etag_val = s; }
        Option::None => {}
    }

    // Second conditional request with matching If-None-Match header
    let mut req2 = make_request("GET", "/about", "", make_header_map(), "");
    req2.headers.add("if-none-match", etag_val.as_str());
    let resp2 = server::dispatch_request_with_manifest(&m, &mut req2);

    assert(resp2.status == 304, "Matching If-None-Match must return 304 Not Modified");
    assert(resp2.body.is_empty(), "304 response body must be completely empty");
    let wire_304 = to_wire_format(&resp2);
    assert(wire_304.len_bytes() < 500, "304 wire response must be minimal without body");
    print_str("OK\n");
}

fn test_cache_control_headers_by_render_mode() {
    print_str("[19/22] Testing Cache-Control Policies by Render Mode... ");
    let mut m = make_route_manifest();
    m.add_page_route_with_mode("/static-page", layout_root(), 100, render_mode_static());
    m.add_page_route_with_mode("/dynamic-page", layout_root(), 105, render_mode_dynamic());
    m.add_api_route("GET", "/api/data", 200);

    // Static route -> public, max-age=0, must-revalidate
    let mut req_static = make_request("GET", "/static-page", "", make_header_map(), "");
    let resp_static = server::dispatch_request_with_manifest(&m, &mut req_static);
    let cc_static = resp_static.headers.get("cache-control");
    assert(cc_static.is_some(), "Static route must emit Cache-Control header");
    match cc_static {
        Option::Some(cc) => {
            assert(cc.as_str().equals("public, max-age=0, must-revalidate"), "Static route must require revalidation");
        }
        Option::None => {}
    }

    // Dynamic API route -> private, no-cache, no-store
    let mut req_dyn = make_request("GET", "/api/data", "", make_header_map(), "");
    let resp_dyn = server::dispatch_request_with_manifest(&m, &mut req_dyn);
    let cc_dyn = resp_dyn.headers.get("cache-control");
    assert(cc_dyn.is_some(), "Dynamic route must emit Cache-Control header");
    match cc_dyn {
        Option::Some(cc) => {
            assert(cc.as_str().equals("private, no-cache, no-store, must-revalidate"), "Dynamic route must prevent caching");
        }
        Option::None => {}
    }
    print_str("OK\n");
}

fn test_render_mode_classification_and_matching() {
    print_str("[20/22] Testing Render Mode Manifest Classification... ");
    let mut m = make_route_manifest();
    m.add_page_route("/", layout_root(), 100);
    m.add_page_route("/blog/[slug]", layout_root(), 105);
    m.add_page_route_with_mode("/cached", layout_root(), 106, render_mode_isr());

    let match_root = match_route(&m, "/", "GET");
    assert(match_root.is_some(), "Root route must match");
    match match_root {
        Option::Some(mr) => {
            assert(mr.render_mode == render_mode_static(), "Root route default mode must be Static");
        }
        Option::None => {}
    }

    let match_blog = match_route(&m, "/blog/hello", "GET");
    assert(match_blog.is_some(), "Dynamic route must match");
    match match_blog {
        Option::Some(mr) => {
            assert(mr.render_mode == render_mode_dynamic(), "Dynamic route default mode must be Dynamic");
        }
        Option::None => {}
    }

    let match_isr = match_route(&m, "/cached", "GET");
    assert(match_isr.is_some(), "ISR route must match");
    match match_isr {
        Option::Some(mr) => {
            assert(mr.render_mode == render_mode_isr(), "ISR route must preserve explicit ISR mode");
        }
        Option::None => {}
    }
    print_str("OK\n");
}

fn test_phase1_1_route_resolution_correctness_gate() {
    print_str("[21/22] Testing Phase 1.1 Route Resolution Correctness Gate (A-K)... ");

    // Case A & C: Static versus Dynamic and Declaration Order Reversal
    let mut m_ac1 = make_route_manifest();
    m_ac1.add_page_route("/users/[id]", layout_root(), 501);
    m_ac1.add_page_route("/users/new", layout_root(), 502);
    let res_ac1 = match_route(&m_ac1, "/users/new", "GET");
    match res_ac1 {
        Option::Some(matched) => {
            assert(matched.page_id == 502, "Case A: /users/new must resolve to static route (id 502)");
        }
        Option::None => { assert(false, "Case A: /users/new failed to match"); }
    }

    let mut m_ac2 = make_route_manifest();
    m_ac2.add_page_route("/users/new", layout_root(), 502);
    m_ac2.add_page_route("/users/[id]", layout_root(), 501);
    let res_ac2 = match_route(&m_ac2, "/users/new", "GET");
    match res_ac2 {
        Option::Some(matched) => {
            assert(matched.page_id == 502, "Case C: Reversing order in Case A must preserve static winner");
        }
        Option::None => { assert(false, "Case C: /users/new failed to match in reversed order"); }
    }

    // Case B & C: Earlier Static vs Later Static (/foo/[...rest] vs /[id]/bar)
    let mut m_bc1 = make_route_manifest();
    m_bc1.add_page_route("/foo/[...rest]", layout_root(), 601);
    m_bc1.add_page_route("/[id]/bar", layout_root(), 602);
    let res_bc1 = match_route(&m_bc1, "/foo/bar", "GET");
    match res_bc1 {
        Option::Some(matched) => {
            assert(matched.page_id == 601, "Case B: /foo/[...rest] must defeat /[id]/bar for /foo/bar");
            let rest_param = matched.params.get("rest");
            match rest_param {
                Option::Some(r) => { assert(r.as_str().equals("bar"), "Case B: rest param must be 'bar'"); }
                Option::None => { assert(false, "Case B: rest param missing"); }
            }
        }
        Option::None => { assert(false, "Case B: /foo/bar failed to match"); }
    }

    // Case C: Reversal of B
    let mut m_bc2 = make_route_manifest();
    m_bc2.add_page_route("/[id]/bar", layout_root(), 602);
    m_bc2.add_page_route("/foo/[...rest]", layout_root(), 601);
    let res_bc2 = match_route(&m_bc2, "/foo/bar", "GET");
    match res_bc2 {
        Option::Some(matched) => {
            assert(matched.page_id == 601, "Case C: Reversing order in Case B must preserve /foo/[...rest] winner");
            let rest_param = matched.params.get("rest");
            match rest_param {
                Option::Some(r) => { assert(r.as_str().equals("bar"), "Case C: rest param must be 'bar'"); }
                Option::None => { assert(false, "Case C: rest param missing in reversed order"); }
            }
        }
        Option::None => { assert(false, "Case C: /foo/bar failed to match in reversed order"); }
    }

    // Verify non-foo requests route to /[id]/bar
    let res_bc3 = match_route(&m_bc2, "/alpha/bar", "GET");
    match res_bc3 {
        Option::Some(matched) => {
            assert(matched.page_id == 602, "Non-foo request /alpha/bar must resolve to /[id]/bar");
            let id_param = matched.params.get("id");
            match id_param {
                Option::Some(id_val) => { assert(id_val.as_str().equals("alpha"), "Param 'id' must be 'alpha'"); }
                Option::None => { assert(false, "Param 'id' missing for /alpha/bar"); }
            }
        }
        Option::None => { assert(false, "Failed to match /alpha/bar"); }
    }

    // Case D: Dynamic vs Catch-All (/posts/[id] vs /posts/[...slug])
    let mut m_d1 = make_route_manifest();
    m_d1.add_page_route("/posts/[...slug]", layout_root(), 702);
    m_d1.add_page_route("/posts/[id]", layout_root(), 701);
    let res_d1 = match_route(&m_d1, "/posts/123", "GET");
    match res_d1 {
        Option::Some(matched) => {
            assert(matched.page_id == 701, "Case D: /posts/[id] must defeat /posts/[...slug] for /posts/123");
            let id_param = matched.params.get("id");
            match id_param {
                Option::Some(id_val) => { assert(id_val.as_str().equals("123"), "Param 'id' must be '123'"); }
                Option::None => { assert(false, "Param 'id' missing for /posts/123"); }
            }
        }
        Option::None => { assert(false, "Case D: /posts/123 failed to match"); }
    }

    // Case E: Required Catch-All
    let mut m_e = make_route_manifest();
    m_e.add_page_route("/docs/[...path]", layout_root(), 801);
    let res_e1 = match_route(&m_e, "/docs/a/b/c", "GET");
    match res_e1 {
        Option::Some(matched) => {
            assert(matched.page_id == 801, "Case E: /docs/[...path] matches /docs/a/b/c");
            let p_param = matched.params.get("path");
            match p_param {
                Option::Some(p) => { assert(p.as_str().equals("a/b/c"), "Param 'path' must be 'a/b/c'"); }
                Option::None => { assert(false, "Param 'path' missing for /docs/a/b/c"); }
            }
        }
        Option::None => { assert(false, "Case E: /docs/a/b/c failed to match"); }
    }
    let res_e2 = match_route(&m_e, "/docs", "GET");
    assert(res_e2.is_none(), "Case E: /docs must NOT match required catch-all /docs/[...path]");

    // Case F: Optional Catch-All
    let mut m_f = make_route_manifest();
    m_f.add_page_route("/store/[[...filter]]", layout_root(), 901);
    let res_f1 = match_route(&m_f, "/store/shoes/nike", "GET");
    match res_f1 {
        Option::Some(matched) => {
            assert(matched.page_id == 901, "Case F: /store/[[...filter]] matches /store/shoes/nike");
            let f_param = matched.params.get("filter");
            match f_param {
                Option::Some(f) => { assert(f.as_str().equals("shoes/nike"), "Param 'filter' must be 'shoes/nike'"); }
                Option::None => { assert(false, "Param 'filter' missing"); }
            }
        }
        Option::None => { assert(false, "Case F: /store/shoes/nike failed to match"); }
    }
    let res_f2 = match_route(&m_f, "/store", "GET");
    match res_f2 {
        Option::Some(matched) => {
            assert(matched.page_id == 901, "Case F: /store/[[...filter]] matches /store with 0 segments");
            let f_param = matched.params.get("filter");
            match f_param {
                Option::Some(f) => { assert(f.as_str().equals(""), "Param 'filter' must be empty string"); }
                Option::None => { assert(false, "Param 'filter' missing for empty match"); }
            }
        }
        Option::None => { assert(false, "Case F: /store failed to match optional catch-all"); }
    }

    // Case G: Exact route vs Optional Catch-All
    let mut m_g1 = make_route_manifest();
    m_g1.add_page_route("/store/[[...filter]]", layout_root(), 901);
    m_g1.add_page_route("/store", layout_root(), 900);
    let res_g1 = match_route(&m_g1, "/store", "GET");
    match res_g1 {
        Option::Some(matched) => {
            assert(matched.page_id == 900, "Case G: Exact route /store must defeat /store/[[...filter]]");
        }
        Option::None => { assert(false, "Case G: /store failed to match"); }
    }

    let mut m_g2 = make_route_manifest();
    m_g2.add_page_route("/store", layout_root(), 900);
    m_g2.add_page_route("/store/[[...filter]]", layout_root(), 901);
    let res_g2 = match_route(&m_g2, "/store", "GET");
    match res_g2 {
        Option::Some(matched) => {
            assert(matched.page_id == 900, "Case G (reversed): Exact route /store must defeat /store/[[...filter]]");
        }
        Option::None => { assert(false, "Case G (reversed): /store failed to match"); }
    }

    // Case H & I: Backtracking & Parameter Extraction
    let mut m_hi = make_route_manifest();
    m_hi.add_page_route("/items/special/review", layout_root(), 1001);
    m_hi.add_page_route("/items/[category]/[action]", layout_root(), 1002);
    let res_hi = match_route(&m_hi, "/items/special/delete", "GET");
    match res_hi {
        Option::Some(matched) => {
            assert(matched.page_id == 1002, "Case H: /items/special/delete must backtrack to /items/[category]/[action]");
            let cat_param = matched.params.get("category");
            match cat_param {
                Option::Some(cat) => { assert(cat.as_str().equals("special"), "Case I: category param must be 'special'"); }
                Option::None => { assert(false, "Case I: category param missing"); }
            }
            let act_param = matched.params.get("action");
            match act_param {
                Option::Some(act) => { assert(act.as_str().equals("delete"), "Case I: action param must be 'delete'"); }
                Option::None => { assert(false, "Case I: action param missing"); }
            }
        }
        Option::None => { assert(false, "Case H: /items/special/delete unexpectedly returned 404 (backtracking failure)"); }
    }

    // Case J: Conflict Detection & Structural Shape Consistency
    let mut m_j_conf = make_route_manifest();
    m_j_conf.add_page_route("/blog/[slug]", layout_root(), 1101);
    m_j_conf.add_page_route("/blog/[id]", layout_root(), 1102);
    let val_j_conf = m_j_conf.validate();
    assert(val_j_conf.is_err(), "Case J: /blog/[slug] and /blog/[id] must be rejected as conflicting");

    let mut m_j_catch = make_route_manifest();
    m_j_catch.add_page_route("/docs/[...path]", layout_root(), 1103);
    m_j_catch.add_page_route("/docs/[...rest]", layout_root(), 1104);
    assert(m_j_catch.validate().is_err(), "Case J: /docs/[...path] and /docs/[...rest] must be rejected as conflicting");

    let mut m_j_opt = make_route_manifest();
    m_j_opt.add_page_route("/store/[[...filter]]", layout_root(), 1105);
    m_j_opt.add_page_route("/store/[[...category]]", layout_root(), 1106);
    assert(m_j_opt.validate().is_err(), "Case J: /store/[[...filter]] and /store/[[...category]] must be rejected as conflicting");

    let mut m_j_mixed = make_route_manifest();
    m_j_mixed.add_page_route("/docs/[id]/[...path]", layout_root(), 1107);
    m_j_mixed.add_page_route("/docs/[slug]/[...rest]", layout_root(), 1108);
    assert(m_j_mixed.validate().is_err(), "Case J: /docs/[id]/[...path] and /docs/[slug]/[...rest] must be rejected as conflicting");

    let mut m_j_grp = make_route_manifest();
    m_j_grp.add_page_route("/(marketing)/docs/[...path]", layout_root(), 1109);
    m_j_grp.add_page_route("/(docs_group)/docs/[...rest]", layout_root(), 1110);
    assert(m_j_grp.validate().is_err(), "Case J: Route groups normalizing to /docs/[...path] and /docs/[...rest] must conflict");

    let mut m_j_valid = make_route_manifest();
    m_j_valid.add_page_route("/blog/new", layout_root(), 1111);
    m_j_valid.add_page_route("/blog/[id]", layout_root(), 1112);
    let val_j_valid = m_j_valid.validate();
    assert(val_j_valid.is_ok(), "Case J: /blog/new and /blog/[id] must be allowed under precedence rules");

    let mut m_j_dyn_catch = make_route_manifest();
    m_j_dyn_catch.add_page_route("/posts/[id]", layout_root(), 1113);
    m_j_dyn_catch.add_page_route("/posts/[...slug]", layout_root(), 1114);
    assert(m_j_dyn_catch.validate().is_ok(), "Case J: /posts/[id] and /posts/[...slug] must remain valid");

    let mut m_j_req_opt = make_route_manifest();
    m_j_req_opt.add_page_route("/docs/[...path]", layout_root(), 1115);
    m_j_req_opt.add_page_route("/docs/[[...filter]]", layout_root(), 1116);
    assert(m_j_req_opt.validate().is_ok(), "Case J: /docs/[...path] and /docs/[[...filter]] must remain valid");

    let mut m_j_exact_opt = make_route_manifest();
    m_j_exact_opt.add_page_route("/shop", layout_root(), 1117);
    m_j_exact_opt.add_page_route("/shop/[[...filter]]", layout_root(), 1118);
    assert(m_j_exact_opt.validate().is_ok(), "Case J: /shop and /shop/[[...filter]] must remain valid");

    // Case K: Repeatability (100 iterations of matching produce identical results)
    let mut k_iter = 0;
    while k_iter < 100 {
        let res_k = match_route(&m_bc1, "/foo/bar", "GET");
        match res_k {
            Option::Some(matched) => {
                assert(matched.page_id == 601, "Case K: Repeatability check failed at iteration");
            }
            Option::None => { assert(false, "Case K: Match failed during repeatability loop"); }
        }
        k_iter = k_iter + 1;
    }

    print_str("OK\n");
}

fn main() -> i64 {
    print_str("\n============================================================\n");
    print_str("   ⚡ VentaNext Framework — Phase 1 & 2 Automated Test Suite \n");
    print_str("============================================================\n");

    test_route_manifest_registration_and_validation();
    test_route_conflict_detection();
    test_specificity_precedence();
    test_dynamic_param_extraction();
    test_catch_all_param_extraction();
    test_optional_catch_all_param_extraction();
    test_route_group_normalization();
    test_nested_layout_resolution();
    test_http_request_parsing_lifecycle();
    test_http_response_and_wire_formatting();
    test_path_normalization_and_traversal_rejection();
    test_response_status_helpers_and_head();
    test_header_crlf_injection_rejection();
    test_repeated_query_and_header_preservation();
    test_method_not_allowed_405_lifecycle();
    test_component_builder_and_xss_escaping();
    test_etag_computation_and_determinism();
    test_conditional_if_none_match_304();
    test_cache_control_headers_by_render_mode();
    test_render_mode_classification_and_matching();
    test_phase1_1_route_resolution_correctness_gate();
    test_phase1_2_http_method_dispatch_and_allow_headers();

    print_str("============================================================\n");
    print_str("   ALL 22 TEST SUITES PASSED (100% SUCCESS)\n");
    print_str("============================================================\n\n");
    0
}

fn test_phase1_2_http_method_dispatch_and_allow_headers() {
    print_str("[22/22] Testing Phase 1.2 HTTP Method Dispatch & Allow Headers (1-12)... ");

    let gen_manifest = generated_routes::build_generated_manifest();

    // 1. GET selects the GET handler
    let mut req_get = make_request("GET", "/api/health", "", make_header_map(), "");
    let resp_get = server::dispatch_request_with_manifest(&gen_manifest, &mut req_get);
    assert(resp_get.status == 200, "1. Expected 200 for GET /api/health");
    assert(str_contains(resp_get.body.as_str(), "\"method\":\"GET\""), "1. Handler must reflect GET method");

    // 2. POST selects the POST handler
    let mut req_post = make_request("POST", "/api/health", "", make_header_map(), "{\"action\":\"check\"}");
    let resp_post = server::dispatch_request_with_manifest(&gen_manifest, &mut req_post);
    assert(resp_post.status == 200, "2. Expected 200 for POST /api/health");
    assert(str_contains(resp_post.body.as_str(), "\"method\":\"POST\""), "2. Handler must reflect POST method");

    // 3. PUT selects the PUT handler when registered
    let mut req_put = make_request("PUT", "/api/health", "", make_header_map(), "{\"update\":true}");
    let resp_put = server::dispatch_request_with_manifest(&gen_manifest, &mut req_put);
    assert(resp_put.status == 200, "3. Expected 200 for PUT /api/health");
    assert(str_contains(resp_put.body.as_str(), "\"method\":\"PUT\""), "3. Handler must reflect PUT method");

    // 4. DELETE selects the DELETE handler when registered
    let mut req_del = make_request("DELETE", "/api/health", "", make_header_map(), "");
    let resp_del = server::dispatch_request_with_manifest(&gen_manifest, &mut req_del);
    assert(resp_del.status == 200, "4. Expected 200 for DELETE /api/health");
    assert(str_contains(resp_del.body.as_str(), "\"method\":\"DELETE\""), "4. Handler must reflect DELETE method");

    // 5. PATCH selects the PATCH handler when registered
    let mut req_patch = make_request("PATCH", "/api/health", "", make_header_map(), "{\"patch\":1}");
    let resp_patch = server::dispatch_request_with_manifest(&gen_manifest, &mut req_patch);
    assert(resp_patch.status == 200, "5. Expected 200 for PATCH /api/health");
    assert(str_contains(resp_patch.body.as_str(), "\"method\":\"PATCH\""), "5. Handler must reflect PATCH method");

    // 6. Unsupported PUT on a GET-only page returns 405
    let mut req_page_put = make_request("PUT", "/about", "", make_header_map(), "");
    let resp_page_put = server::dispatch_request_with_manifest(&gen_manifest, &mut req_page_put);
    assert(resp_page_put.status == 405, "6. Expected 405 for PUT /about");
    let allow6 = resp_page_put.headers.get("allow");
    assert(allow6.is_some(), "6. Expected Allow header in 405 response");
    match allow6 {
        Option::Some(al) => {
            assert(al.as_str().equals("GET, HEAD, OPTIONS"), "6. Allow header must be GET, HEAD, OPTIONS");
        }
        Option::None => {}
    }

    // 7. Unsupported DELETE on a GET-only API returns 405
    let mut req_api_del = make_request("DELETE", "/api/users", "", make_header_map(), "");
    let resp_api_del = server::dispatch_request_with_manifest(&gen_manifest, &mut req_api_del);
    assert(resp_api_del.status == 405, "7. Expected 405 for DELETE /api/users");
    let allow7 = resp_api_del.headers.get("allow");
    assert(allow7.is_some(), "7. Expected Allow header in 405 response");
    match allow7 {
        Option::Some(al) => {
            assert(al.as_str().equals("GET, HEAD, OPTIONS"), "7. Allow header must be GET, HEAD, OPTIONS for GET-only API");
        }
        Option::None => {}
    }

    // 8. HEAD returns the correct status and headers with an empty body
    let mut req_head = make_request("HEAD", "/about", "", make_header_map(), "");
    let resp_head = server::dispatch_request_with_manifest(&gen_manifest, &mut req_head);
    assert(resp_head.status == 200, "8. Expected 200 for HEAD /about");
    assert(resp_head.body.is_empty(), "8. HEAD response body must be empty in memory");
    let cl8 = resp_head.headers.get("content-length");
    assert(cl8.is_some(), "8. Expected Content-Length header preserved for HEAD");
    let wire_head = to_wire_format_ex(&resp_head, true);
    assert(str_contains(wire_head.as_str(), "Content-Length:"), "8. Wire must contain Content-Length");
    assert(str_contains(wire_head.as_str(), "HTTP/1.1 200 OK"), "8. Wire must be 200 OK");

    // 9. Explicit OPTIONS handlers are respected
    let mut req_opt_explicit = make_request("OPTIONS", "/api/health", "", make_header_map(), "");
    let resp_opt_explicit = server::dispatch_request_with_manifest(&gen_manifest, &mut req_opt_explicit);
    assert(resp_opt_explicit.status == 200, "9. Expected 200 for explicit OPTIONS handler on /api/health");
    assert(str_contains(resp_opt_explicit.body.as_str(), "\"method\":\"OPTIONS\""), "9. Expected explicit OPTIONS response body");

    // 10. CORS preflight remains functional on routes without explicit OPTIONS
    let mut req_opt_preflight = make_request("OPTIONS", "/about", "", make_header_map(), "");
    let resp_opt_preflight = server::dispatch_request_with_manifest(&gen_manifest, &mut req_opt_preflight);
    assert(resp_opt_preflight.status == 204, "10. Expected 204 No Content for CORS preflight on /about");
    let acao = resp_opt_preflight.headers.get("access-control-allow-origin");
    assert(acao.is_some(), "10. Expected CORS Access-Control-Allow-Origin header");
    let acam = resp_opt_preflight.headers.get("access-control-allow-methods");
    assert(acam.is_some(), "10. Expected CORS Access-Control-Allow-Methods header");

    // 11. The Allow header reflects the matching route's supported methods (Test manifest verification)
    let mut tm = make_route_manifest();
    tm.add_api_route("POST", "/api/items", 501);
    tm.add_api_route("PUT", "/api/items", 502);

    let mut req_tm_get = make_request("GET", "/api/items", "", make_header_map(), "");
    let resp_tm_get = server::dispatch_request_with_manifest(&tm, &mut req_tm_get);
    assert(resp_tm_get.status == 405, "11. Expected 405 for GET on POST+PUT endpoint");
    let allow11 = resp_tm_get.headers.get("allow");
    assert(allow11.is_some(), "11. Expected Allow header in 405 response");
    match allow11 {
        Option::Some(al) => {
            assert(al.as_str().equals("POST, PUT, OPTIONS"), "11. Allow header must exactly be POST, PUT, OPTIONS");
        }
        Option::None => {}
    }

    // Also verify distinct handler selection on test manifest
    let mut req_tm_post = make_request("POST", "/api/items", "", make_header_map(), "");
    let resp_tm_post = server::dispatch_request_with_manifest(&tm, &mut req_tm_post);
    assert(resp_tm_post.status == 200, "11. Expected 200 for POST /api/items");
    assert(str_contains(resp_tm_post.body.as_str(), "\"handler_id\":501"), "11. Handler 501 must be dispatched for POST");

    let mut req_tm_put = make_request("PUT", "/api/items", "", make_header_map(), "");
    let resp_tm_put = server::dispatch_request_with_manifest(&tm, &mut req_tm_put);
    assert(resp_tm_put.status == 200, "11. Expected 200 for PUT /api/items");
    assert(str_contains(resp_tm_put.body.as_str(), "\"handler_id\":502"), "11. Handler 502 must be dispatched for PUT");

    // 12. An unknown path still returns 404 across all HTTP methods
    let mut req_404_get = make_request("GET", "/completely/nonexistent/path", "", make_header_map(), "");
    let resp_404_get = server::dispatch_request_with_manifest(&gen_manifest, &mut req_404_get);
    assert(resp_404_get.status == 404, "12. Expected 404 for GET /nonexistent");

    let mut req_404_post = make_request("POST", "/completely/nonexistent/path", "", make_header_map(), "");
    let resp_404_post = server::dispatch_request_with_manifest(&gen_manifest, &mut req_404_post);
    assert(resp_404_post.status == 404, "12. Expected 404 for POST /nonexistent");

    let mut req_404_opt = make_request("OPTIONS", "/completely/nonexistent/path", "", make_header_map(), "");
    let resp_404_opt = server::dispatch_request_with_manifest(&gen_manifest, &mut req_404_opt);
    assert(resp_404_opt.status == 404, "12. Expected 404 for OPTIONS on unknown path");

    print_str("OK\n");
}
