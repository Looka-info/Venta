    assert(str_contains(resp_docs_deep.body.as_str(), "<!DOCTYPE html>"), "2. Response must be wrapped in root layout");

    // 3. GET /shop executes real render_page(filter: &str) from app/shop/[[...filter]]/page.va at the optional base path
    let mut req_shop = make_request("GET", "/shop", "", make_header_map(), "");
    let resp_shop = server::dispatch_request_with_manifest(&gen_manifest, &mut req_shop);
    assert(resp_shop.status == 200, "3. Expected 200 OK for GET /shop");
    assert(str_contains(resp_shop.body.as_str(), "Shop Catalog"), "3. Body must contain 'Shop Catalog'");
    assert(str_contains(resp_shop.body.as_str(), "Active Filter: All Products (No Filter)"), "3. Body must contain empty filter indicator");
    assert(str_contains(resp_shop.body.as_str(), "<!DOCTYPE html>"), "3. Response must be wrapped in root layout");

    // 4. GET /shop/electronics executes with single filter segment
    let mut req_shop_elec = make_request("GET", "/shop/electronics", "", make_header_map(), "");
    let resp_shop_elec = server::dispatch_request_with_manifest(&gen_manifest, &mut req_shop_elec);
    assert(resp_shop_elec.status == 200, "4. Expected 200 OK for GET /shop/electronics");
    assert(str_contains(resp_shop_elec.body.as_str(), "Active Filter: electronics"), "4. Body must contain 'Active Filter: electronics'");
    assert(str_contains(resp_shop_elec.body.as_str(), "<!DOCTYPE html>"), "4. Response must be wrapped in root layout");

    // 5. GET /shop/shoes/nike executes with multi-segment filter
    let mut req_shop_shoes = make_request("GET", "/shop/shoes/nike", "", make_header_map(), "");
    let resp_shop_shoes = server::dispatch_request_with_manifest(&gen_manifest, &mut req_shop_shoes);
    assert(resp_shop_shoes.status == 200, "5. Expected 200 OK for GET /shop/shoes/nike");
    assert(str_contains(resp_shop_shoes.body.as_str(), "Active Filter: shoes/nike"), "5. Body must contain 'Active Filter: shoes/nike'");

    // 6. GET /foo/bar/baz executes real render_page(rest: &str) from app/foo/[...rest]/page.va
    let mut req_foo = make_request("GET", "/foo/bar/baz", "", make_header_map(), "");
    let resp_foo = server::dispatch_request_with_manifest(&gen_manifest, &mut req_foo);
    assert(resp_foo.status == 200, "6. Expected 200 OK for GET /foo/bar/baz");
    assert(str_contains(resp_foo.body.as_str(), "Route: /foo/[...rest]"), "6. Body must contain 'Route: /foo/[...rest]'");
    assert(str_contains(resp_foo.body.as_str(), "rest = bar/baz"), "6. Body must contain 'rest = bar/baz'");

    // 7. HEAD request on /docs/getting-started returns 200 OK, empty body, Content-Length preserved
    let mut req_head_docs = make_request("HEAD", "/docs/getting-started", "", make_header_map(), "");
    let resp_head_docs = server::dispatch_request_with_manifest(&gen_manifest, &mut req_head_docs);
    assert(resp_head_docs.status == 200, "7. Expected 200 OK for HEAD /docs/getting-started");
    assert(resp_head_docs.body.len_bytes() == 0, "7. HEAD body must be suppressed (0 bytes)");
    let head_docs_cl = resp_head_docs.headers.get("content-length");
    assert(head_docs_cl.is_some(), "7. Expected Content-Length header for HEAD response");

    // 8. Missing parameter error handling: dispatching /docs/[...path] with empty params returns 400 Bad Request
    let ctx_empty = ssr::make_render_context(
        "/docs/[...path]",
        "Docs",
        "home",
        http::make_param_map(),
        http::make_query_map(),
        http::make_header_map(),
        http::make_cookie_map(),
    );
    let resp_missing_docs = generated_routes::dispatch_route(3, &ctx_empty);
    assert(resp_missing_docs.status == 400, "8. Expected 400 Bad Request for missing path parameter in /docs/[...path]");
    assert(str_contains(resp_missing_docs.body.as_str(), "400 — Missing required route parameter"), "8. Expected 400 missing parameter message");

    print_str("OK\n");
}

fn test_phase1_5_query_string_and_request_context_passing() {
    print_str("[27/27] Testing Phase 1.5 Query String & Request Context Passing (1-8)... ");

    let gen_manifest = generated_routes::build_generated_manifest();

    // 1. GET /shop?sort=price_asc executes render_page(filter, query) with base path filter and active sort
    let mut req_shop_sort = make_request("GET", "/shop", "sort=price_asc", make_header_map(), "");
    let resp_shop_sort = server::dispatch_request_with_manifest(&gen_manifest, &mut req_shop_sort);
    assert(resp_shop_sort.status == 200, "1. Expected 200 OK for GET /shop?sort=price_asc");
    assert(str_contains(resp_shop_sort.body.as_str(), "Shop Catalog"), "1. Body must contain 'Shop Catalog'");
    assert(str_contains(resp_shop_sort.body.as_str(), "Active Filter: All Products (No Filter)"), "1. Body must contain empty filter indicator");
    assert(str_contains(resp_shop_sort.body.as_str(), "Sort Order: price_asc"), "1. Body must contain query parameter 'Sort Order: price_asc'");
    assert(str_contains(resp_shop_sort.body.as_str(), "<!DOCTYPE html>"), "1. Response must be wrapped in root layout");

    // 2. GET /shop/electronics?sort=desc executes render_page(filter, query) with dynamic filter and sort
    let mut req_shop_elec = make_request("GET", "/shop/electronics", "sort=desc", make_header_map(), "");
    let resp_shop_elec = server::dispatch_request_with_manifest(&gen_manifest, &mut req_shop_elec);
    assert(resp_shop_elec.status == 200, "2. Expected 200 OK for GET /shop/electronics?sort=desc");
    assert(str_contains(resp_shop_elec.body.as_str(), "Active Filter: electronics"), "2. Body must contain 'Active Filter: electronics'");
    assert(str_contains(resp_shop_elec.body.as_str(), "Sort Order: desc"), "2. Body must contain 'Sort Order: desc'");

    // 3. GET /shop/shoes/nike?sort=newest executes with multi-segment filter and sort query
    let mut req_shop_shoes = make_request("GET", "/shop/shoes/nike", "sort=newest&currency=usd", make_header_map(), "");
    let resp_shop_shoes = server::dispatch_request_with_manifest(&gen_manifest, &mut req_shop_shoes);
    assert(resp_shop_shoes.status == 200, "3. Expected 200 OK for GET /shop/shoes/nike?sort=newest&currency=usd");
    assert(str_contains(resp_shop_shoes.body.as_str(), "Active Filter: shoes/nike"), "3. Body must contain 'Active Filter: shoes/nike'");
    assert(str_contains(resp_shop_shoes.body.as_str(), "Sort Order: newest"), "3. Body must contain 'Sort Order: newest'");

    // 4. GET /dashboard?tab=analytics executes render_page(ctx: &RenderContext) and accesses ctx.query
    let mut req_dash_tab = make_request("GET", "/dashboard", "tab=analytics", make_header_map(), "");
    let resp_dash_tab = server::dispatch_request_with_manifest(&gen_manifest, &mut req_dash_tab);
    assert(resp_dash_tab.status == 200, "4. Expected 200 OK for GET /dashboard?tab=analytics");
    assert(str_contains(resp_dash_tab.body.as_str(), "Dashboard Overview"), "4. Body must contain 'Dashboard Overview'");
    assert(str_contains(resp_dash_tab.body.as_str(), "Active Tab: analytics"), "4. Body must contain 'Active Tab: analytics'");
    assert(str_contains(resp_dash_tab.body.as_str(), "Dashboard Section"), "4. Response must be wrapped in nested dashboard layout");
    assert(str_contains(resp_dash_tab.body.as_str(), "<!DOCTYPE html>"), "4. Response must be wrapped in root layout");

    // 5. GET /dashboard without query string executes render_page(ctx) cleanly without tab paragraph
    let mut req_dash_clean = make_request("GET", "/dashboard", "", make_header_map(), "");
    let resp_dash_clean = server::dispatch_request_with_manifest(&gen_manifest, &mut req_dash_clean);
    assert(resp_dash_clean.status == 200, "5. Expected 200 OK for GET /dashboard");
    assert(str_contains(resp_dash_clean.body.as_str(), "Dashboard Overview"), "5. Body must contain 'Dashboard Overview'");
    assert(!str_contains(resp_dash_clean.body.as_str(), "Active Tab:"), "5. Body must NOT contain Active Tab when no query provided");

    // 6. Full HTTP Request parsing with query string, custom headers, and cookies through server lifecycle
    let raw_http = "GET /dashboard?tab=telemetry&period=30d HTTP/1.1\r\nHost: localhost:3000\r\nUser-Agent: VentaTest/1.0\r\nCookie: session_token=secret_abc123\r\n\r\n";
    let mut parsed_req = parse_http_request(raw_http);
    assert(parsed_req.raw_query.as_str().equals("tab=telemetry&period=30d"), "6. Request must parse raw_query correctly");
    assert(parsed_req.query.get("tab").is_some(), "6. QueryMap must contain 'tab'");
    assert(parsed_req.headers.get("user-agent").is_some(), "6. HeaderMap must contain 'user-agent'");
    assert(parsed_req.cookies.get("session_token").is_some(), "6. CookieMap must contain 'session_token'");

    let resp_parsed = server::dispatch_request_with_manifest(&gen_manifest, &mut parsed_req);
    assert(resp_parsed.status == 200, "6. Expected 200 OK for parsed HTTP request");
    assert(str_contains(resp_parsed.body.as_str(), "Active Tab: telemetry"), "6. Body must contain 'Active Tab: telemetry'");

    // 7. HEAD request on query-accepting route preserves status 200, empty body, Content-Length matching GET body
    let mut req_head_shop = make_request("HEAD", "/shop", "sort=price_asc", make_header_map(), "");
    let resp_head_shop = server::dispatch_request_with_manifest(&gen_manifest, &mut req_head_shop);
    assert(resp_head_shop.status == 200, "7. Expected 200 OK for HEAD /shop?sort=price_asc");
    assert(resp_head_shop.body.len_bytes() == 0, "7. HEAD body must be suppressed (0 bytes)");
    let head_cl = resp_head_shop.headers.get("content-length");
    assert(head_cl.is_some(), "7. Expected Content-Length header for HEAD response");

    // 8. Wire formatting check for query route response
    let wire_shop_sort = to_wire_format(&resp_shop_sort);
    assert(str_contains(wire_shop_sort.as_str(), "HTTP/1.1 200 OK"), "8. Wire format must contain 'HTTP/1.1 200 OK'");
    assert(str_contains(wire_shop_sort.as_str(), "Content-Type: text/html; charset=utf-8"), "8. Wire format must contain Content-Type");

    print_str("OK\n");
}


fn test_security_hardening_and_vulnerability_remediation() {
    print_str("[28/28] Testing Security Hardening & Vulnerability Remediation (1-8)... ");

    let gen_manifest = generated_routes::build_generated_manifest();

    // 1. escape_html correctly escapes HTML special characters (<, >, &, ", ')
    let dangerous_html = "<script>alert('xss' & \"attack\");</script>";
    let escaped_html = escape_html(dangerous_html);
    assert(str_contains(escaped_html.as_str(), "&lt;script&gt;"), "1. <script> must be escaped to &lt;script&gt;");
    assert(str_contains(escaped_html.as_str(), "&#39;xss&#39;"), "1. Single quote must be escaped to &#39;");
    assert(str_contains(escaped_html.as_str(), "&quot;attack&quot;"), "1. Double quote must be escaped to &quot;");
    assert(str_contains(escaped_html.as_str(), "&amp;"), "1. Ampersand must be escaped to &amp;");
    assert(!str_contains(escaped_html.as_str(), "<script>"), "1. Raw <script> must not exist in output");

    // 2. escape_html safely preserves multi-byte UTF-8 sequences (international characters & emoji)
    let unicode_text = "Venta ⚡ Rust 🦀 — München & São Paulo";
    let escaped_unicode = escape_html(unicode_text);
    assert(str_contains(escaped_unicode.as_str(), "⚡"), "2. 3-byte lightning emoji must be preserved");
    assert(str_contains(escaped_unicode.as_str(), "🦀"), "2. 4-byte crab emoji must be preserved");
    assert(str_contains(escaped_unicode.as_str(), "ünchen"), "2. 2-byte umlaut must be preserved");
    assert(str_contains(escaped_unicode.as_str(), "São"), "2. 2-byte tilde must be preserved");
    assert(str_contains(escaped_unicode.as_str(), "&amp;"), "2. Ampersand inside Unicode string must be escaped");

    // 3. escape_json escapes quotes, backslashes, newlines, and control characters
    let dangerous_json = "hello \"world\"\npath\\to\\file\tvalue\r\n";
    let escaped_j = escape_json(dangerous_json);
    assert(str_contains(escaped_j.as_str(), "\\\"world\\\""), "3. Double quotes must be escaped with backslash");
    assert(str_contains(escaped_j.as_str(), "\\\\to\\\\"), "3. Backslashes must be escaped with double backslash");
    assert(str_contains(escaped_j.as_str(), "\\n"), "3. Newline must be escaped as \\n");
    assert(str_contains(escaped_j.as_str(), "\\t"), "3. Tab must be escaped as \\t");
    assert(str_contains(escaped_j.as_str(), "\\r"), "3. Carriage return must be escaped as \\r");

    // 4. set_cookie sanitizes semicolons and CRLF to prevent cookie attribute injection
    let mut resp_cookie = response_html("OK");
    set_cookie(&mut resp_cookie, "session", "abc123; Domain=evil.com; SameSite=None", "/; Path=/evil", 3600, true, true, "Lax; evil");
    let set_cookie_hdr = resp_cookie.headers.get("set-cookie");
    match set_cookie_hdr {
        Option::Some(cookie_val) => {
            assert(!str_contains(cookie_val.as_str(), "; Domain=evil.com"), "4. Injected Domain attribute must be stripped");
            assert(str_contains(cookie_val.as_str(), "session=abc123 Domain=evil.com SameSite=None"), "4. Semicolon stripped cleanly from cookie value");
        }
        Option::None => {
            assert(false, "4. Expected Set-Cookie header");
        }
    }

    // 5. normalize_request_path rejects backslashes and null bytes
    let bs_res = normalize_request_path("/foo\\..\\bar");
    assert(bs_res.is_err(), "5. Path with backslash must be rejected");

    // 6. normalize_request_path rejects percent-encoded dot segments (%2e%2e, %2e)
    let enc_dot_res = normalize_request_path("/foo/%2e%2e/bar");
    assert(enc_dot_res.is_err(), "6. Path with %2e%2e must be rejected");

    let enc_single_dot = normalize_request_path("/foo/%2e/bar");
    assert(enc_single_dot.is_err(), "6. Path with %2e must be rejected");

    // 7. 404 response sanitizes unmapped path containing <script> payload
    let mut req_404_xss = make_request("GET", "/nonexistent/<script>alert(1)</script>", "", make_header_map(), "");
    let resp_404_xss = server::dispatch_request_with_manifest(&gen_manifest, &mut req_404_xss);
    assert(resp_404_xss.status == 404, "7. Expected 404 Not Found");
    assert(!str_contains(resp_404_xss.body.as_str(), "<script>alert(1)</script>"), "7. 404 body must NOT contain raw script tag");
    assert(str_contains(resp_404_xss.body.as_str(), "&lt;script&gt;alert(1)&lt;/script&gt;"), "7. 404 body must contain escaped script tag");

    // 8. Truncated HTTP request line does not corrupt parser or panic
    let truncated_http = "GET /dashboard HTTP/1.1";
    let req_trunc = parse_http_request(truncated_http);
    assert(req_trunc.method.as_str().equals("GET"), "8. Truncated request line method parsed correctly");
    assert(req_trunc.path.as_str().equals("/dashboard"), "8. Truncated request line path parsed correctly");
    assert(req_trunc.headers.entries.len() == 0, "8. Truncated request line must not parse request line as headers");

    print_str("OK\n");
}

fn test_file_icon_asset_serving() {
    print_str("[29/29] Testing Official 3D Gold Lightning File Icon Asset Serving (1-6)... ");

    let gen_manifest = generated_routes::build_generated_manifest();

    // 1. GET /vanta-file-icon.svg returns 200 OK with SVG content type
    let mut req_svg = make_request("GET", "/vanta-file-icon.svg", "", make_header_map(), "");
    let resp_svg = server::dispatch_request_with_manifest(&gen_manifest, &mut req_svg);
    assert(resp_svg.status == 200, "1. Expected 200 OK for GET /vanta-file-icon.svg");
    assert(resp_svg.content_type.as_str().equals("image/svg+xml; charset=utf-8"), "1. Content-Type must be image/svg+xml; charset=utf-8");
    let wire_svg = to_wire_format(&resp_svg);
    assert(str_contains(wire_svg.as_str(), "Content-Type: image/svg+xml; charset=utf-8"), "1. Wire format must contain Content-Type image/svg+xml");

    // 2. Icon body contains valid SVG tags and gold gradient definitions
    assert(str_contains(resp_svg.body.as_str(), "<svg"), "2. Body must contain <svg tag");
    assert(str_contains(resp_svg.body.as_str(), "vanta-glow"), "2. Body must contain vanta-glow filter");
    assert(str_contains(resp_svg.body.as_str(), "vanta-lit"), "2. Body must contain vanta-lit gradient");

    // 3. Cache-Control and ETag headers are present
    let cc = resp_svg.headers.get("cache-control");
    assert(cc.is_some(), "3. Expected Cache-Control header");
    let etag = resp_svg.headers.get("etag");
    assert(etag.is_some(), "3. Expected ETag header");

    // 4. GET /venta-file-icon.svg also serves the icon
    let mut req_venta = make_request("GET", "/venta-file-icon.svg", "", make_header_map(), "");
    let resp_venta = server::dispatch_request_with_manifest(&gen_manifest, &mut req_venta);
    assert(resp_venta.status == 200, "4. Expected 200 OK for GET /venta-file-icon.svg");
    assert(str_contains(resp_venta.body.as_str(), "<svg"), "4. /venta-file-icon.svg body must contain <svg");

    // 5. POST /vanta-file-icon.svg returns 405 Method Not Allowed with Allow header
    let mut req_post = make_request("POST", "/vanta-file-icon.svg", "", make_header_map(), "");
    let resp_post = server::dispatch_request_with_manifest(&gen_manifest, &mut req_post);
    assert(resp_post.status == 405, "5. Expected 405 for POST /vanta-file-icon.svg");
    let allow = resp_post.headers.get("allow");
    assert(allow.is_some(), "5. Expected Allow header on 405");
    match allow {
        Option::Some(a) => {
            assert(str_contains(a.as_str(), "GET"), "5. Allow must contain GET");
            assert(str_contains(a.as_str(), "HEAD"), "5. Allow must contain HEAD");
        }
        Option::None => {}
    }

    // 6. Conditional Request: If-None-Match with matching ETag returns 304 Not Modified
    match etag {
        Option::Some(tag_val) => {
            let mut headers_inm = make_header_map();
            headers_inm.add("if-none-match", tag_val.as_str());
            let mut req_inm = make_request("GET", "/vanta-file-icon.svg", "", headers_inm, "");
            let resp_inm = server::dispatch_request_with_manifest(&gen_manifest, &mut req_inm);
            assert(resp_inm.status == 304, "6. Expected 304 Not Modified when ETag matches");
            assert(resp_inm.body.len_bytes() == 0, "6. 304 response body must be empty");
        }
        Option::None => {}
    }

    print_str("OK\n");
}
