{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vanta",
  "scopeName": "source.vanta",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vanta",
          "match": "//.*$"
        },
        {
          "name": "comment.block.vanta",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vanta",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vanta",
              "match": "\\\\([nrt\\\\\"'0]|x[0-9a-fA-F]{2})"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vanta",
          "match": "\\b(if|else|while|for|in|return|match)\\b"
        },
        {
          "name": "keyword.declaration.vanta",
          "match": "\\b(fn|let|mut|struct|enum|impl|trait|mod|import|pub)\\b"
        },
        {
          "name": "keyword.other.vanta",
          "match": "\\b(panic)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.vanta",
          "match": "\\b(i64|bool|str)\\b"
        },
        {
          "name": "storage.type.standard.vanta",
          "match": "\\b(String|Option|Result|Vec|Self)\\b"
        },
        {
          "name": "storage.modifier.lifetime.vanta",
          "match": "'[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.vanta",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.option.vanta",
          "match": "\\b(Some|None|Ok|Err)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.vanta" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.vanta",
          "match": "(->|==|!=|<=|>=|&&|\\|\\||\\+|-|\\*|/|%|<|>|=|&|\\||\\^|!)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.vanta",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.vanta",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.decimal.vanta",
          "match": "\\b[0-9]+\\b"
        }
      ]
    }
  }
}
