{
  "name": "venta-vscode",
  "displayName": "Venta Language Support",
  "description": "Official syntax highlighting, bracket matching, and editor support for the Venta Systems Programming Language",
  "version": "1.0.0",
  "publisher": "venta-lang",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "venta",
    "vanta",
    "systems-programming",
    "compiler"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Looka-info/Venta.git"
  },
  "icon": "./icons/venta-logo-512.png",
  "contributes": {
    "languages": [
      {
        "id": "venta",
        "aliases": [
          "Venta",
          "venta",
          "Vanta",
          "vanta"
        ],
        "extensions": [
          ".va",
          ".venta",
          ".vanta"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/venta-file-icon-light.svg",
          "dark": "./icons/venta-file-icon-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "venta",
        "scopeName": "source.va",
        "path": "./syntaxes/venta.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "venta-icons",
        "label": "Venta File Icons",
        "path": "./icons/venta-icon-theme.json"
      }
    ]
  }
}
