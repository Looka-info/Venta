// Sample Vanta program for GitHub Linguist grammar verification

import std::io;
import std::string::String;

pub struct Point {
    pub x: i64,
    pub y: i64,
}

impl Point {
    pub fn translate(self: &mut Self, dx: i64, dy: i64) {
        self.x = self.x + dx;
        self.y = self.y + dy;
    }

    pub fn manhattan(self: &Self) -> i64 {
        self.x + self.y
    }
}

pub fn main() -> i64 {
    let mut pt = Point { x: 10, y: 20 };
    pt.translate(5, 7);
    let dist = pt.manhattan();
    return dist;
}
