// ============================================================================
// ⚡ Venta Web Page Root Module (100% Pure Venta)
// Composes the showcase web page matching the official design specification
// ============================================================================

import std::string::String;
import dom::{Element, div, main_elem};
import styles::get_showcase_styles;
import scripts::get_client_scripts;
import components::{
    render_nav,
    render_hero,
    render_statement,
    render_marquee,
    render_horizontal_track,
    render_code_section,
    render_benchmarks,
    render_pipeline,
    render_optimizer,
    render_ecosystem,
    render_start_steps,
    render_footer
};

pub fn render_showcase_document() -> String {
    let mut doc = String::from_str("<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n");
    doc.push_str("    <meta charset=\"utf-8\">\n");
    doc.push_str("    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n");
    doc.push_str("    <title>Venta: a systems language that compiles in 0.24 seconds</title>\n");
    doc.push_str("    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n");
    doc.push_str("    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n");
    doc.push_str("    <link href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;800&family=Geist+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n");

    // Inject exact CSS styling from styles.va
    let css = get_showcase_styles();
    doc.push_str(css.as_str());

    doc.push_str("</head>\n<body>\n");

    // 1. Navigation
    let nav_el = render_nav();
    let nav_str = nav_el.render();
    doc.push_str(nav_str.as_str());

    // 2. Hero Header
    let hero = render_hero();
    let hero_str = hero.render();
    doc.push_str(hero_str.as_str());

    // 3. Statement Pinned Section
    let stmt = render_statement();
    let stmt_str = stmt.render();
    doc.push_str(stmt_str.as_str());

    // 4. Marquee Banner
    let mq = render_marquee();
    let mq_str = mq.render();
    doc.push_str(mq_str.as_str());

    // 5. Horizontal Scroll Track
    let hs = render_horizontal_track();
    let hs_str = hs.render();
    doc.push_str(hs_str.as_str());

    // 6. Code Mistakes Section
    let code_sec = render_code_section();
    let code_str = code_sec.render();
    doc.push_str(code_str.as_str());

    // 7. Benchmarks & Workload Explorer
    let bench = render_benchmarks();
    let bench_str = bench.render();
    doc.push_str(bench_str.as_str());

    // 8. Pipeline Pinned Section
    let pipe = render_pipeline();
    let pipe_str = pipe.render();
    doc.push_str(pipe_str.as_str());

    // 9. 14-Pass Optimizer Grid
    let opt = render_optimizer();
    let opt_str = opt.render();
    doc.push_str(opt_str.as_str());

    // 10. Ecosystem Cards
    let eco = render_ecosystem();
    let eco_str = eco.render();
    doc.push_str(eco_str.as_str());

    // 11. Start Steps
    let start = render_start_steps();
    let start_str = start.render();
    doc.push_str(start_str.as_str());

    // 12. Footer
    let footer_el = render_footer();
    let footer_str = footer_el.render();
    doc.push_str(footer_str.as_str());

    // Scripts: GSAP 3.12+, ScrollTrigger, Lenis, Tabs & Interactivity
    let js = get_client_scripts();
    doc.push_str(js.as_str());

    doc.push_str("</body>\n</html>\n");
    doc
}
