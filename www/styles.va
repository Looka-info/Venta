// ============================================================================
// ⚡ Venta Web Stylesheet Module (in Pure Venta)
// Awwwards-Level Luxury Obsidian & 24K Gold Design Tokens & CSS
// ============================================================================

import std::string::String;

pub fn get_luxury_styles() -> String {
    let mut s = String::from_str("<style>\n");
    s.push_str("/* ==========================================================================\n");
    s.push_str("           1. LUXURY DARK BRAND DESIGN SYSTEM (Obsidian & 24K Gold)\n");
    s.push_str("           ========================================================================== */\n");
    s.push_str("        :root {\n");
    s.push_str("            --bg-void: #050507;\n");
    s.push_str("            --bg-base: #09090d;\n");
    s.push_str("            --bg-surface: #0f1017;\n");
    s.push_str("            --bg-card: #141520;\n");
    s.push_str("            --bg-card-hover: #191b2a;\n");
    s.push_str("            --border-subtle: rgba(255, 255, 255, 0.07);\n");
    s.push_str("            --border-gold: rgba(255, 215, 0, 0.25);\n");
    s.push_str("            --border-gold-glow: rgba(255, 215, 0, 0.5);\n");
    s.push_str("\n");
    s.push_str("            --gold-core: #ffd700;\n");
    s.push_str("            --gold-bright: #ffe642;\n");
    s.push_str("            --gold-glow: rgba(255, 215, 0, 0.35);\n");
    s.push_str("            --amber-warm: #ff9f1c;\n");
    s.push_str("            --amber-deep: #e07a00;\n");
    s.push_str("            \n");
    s.push_str("            --text-hero: #ffffff;\n");
    s.push_str("            --text-body: #c9cddb;\n");
    s.push_str("            --text-muted: #7e8499;\n");
    s.push_str("            --cyan-glow: #38bdf8;\n");
    s.push_str("            --green-glow: #10b981;\n");
    s.push_str("            --purple-glow: #a855f7;\n");
    s.push_str("\n");
    s.push_str("            --font-display: 'Syne', sans-serif;\n");
    s.push_str("            --font-body: 'Plus Jakarta Sans', -apple-system, sans-serif;\n");
    s.push_str("            --font-code: 'JetBrains Mono', monospace;\n");
    s.push_str("\n");
    s.push_str("            --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        * {\n");
    s.push_str("            box-sizing: border-box;\n");
    s.push_str("            margin: 0;\n");
    s.push_str("            padding: 0;\n");
    s.push_str("            cursor: default;\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        html {\n");
    s.push_str("            scroll-behavior: smooth;\n");
    s.push_str("            background: var(--bg-void);\n");
    s.push_str("            color: var(--text-body);\n");
    s.push_str("            font-family: var(--font-body);\n");
    s.push_str("            line-height: 1.6;\n");
    s.push_str("            overflow-x: hidden;\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        body {\n");
    s.push_str("            position: relative;\n");
    s.push_str("            min-height: 100vh;\n");
    s.push_str("            background: var(--bg-void);\n");
    s.push_str("            overflow-x: hidden;\n");
    s.push_str("            -webkit-font-smoothing: antialiased;\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        /* Ambient Noise & Canvas Background */\n");
    s.push_str("        #bg-canvas {\n");
    s.push_str("            position: fixed;\n");
    s.push_str("            top: 0;\n");
    s.push_str("            left: 0;\n");
    s.push_str("            width: 100vw;\n");
    s.push_str("            height: 100vh;\n");
    s.push_str("            pointer-events: none;\n");
    s.push_str("            z-index: 0;\n");
    s.push_str("            opacity: 0.65;\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        .ambient-glow {\n");
    s.push_str("            position: fixed;\n");
    s.push_str("            border-radius: 50%;\n");
    s.push_str("            filter: blur(140px);\n");
    s.push_str("            pointer-events: none;\n");
    s.push_str("            z-index: 0;\n");
    s.push_str("            opacity: 0.22;\n");
    s.push_str("        }\n");
    s.push_str("        .glow-1 {\n");
    s.push_str("            top: -150px;\n");
    s.push_str("            left: 50%;\n");
    s.push_str("            transform: translateX(-50%);\n");
    s.push_str("            width: 750px;\n");
    s.push_str("            height: 500px;\n");
    s.push_str("            background: radial-gradient(circle, var(--gold-core), var(--amber-warm), transparent 70%);\n");
    s.push_str("        }\n");
    s.push_str("        .glow-2 {\n");
    s.push_str("            top: 40%;\n");
    s.push_str("            left: -150px;\n");
    s.push_str("            width: 500px;\n");
    s.push_str("            height: 500px;\n");
    s.push_str("            background: radial-gradient(circle, var(--amber-warm), transparent 70%);\n");
    s.push_str("        }\n");
    s.push_str("        .glow-3 {\n");
    s.push_str("            bottom: 10%;\n");
    s.push_str("            right: -150px;\n");
    s.push_str("            width: 600px;\n");
    s.push_str("            height: 600px;\n");
    s.push_str("            background: radial-gradient(circle, var(--gold-core), transparent 70%);\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        /* Custom Trailing Gold Cursor */\n");
    s.push_str("        .custom-cursor {\n");
    s.push_str("            position: fixed;\n");
    s.push_str("            top: 0;\n");
    s.push_str("            left: 0;\n");
    s.push_str("            width: 8px;\n");
    s.push_str("            height: 8px;\n");
    s.push_str("            background: var(--gold-core);\n");
    s.push_str("            border-radius: 50%;\n");
    s.push_str("            pointer-events: none;\n");
    s.push_str("            z-index: 9999;\n");
    s.push_str("            transform: translate(-50%, -50%);\n");
    s.push_str("            transition: transform 0.08s ease-out, opacity 0.2s;\n");
    s.push_str("            box-shadow: 0 0 12px var(--gold-core);\n");
    s.push_str("        }\n");
    s.push_str("        .cursor-follower {\n");
    s.push_str("            position: fixed;\n");
    s.push_str("            top: 0;\n");
    s.push_str("            left: 0;\n");
    s.push_str("            width: 40px;\n");
    s.push_str("            height: 40px;\n");
    s.push_str("            border: 1px solid rgba(255, 215, 0, 0.45);\n");
    s.push_str("            background: radial-gradient(circle, rgba(255, 215, 0, 0.12), transparent 70%);\n");
    s.push_str("            border-radius: 50%;\n");
    s.push_str("            pointer-events: none;\n");
    s.push_str("            z-index: 9998;\n");
    s.push_str("            transform: translate(-50%, -50%);\n");
    s.push_str("            transition: width 0.3s var(--ease-out-expo), height 0.3s var(--ease-out-expo), border-color 0.3s;\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        a, button, input, select, .interactive-item {\n");
    s.push_str("            cursor: pointer;\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        /* Container */\n");
    s.push_str("        .container {\n");
    s.push_str("            max-width: 1280px;\n");
    s.push_str("            margin: 0 auto;\n");
    s.push_str("            padding: 0 24px;\n");
    s.push_str("            position: relative;\n");
    s.push_str("            z-index: 1;\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        /* ==========================================================================\n");
    s.push_str("           2. GLASSMORPHIC FLOATING NAVBAR\n");
    s.push_str("           ========================================================================== */\n");
    s.push_str("        .nav-wrapper {\n");
    s.push_str("            position: fixed;\n");
    s.push_str("            top: 20px;\n");
    s.push_str("            left: 0;\n");
    s.push_str("            width: 100%;\n");
    s.push_str("            z-index: 1000;\n");
    s.push_str("            display: flex;\n");
    s.push_str("            justify-content: center;\n");
    s.push_str("            padding: 0 24px;\n");
    s.push_str("        }\n");
    s.push_str("        .nav-pill {\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            justify-content: space-between;\n");
    s.push_str("            gap: 28px;\n");
    s.push_str("            background: rgba(15, 16, 23, 0.82);\n");
    s.push_str("            backdrop-filter: blur(24px) saturate(180%);\n");
    s.push_str("            border: 1px solid var(--border-gold);\n");
    s.push_str("            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6), 0 0 25px rgba(255, 215, 0, 0.08);\n");
    s.push_str("            border-radius: 9999px;\n");
    s.push_str("            padding: 8px 18px 8px 24px;\n");
    s.push_str("            max-width: 1060px;\n");
    s.push_str("            width: 100%;\n");
    s.push_str("            transition: border-color 0.3s, box-shadow 0.3s;\n");
    s.push_str("        }\n");
    s.push_str("        .nav-pill:hover {\n");
    s.push_str("            border-color: rgba(255, 215, 0, 0.45);\n");
    s.push_str("            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7), 0 0 35px rgba(255, 215, 0, 0.15);\n");
    s.push_str("        }\n");
    s.push_str("        .nav-brand {\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            gap: 12px;\n");
    s.push_str("            text-decoration: none;\n");
    s.push_str("            color: var(--text-hero);\n");
    s.push_str("            font-family: var(--font-display);\n");
    s.push_str("            font-weight: 800;\n");
    s.push_str("            font-size: 1.35rem;\n");
    s.push_str("            letter-spacing: -0.5px;\n");
    s.push_str("        }\n");
    s.push_str("        .nav-brand img {\n");
    s.push_str("            width: 26px;\n");
    s.push_str("            height: 26px;\n");
    s.push_str("            filter: drop-shadow(0 0 8px rgba(255, 215, 0, 0.8));\n");
    s.push_str("            transition: transform 0.3s var(--ease-out-expo);\n");
    s.push_str("        }\n");
    s.push_str("        .nav-brand:hover img {\n");
    s.push_str("            transform: scale(1.15) rotate(-5deg);\n");
    s.push_str("        }\n");
    s.push_str("        .nav-brand span {\n");
    s.push_str("            background: linear-gradient(135deg, #ffffff 40%, var(--gold-core) 100%);\n");
    s.push_str("            -webkit-background-clip: text;\n");
    s.push_str("            -webkit-text-fill-color: transparent;\n");
    s.push_str("        }\n");
    s.push_str("        .nav-links {\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            gap: 22px;\n");
    s.push_str("            list-style: none;\n");
    s.push_str("        }\n");
    s.push_str("        .nav-link {\n");
    s.push_str("            color: var(--text-muted);\n");
    s.push_str("            text-decoration: none;\n");
    s.push_str("            font-size: 0.9rem;\n");
    s.push_str("            font-weight: 500;\n");
    s.push_str("            transition: color 0.2s, transform 0.2s;\n");
    s.push_str("            position: relative;\n");
    s.push_str("        }\n");
    s.push_str("        .nav-link:hover {\n");
    s.push_str("            color: var(--text-hero);\n");
    s.push_str("            transform: translateY(-1px);\n");
    s.push_str("        }\n");
    s.push_str("        .nav-link::after {\n");
    s.push_str("            content: '';\n");
    s.push_str("            position: absolute;\n");
    s.push_str("            bottom: -4px;\n");
    s.push_str("            left: 0;\n");
    s.push_str("            width: 0;\n");
    s.push_str("            height: 2px;\n");
    s.push_str("            background: var(--gold-core);\n");
    s.push_str("            transition: width 0.25s var(--ease-out-expo);\n");
    s.push_str("            border-radius: 2px;\n");
    s.push_str("        }\n");
    s.push_str("        .nav-link:hover::after {\n");
    s.push_str("            width: 100%;\n");
    s.push_str("        }\n");
    s.push_str("        .nav-actions {\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            gap: 14px;\n");
    s.push_str("        }\n");
    s.push_str("        .version-badge {\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            gap: 6px;\n");
    s.push_str("            background: rgba(255, 215, 0, 0.1);\n");
    s.push_str("            border: 1px solid rgba(255, 215, 0, 0.3);\n");
    s.push_str("            color: var(--gold-bright);\n");
    s.push_str("            font-family: var(--font-code);\n");
    s.push_str("            font-size: 0.75rem;\n");
    s.push_str("            font-weight: 600;\n");
    s.push_str("            padding: 4px 10px;\n");
    s.push_str("            border-radius: 9999px;\n");
    s.push_str("        }\n");
    s.push_str("        .pulse-dot {\n");
    s.push_str("            width: 6px;\n");
    s.push_str("            height: 6px;\n");
    s.push_str("            background: var(--gold-core);\n");
    s.push_str("            border-radius: 50%;\n");
    s.push_str("            box-shadow: 0 0 8px var(--gold-core);\n");
    s.push_str("            animation: pulse-anim 2s infinite;\n");
    s.push_str("        }\n");
    s.push_str("        @keyframes pulse-anim {\n");
    s.push_str("            0% { transform: scale(0.95); opacity: 0.8; }\n");
    s.push_str("            50% { transform: scale(1.4); opacity: 1; }\n");
    s.push_str("            100% { transform: scale(0.95); opacity: 0.8; }\n");
    s.push_str("        }\n");
    s.push_str("        .btn-magnetic {\n");
    s.push_str("            background: linear-gradient(135deg, var(--gold-core), var(--amber-warm));\n");
    s.push_str("            color: #000;\n");
    s.push_str("            text-decoration: none;\n");
    s.push_str("            font-weight: 700;\n");
    s.push_str("            font-size: 0.85rem;\n");
    s.push_str("            padding: 8px 18px;\n");
    s.push_str("            border-radius: 9999px;\n");
    s.push_str("            box-shadow: 0 4px 18px rgba(255, 215, 0, 0.35);\n");
    s.push_str("            transition: transform 0.25s var(--ease-out-expo), box-shadow 0.25s, filter 0.25s;\n");
    s.push_str("            display: inline-flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            gap: 6px;\n");
    s.push_str("            border: none;\n");
    s.push_str("        }\n");
    s.push_str("        .btn-magnetic:hover {\n");
    s.push_str("            transform: translateY(-2px) scale(1.03);\n");
    s.push_str("            box-shadow: 0 8px 25px rgba(255, 215, 0, 0.55);\n");
    s.push_str("            filter: brightness(1.1);\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        /* ==========================================================================\n");
    s.push_str("           3. HERO SECTION (Awwwards Centerpiece)\n");
    s.push_str("           ========================================================================== */\n");
    s.push_str("        .hero {\n");
    s.push_str("            padding: 170px 0 90px;\n");
    s.push_str("            text-align: center;\n");
    s.push_str("            position: relative;\n");
    s.push_str("        }\n");
    s.push_str("        .hero-eyebrow {\n");
    s.push_str("            display: inline-flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            gap: 10px;\n");
    s.push_str("            background: rgba(20, 21, 32, 0.85);\n");
    s.push_str("            backdrop-filter: blur(12px);\n");
    s.push_str("            border: 1px solid var(--border-gold);\n");
    s.push_str("            padding: 6px 18px;\n");
    s.push_str("            border-radius: 9999px;\n");
    s.push_str("            font-size: 0.85rem;\n");
    s.push_str("            font-weight: 600;\n");
    s.push_str("            color: var(--text-body);\n");
    s.push_str("            margin-bottom: 28px;\n");
    s.push_str("            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);\n");
    s.push_str("            transform: translateY(20px);\n");
    s.push_str("            opacity: 0;\n");
    s.push_str("        }\n");
    s.push_str("        .hero-eyebrow img {\n");
    s.push_str("            width: 14px;\n");
    s.push_str("            height: 14px;\n");
    s.push_str("            filter: drop-shadow(0 0 6px var(--gold-core));\n");
    s.push_str("        }\n");
    s.push_str("        .hero-title {\n");
    s.push_str("            font-family: var(--font-display);\n");
    s.push_str("            font-size: clamp(3.2rem, 7.5vw, 6.8rem);\n");
    s.push_str("            font-weight: 900;\n");
    s.push_str("            line-height: 1.02;\n");
    s.push_str("            letter-spacing: -0.04em;\n");
    s.push_str("            color: var(--text-hero);\n");
    s.push_str("            margin-bottom: 24px;\n");
    s.push_str("            text-transform: uppercase;\n");
    s.push_str("        }\n");
    s.push_str("        .hero-title .kinetic-line {\n");
    s.push_str("            display: block;\n");
    s.push_str("            overflow: hidden;\n");
    s.push_str("        }\n");
    s.push_str("        .hero-title .kinetic-word {\n");
    s.push_str("            display: inline-block;\n");
    s.push_str("            transform: translateY(110%);\n");
    s.push_str("            opacity: 0;\n");
    s.push_str("        }\n");
    s.push_str("        .hero-title .gold-gradient-text {\n");
    s.push_str("            background: linear-gradient(135deg, #ffffff 15%, var(--gold-bright) 55%, var(--amber-warm) 100%);\n");
    s.push_str("            -webkit-background-clip: text;\n");
    s.push_str("            -webkit-text-fill-color: transparent;\n");
    s.push_str("            filter: drop-shadow(0 0 30px rgba(255, 215, 0, 0.25));\n");
    s.push_str("        }\n");
    s.push_str("        .hero-desc {\n");
    s.push_str("            font-size: clamp(1.05rem, 2vw, 1.3rem);\n");
    s.push_str("            color: var(--text-muted);\n");
    s.push_str("            max-width: 760px;\n");
    s.push_str("            margin: 0 auto 40px;\n");
    s.push_str("            font-weight: 400;\n");
    s.push_str("            line-height: 1.65;\n");
    s.push_str("            transform: translateY(20px);\n");
    s.push_str("            opacity: 0;\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        /* 3D Interactive Floating Lightning Mark */\n");
    s.push_str("        .hero-mark-stage {\n");
    s.push_str("            perspective: 1200px;\n");
    s.push_str("            margin: 10px auto 48px;\n");
    s.push_str("            width: 220px;\n");
    s.push_str("            height: 220px;\n");
    s.push_str("            position: relative;\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            justify-content: center;\n");
    s.push_str("        }\n");
    s.push_str("        .hero-mark-card {\n");
    s.push_str("            width: 100%;\n");
    s.push_str("            height: 100%;\n");
    s.push_str("            position: relative;\n");
    s.push_str("            transform-style: preserve-3d;\n");
    s.push_str("            transition: transform 0.15s ease-out;\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            justify-content: center;\n");
    s.push_str("        }\n");
    s.push_str("        .hero-bolt-img {\n");
    s.push_str("            width: 160px;\n");
    s.push_str("            height: 160px;\n");
    s.push_str("            filter: drop-shadow(0 0 55px rgba(255, 215, 0, 0.65)) drop-shadow(0 0 100px rgba(255, 159, 28, 0.35));\n");
    s.push_str("            transform: translateZ(50px);\n");
    s.push_str("            animation: bolt-float 4s ease-in-out infinite;\n");
    s.push_str("        }\n");
    s.push_str("        @keyframes bolt-float {\n");
    s.push_str("            0% { transform: translateZ(50px) translateY(0) rotate(0deg); }\n");
    s.push_str("            50% { transform: translateZ(50px) translateY(-12px) rotate(1.5deg); }\n");
    s.push_str("            100% { transform: translateZ(50px) translateY(0) rotate(0deg); }\n");
    s.push_str("        }\n");
    s.push_str("        .mark-badge-float {\n");
    s.push_str("            position: absolute;\n");
    s.push_str("            background: rgba(15, 16, 23, 0.9);\n");
    s.push_str("            backdrop-filter: blur(16px);\n");
    s.push_str("            border: 1px solid var(--border-gold);\n");
    s.push_str("            padding: 8px 14px;\n");
    s.push_str("            border-radius: 12px;\n");
    s.push_str("            font-family: var(--font-code);\n");
    s.push_str("            font-size: 0.78rem;\n");
    s.push_str("            color: var(--gold-bright);\n");
    s.push_str("            white-space: nowrap;\n");
    s.push_str("            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.6);\n");
    s.push_str("            transform: translateZ(75px);\n");
    s.push_str("            pointer-events: none;\n");
    s.push_str("        }\n");
    s.push_str("        .mark-badge-left {\n");
    s.push_str("            top: 25px;\n");
    s.push_str("            left: -80px;\n");
    s.push_str("        }\n");
    s.push_str("        .mark-badge-right {\n");
    s.push_str("            bottom: 25px;\n");
    s.push_str("            right: -80px;\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        /* Hero Installer Tab Bar */\n");
    s.push_str("        .hero-install-box {\n");
    s.push_str("            max-width: 580px;\n");
    s.push_str("            margin: 0 auto 50px;\n");
    s.push_str("            background: rgba(15, 16, 23, 0.9);\n");
    s.push_str("            backdrop-filter: blur(20px);\n");
    s.push_str("            border: 1px solid var(--border-gold);\n");
    s.push_str("            border-radius: 16px;\n");
    s.push_str("            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7), 0 0 30px rgba(255, 215, 0, 0.1);\n");
    s.push_str("            overflow: hidden;\n");
    s.push_str("            transform: translateY(20px);\n");
    s.push_str("            opacity: 0;\n");
    s.push_str("        }\n");
    s.push_str("        .install-nav {\n");
    s.push_str("            display: flex;\n");
    s.push_str("            background: rgba(10, 11, 16, 0.95);\n");
    s.push_str("            border-bottom: 1px solid var(--border-subtle);\n");
    s.push_str("            padding: 6px;\n");
    s.push_str("            gap: 6px;\n");
    s.push_str("        }\n");
    s.push_str("        .install-tab-btn {\n");
    s.push_str("            flex: 1;\n");
    s.push_str("            padding: 8px 14px;\n");
    s.push_str("            background: transparent;\n");
    s.push_str("            border: none;\n");
    s.push_str("            color: var(--text-muted);\n");
    s.push_str("            font-family: var(--font-code);\n");
    s.push_str("            font-size: 0.8rem;\n");
    s.push_str("            font-weight: 600;\n");
    s.push_str("            border-radius: 8px;\n");
    s.push_str("            transition: all 0.2s;\n");
    s.push_str("        }\n");
    s.push_str("        .install-tab-btn.active {\n");
    s.push_str("            background: var(--bg-card);\n");
    s.push_str("            color: var(--gold-bright);\n");
    s.push_str("            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);\n");
    s.push_str("        }\n");
    s.push_str("        .install-cmd-row {\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            justify-content: space-between;\n");
    s.push_str("            padding: 16px 20px;\n");
    s.push_str("            font-family: var(--font-code);\n");
    s.push_str("            font-size: 0.92rem;\n");
    s.push_str("            color: #f3f4f6;\n");
    s.push_str("        }\n");
    s.push_str("        .install-cmd-row .dollar {\n");
    s.push_str("            color: var(--gold-core);\n");
    s.push_str("            margin-right: 10px;\n");
    s.push_str("            user-select: none;\n");
    s.push_str("        }\n");
    s.push_str("        .btn-copy {\n");
    s.push_str("            background: rgba(255, 215, 0, 0.12);\n");
    s.push_str("            border: 1px solid rgba(255, 215, 0, 0.35);\n");
    s.push_str("            color: var(--gold-bright);\n");
    s.push_str("            font-family: var(--font-code);\n");
    s.push_str("            font-size: 0.78rem;\n");
    s.push_str("            font-weight: 600;\n");
    s.push_str("            padding: 6px 14px;\n");
    s.push_str("            border-radius: 8px;\n");
    s.push_str("            transition: all 0.2s;\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            gap: 6px;\n");
    s.push_str("        }\n");
    s.push_str("        .btn-copy:hover {\n");
    s.push_str("            background: var(--gold-core);\n");
    s.push_str("            color: #000;\n");
    s.push_str("            box-shadow: 0 0 15px var(--gold-glow);\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        /* Hero Stat Counters Ribbon */\n");
    s.push_str("        .stat-ribbon {\n");
    s.push_str("            display: grid;\n");
    s.push_str("            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n");
    s.push_str("            gap: 20px;\n");
    s.push_str("            max-width: 1100px;\n");
    s.push_str("            margin: 0 auto;\n");
    s.push_str("        }\n");
    s.push_str("        .stat-card {\n");
    s.push_str("            background: rgba(20, 21, 32, 0.65);\n");
    s.push_str("            backdrop-filter: blur(16px);\n");
    s.push_str("            border: 1px solid var(--border-subtle);\n");
    s.push_str("            border-radius: 18px;\n");
    s.push_str("            padding: 24px 20px;\n");
    s.push_str("            text-align: center;\n");
    s.push_str("            transition: transform 0.3s var(--ease-out-expo), border-color 0.3s;\n");
    s.push_str("            position: relative;\n");
    s.push_str("            overflow: hidden;\n");
    s.push_str("        }\n");
    s.push_str("        .stat-card:hover {\n");
    s.push_str("            transform: translateY(-4px);\n");
    s.push_str("            border-color: var(--border-gold);\n");
    s.push_str("            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(255, 215, 0, 0.1);\n");
    s.push_str("        }\n");
    s.push_str("        .stat-number {\n");
    s.push_str("            font-family: var(--font-display);\n");
    s.push_str("            font-size: 2.8rem;\n");
    s.push_str("            font-weight: 900;\n");
    s.push_str("            line-height: 1;\n");
    s.push_str("            margin-bottom: 6px;\n");
    s.push_str("            background: linear-gradient(135deg, #ffffff, var(--gold-core));\n");
    s.push_str("            -webkit-background-clip: text;\n");
    s.push_str("            -webkit-text-fill-color: transparent;\n");
    s.push_str("        }\n");
    s.push_str("        .stat-label {\n");
    s.push_str("            font-size: 0.85rem;\n");
    s.push_str("            color: var(--text-muted);\n");
    s.push_str("            font-weight: 600;\n");
    s.push_str("            text-transform: uppercase;\n");
    s.push_str("            letter-spacing: 0.05em;\n");
    s.push_str("        }\n");
    s.push_str("        .stat-highlight {\n");
    s.push_str("            font-size: 0.75rem;\n");
    s.push_str("            color: var(--gold-bright);\n");
    s.push_str("            margin-top: 4px;\n");
    s.push_str("            font-family: var(--font-code);\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        /* ==========================================================================\n");
    s.push_str("           4. BENTO GRID (Awwwards 3D Spotlight Cards)\n");
    s.push_str("           ========================================================================== */\n");
    s.push_str("        .section {\n");
    s.push_str("            padding: 120px 0;\n");
    s.push_str("            position: relative;\n");
    s.push_str("        }\n");
    s.push_str("        .section-header {\n");
    s.push_str("            text-align: center;\n");
    s.push_str("            max-width: 780px;\n");
    s.push_str("            margin: 0 auto 64px;\n");
    s.push_str("        }\n");
    s.push_str("        .section-tag {\n");
    s.push_str("            display: inline-block;\n");
    s.push_str("            font-family: var(--font-code);\n");
    s.push_str("            font-size: 0.8rem;\n");
    s.push_str("            font-weight: 700;\n");
    s.push_str("            color: var(--gold-bright);\n");
    s.push_str("            text-transform: uppercase;\n");
    s.push_str("            letter-spacing: 0.12em;\n");
    s.push_str("            margin-bottom: 12px;\n");
    s.push_str("        }\n");
    s.push_str("        .section-title {\n");
    s.push_str("            font-family: var(--font-display);\n");
    s.push_str("            font-size: clamp(2.4rem, 4.5vw, 3.8rem);\n");
    s.push_str("            font-weight: 900;\n");
    s.push_str("            color: var(--text-hero);\n");
    s.push_str("            letter-spacing: -0.03em;\n");
    s.push_str("            line-height: 1.1;\n");
    s.push_str("            margin-bottom: 16px;\n");
    s.push_str("        }\n");
    s.push_str("        .section-desc {\n");
    s.push_str("            font-size: 1.15rem;\n");
    s.push_str("            color: var(--text-muted);\n");
    s.push_str("            line-height: 1.6;\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        .bento-grid {\n");
    s.push_str("            display: grid;\n");
    s.push_str("            grid-template-columns: repeat(3, 1fr);\n");
    s.push_str("            gap: 24px;\n");
    s.push_str("        }\n");
    s.push_str("        .bento-card {\n");
    s.push_str("            background: rgba(17, 18, 27, 0.75);\n");
    s.push_str("            backdrop-filter: blur(20px);\n");
    s.push_str("            border: 1px solid var(--border-subtle);\n");
    s.push_str("            border-radius: 24px;\n");
    s.push_str("            padding: 36px;\n");
    s.push_str("            position: relative;\n");
    s.push_str("            overflow: hidden;\n");
    s.push_str("            transform-style: preserve-3d;\n");
    s.push_str("            transition: transform 0.2s var(--ease-out-expo), border-color 0.3s, box-shadow 0.3s;\n");
    s.push_str("        }\n");
    s.push_str("        .bento-card.col-span-2 {\n");
    s.push_str("            grid-column: span 2;\n");
    s.push_str("        }\n");
    s.push_str("        .bento-card::before {\n");
    s.push_str("            content: '';\n");
    s.push_str("            position: absolute;\n");
    s.push_str("            top: var(--spotlight-y, -100%);\n");
    s.push_str("            left: var(--spotlight-x, -100%);\n");
    s.push_str("            width: 350px;\n");
    s.push_str("            height: 350px;\n");
    s.push_str("            background: radial-gradient(circle, rgba(255, 215, 0, 0.15), transparent 70%);\n");
    s.push_str("            transform: translate(-50%, -50%);\n");
    s.push_str("            pointer-events: none;\n");
    s.push_str("            opacity: 0;\n");
    s.push_str("            transition: opacity 0.3s;\n");
    s.push_str("        }\n");
    s.push_str("        .bento-card:hover::before {\n");
    s.push_str("            opacity: 1;\n");
    s.push_str("        }\n");
    s.push_str("        .bento-card:hover {\n");
    s.push_str("            border-color: rgba(255, 215, 0, 0.35);\n");
    s.push_str("            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6), 0 0 30px rgba(255, 215, 0, 0.08);\n");
    s.push_str("        }\n");
    s.push_str("        .bento-icon {\n");
    s.push_str("            width: 52px;\n");
    s.push_str("            height: 52px;\n");
    s.push_str("            background: rgba(255, 215, 0, 0.1);\n");
    s.push_str("            border: 1px solid rgba(255, 215, 0, 0.3);\n");
    s.push_str("            border-radius: 14px;\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            justify-content: center;\n");
    s.push_str("            margin-bottom: 22px;\n");
    s.push_str("            font-size: 1.5rem;\n");
    s.push_str("            color: var(--gold-bright);\n");
    s.push_str("        }\n");
    s.push_str("        .bento-icon img {\n");
    s.push_str("            width: 28px;\n");
    s.push_str("            height: 28px;\n");
    s.push_str("            filter: drop-shadow(0 0 8px var(--gold-core));\n");
    s.push_str("        }\n");
    s.push_str("        .bento-title {\n");
    s.push_str("            font-family: var(--font-display);\n");
    s.push_str("            font-size: 1.45rem;\n");
    s.push_str("            font-weight: 800;\n");
    s.push_str("            color: var(--text-hero);\n");
    s.push_str("            margin-bottom: 12px;\n");
    s.push_str("            letter-spacing: -0.02em;\n");
    s.push_str("        }\n");
    s.push_str("        .bento-text {\n");
    s.push_str("            color: var(--text-muted);\n");
    s.push_str("            font-size: 0.95rem;\n");
    s.push_str("            line-height: 1.6;\n");
    s.push_str("            margin-bottom: 20px;\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        /* 14-Pass Pipeline Pill Stream */\n");
    s.push_str("        .pipeline-stream {\n");
    s.push_str("            display: flex;\n");
    s.push_str("            flex-wrap: wrap;\n");
    s.push_str("            gap: 8px;\n");
    s.push_str("            margin-top: 16px;\n");
    s.push_str("        }\n");
    s.push_str("        .pass-chip {\n");
    s.push_str("            background: rgba(10, 11, 16, 0.9);\n");
    s.push_str("            border: 1px solid rgba(255, 215, 0, 0.25);\n");
    s.push_str("            padding: 6px 12px;\n");
    s.push_str("            border-radius: 8px;\n");
    s.push_str("            font-family: var(--font-code);\n");
    s.push_str("            font-size: 0.76rem;\n");
    s.push_str("            color: var(--gold-bright);\n");
    s.push_str("            display: inline-flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            gap: 6px;\n");
    s.push_str("            transition: all 0.2s;\n");
    s.push_str("        }\n");
    s.push_str("        .pass-chip:hover {\n");
    s.push_str("            background: var(--gold-core);\n");
    s.push_str("            color: #000;\n");
    s.push_str("            transform: scale(1.05);\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        /* ==========================================================================\n");
    s.push_str("           5. INTERACTIVE LIVE CODE STUDIO (VS Code Editor Theme)\n");
    s.push_str("           ========================================================================== */\n");
    s.push_str("        .studio-wrapper {\n");
    s.push_str("            background: #090a10;\n");
    s.push_str("            border: 1px solid var(--border-gold);\n");
    s.push_str("            border-radius: 20px;\n");
    s.push_str("            box-shadow: 0 30px 70px rgba(0, 0, 0, 0.8), 0 0 40px rgba(255, 215, 0, 0.12);\n");
    s.push_str("            overflow: hidden;\n");
    s.push_str("            max-width: 1100px;\n");
    s.push_str("            margin: 0 auto;\n");
    s.push_str("        }\n");
    s.push_str("        .studio-header {\n");
    s.push_str("            background: #0f1017;\n");
    s.push_str("            border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            justify-content: space-between;\n");
    s.push_str("            padding: 0 16px;\n");
    s.push_str("            height: 48px;\n");
    s.push_str("        }\n");
    s.push_str("        .studio-tabs {\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            height: 100%;\n");
    s.push_str("            gap: 2px;\n");
    s.push_str("        }\n");
    s.push_str("        .studio-tab {\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            gap: 8px;\n");
    s.push_str("            padding: 0 18px;\n");
    s.push_str("            height: 100%;\n");
    s.push_str("            background: transparent;\n");
    s.push_str("            border: none;\n");
    s.push_str("            color: var(--text-muted);\n");
    s.push_str("            font-family: var(--font-code);\n");
    s.push_str("            font-size: 0.85rem;\n");
    s.push_str("            font-weight: 500;\n");
    s.push_str("            transition: all 0.2s;\n");
    s.push_str("            border-bottom: 2px solid transparent;\n");
    s.push_str("        }\n");
    s.push_str("        .studio-tab.active {\n");
    s.push_str("            background: #090a10;\n");
    s.push_str("            color: #ffffff;\n");
    s.push_str("            border-bottom: 2px solid var(--gold-core);\n");
    s.push_str("        }\n");
    s.push_str("        .studio-tab img {\n");
    s.push_str("            width: 16px;\n");
    s.push_str("            height: 16px;\n");
    s.push_str("            filter: drop-shadow(0 0 6px var(--gold-core));\n");
    s.push_str("        }\n");
    s.push_str("        .studio-actions {\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            gap: 12px;\n");
    s.push_str("        }\n");
    s.push_str("        .btn-run {\n");
    s.push_str("            background: linear-gradient(135deg, var(--gold-core), var(--amber-warm));\n");
    s.push_str("            color: #000;\n");
    s.push_str("            border: none;\n");
    s.push_str("            padding: 6px 14px;\n");
    s.push_str("            border-radius: 6px;\n");
    s.push_str("            font-family: var(--font-code);\n");
    s.push_str("            font-size: 0.8rem;\n");
    s.push_str("            font-weight: 700;\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            gap: 6px;\n");
    s.push_str("            transition: all 0.2s;\n");
    s.push_str("        }\n");
    s.push_str("        .btn-run:hover {\n");
    s.push_str("            filter: brightness(1.15);\n");
    s.push_str("            transform: scale(1.02);\n");
    s.push_str("            box-shadow: 0 0 15px var(--gold-glow);\n");
    s.push_str("        }\n");
    s.push_str("        .editor-body {\n");
    s.push_str("            display: grid;\n");
    s.push_str("            grid-template-columns: 1fr;\n");
    s.push_str("            background: #090a10;\n");
    s.push_str("        }\n");
    s.push_str("        .code-pre {\n");
    s.push_str("            padding: 28px;\n");
    s.push_str("            font-family: var(--font-code);\n");
    s.push_str("            font-size: 0.92rem;\n");
    s.push_str("            line-height: 1.7;\n");
    s.push_str("            color: #e6edf3;\n");
    s.push_str("            overflow-x: auto;\n");
    s.push_str("            white-space: pre;\n");
    s.push_str("        }\n");
    s.push_str("        /* Syntax token colors */\n");
    s.push_str("        .kw { color: #c4b5fd; font-weight: 600; }\n");
    s.push_str("        .fn { color: var(--gold-core); font-weight: 600; }\n");
    s.push_str("        .ty { color: #38bdf8; }\n");
    s.push_str("        .str { color: #a7f3d0; }\n");
    s.push_str("        .num { color: #fcd34d; }\n");
    s.push_str("        .comment { color: #6b7280; font-style: italic; }\n");
    s.push_str("        .op { color: #f43f5e; }\n");
    s.push_str("\n");
    s.push_str("        .terminal-output {\n");
    s.push_str("            background: #050608;\n");
    s.push_str("            border-top: 1px solid rgba(255, 255, 255, 0.08);\n");
    s.push_str("            padding: 16px 24px;\n");
    s.push_str("            font-family: var(--font-code);\n");
    s.push_str("            font-size: 0.85rem;\n");
    s.push_str("            color: #9ca3af;\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            justify-content: space-between;\n");
    s.push_str("        }\n");
    s.push_str("        .terminal-output .out-success {\n");
    s.push_str("            color: #34d399;\n");
    s.push_str("            font-weight: 600;\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        /* ==========================================================================\n");
    s.push_str("           6. INTERACTIVE BENCHMARK ARENA\n");
    s.push_str("           ========================================================================== */\n");
    s.push_str("        .bench-wrapper {\n");
    s.push_str("            background: rgba(17, 18, 27, 0.85);\n");
    s.push_str("            backdrop-filter: blur(20px);\n");
    s.push_str("            border: 1px solid var(--border-gold);\n");
    s.push_str("            border-radius: 24px;\n");
    s.push_str("            padding: 40px;\n");
    s.push_str("            max-width: 1050px;\n");
    s.push_str("            margin: 0 auto;\n");
    s.push_str("        }\n");
    s.push_str("        .bench-tabs {\n");
    s.push_str("            display: flex;\n");
    s.push_str("            gap: 12px;\n");
    s.push_str("            margin-bottom: 32px;\n");
    s.push_str("            border-bottom: 1px solid var(--border-subtle);\n");
    s.push_str("            padding-bottom: 16px;\n");
    s.push_str("        }\n");
    s.push_str("        .bench-tab {\n");
    s.push_str("            background: transparent;\n");
    s.push_str("            border: 1px solid transparent;\n");
    s.push_str("            color: var(--text-muted);\n");
    s.push_str("            font-family: var(--font-display);\n");
    s.push_str("            font-size: 1rem;\n");
    s.push_str("            font-weight: 700;\n");
    s.push_str("            padding: 8px 20px;\n");
    s.push_str("            border-radius: 9999px;\n");
    s.push_str("            transition: all 0.2s;\n");
    s.push_str("        }\n");
    s.push_str("        .bench-tab.active {\n");
    s.push_str("            background: rgba(255, 215, 0, 0.12);\n");
    s.push_str("            border-color: rgba(255, 215, 0, 0.4);\n");
    s.push_str("            color: var(--gold-bright);\n");
    s.push_str("        }\n");
    s.push_str("        .bench-bar-group {\n");
    s.push_str("            display: flex;\n");
    s.push_str("            flex-direction: column;\n");
    s.push_str("            gap: 20px;\n");
    s.push_str("        }\n");
    s.push_str("        .bench-row {\n");
    s.push_str("            display: grid;\n");
    s.push_str("            grid-template-columns: 140px 1fr 100px;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            gap: 20px;\n");
    s.push_str("        }\n");
    s.push_str("        .bench-lang {\n");
    s.push_str("            font-family: var(--font-code);\n");
    s.push_str("            font-weight: 700;\n");
    s.push_str("            font-size: 0.92rem;\n");
    s.push_str("            color: #ffffff;\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            gap: 8px;\n");
    s.push_str("        }\n");
    s.push_str("        .bench-track {\n");
    s.push_str("            background: rgba(255, 255, 255, 0.05);\n");
    s.push_str("            border-radius: 8px;\n");
    s.push_str("            height: 32px;\n");
    s.push_str("            position: relative;\n");
    s.push_str("            overflow: hidden;\n");
    s.push_str("        }\n");
    s.push_str("        .bench-fill {\n");
    s.push_str("            height: 100%;\n");
    s.push_str("            border-radius: 8px;\n");
    s.push_str("            transition: width 1s var(--ease-out-expo);\n");
    s.push_str("            position: relative;\n");
    s.push_str("        }\n");
    s.push_str("        .fill-vanta {\n");
    s.push_str("            background: linear-gradient(90deg, var(--gold-core), var(--amber-warm));\n");
    s.push_str("            box-shadow: 0 0 20px var(--gold-glow);\n");
    s.push_str("        }\n");
    s.push_str("        .fill-other {\n");
    s.push_str("            background: #2b2e3e;\n");
    s.push_str("        }\n");
    s.push_str("        .bench-val {\n");
    s.push_str("            font-family: var(--font-code);\n");
    s.push_str("            font-weight: 700;\n");
    s.push_str("            font-size: 0.95rem;\n");
    s.push_str("            color: var(--text-hero);\n");
    s.push_str("            text-align: right;\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        /* ==========================================================================\n");
    s.push_str("           7. INTERACTIVE CLI SIMULATOR\n");
    s.push_str("           ========================================================================== */\n");
    s.push_str("        .cli-window {\n");
    s.push_str("            background: #050609;\n");
    s.push_str("            border: 1px solid var(--border-gold);\n");
    s.push_str("            border-radius: 20px;\n");
    s.push_str("            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 35px rgba(255, 215, 0, 0.1);\n");
    s.push_str("            overflow: hidden;\n");
    s.push_str("            max-width: 950px;\n");
    s.push_str("            margin: 0 auto;\n");
    s.push_str("        }\n");
    s.push_str("        .cli-header {\n");
    s.push_str("            background: #0e0f17;\n");
    s.push_str("            padding: 12px 18px;\n");
    s.push_str("            border-bottom: 1px solid rgba(255, 255, 255, 0.07);\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            gap: 8px;\n");
    s.push_str("        }\n");
    s.push_str("        .cli-dot {\n");
    s.push_str("            width: 12px;\n");
    s.push_str("            height: 12px;\n");
    s.push_str("            border-radius: 50%;\n");
    s.push_str("        }\n");
    s.push_str("        .dot-red { background: #ef4444; }\n");
    s.push_str("        .dot-yellow { background: #f59e0b; }\n");
    s.push_str("        .dot-green { background: #10b981; }\n");
    s.push_str("        .cli-title {\n");
    s.push_str("            margin-left: 12px;\n");
    s.push_str("            font-family: var(--font-code);\n");
    s.push_str("            font-size: 0.78rem;\n");
    s.push_str("            color: var(--text-muted);\n");
    s.push_str("        }\n");
    s.push_str("        .cli-body {\n");
    s.push_str("            padding: 24px;\n");
    s.push_str("            font-family: var(--font-code);\n");
    s.push_str("            font-size: 0.92rem;\n");
    s.push_str("            min-height: 280px;\n");
    s.push_str("            max-height: 420px;\n");
    s.push_str("            overflow-y: auto;\n");
    s.push_str("            color: #d1d5db;\n");
    s.push_str("            line-height: 1.6;\n");
    s.push_str("        }\n");
    s.push_str("        .cli-input-line {\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            gap: 10px;\n");
    s.push_str("            margin-top: 14px;\n");
    s.push_str("        }\n");
    s.push_str("        .cli-prompt {\n");
    s.push_str("            color: var(--gold-core);\n");
    s.push_str("            font-weight: 700;\n");
    s.push_str("        }\n");
    s.push_str("        .cli-input {\n");
    s.push_str("            flex: 1;\n");
    s.push_str("            background: transparent;\n");
    s.push_str("            border: none;\n");
    s.push_str("            outline: none;\n");
    s.push_str("            color: #ffffff;\n");
    s.push_str("            font-family: var(--font-code);\n");
    s.push_str("            font-size: 0.92rem;\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        /* ==========================================================================\n");
    s.push_str("           8. LUXURY FOOTER\n");
    s.push_str("           ========================================================================== */\n");
    s.push_str("        .footer {\n");
    s.push_str("            border-top: 1px solid var(--border-subtle);\n");
    s.push_str("            padding: 80px 0 40px;\n");
    s.push_str("            background: #040406;\n");
    s.push_str("            margin-top: 80px;\n");
    s.push_str("        }\n");
    s.push_str("        .footer-grid {\n");
    s.push_str("            display: grid;\n");
    s.push_str("            grid-template-columns: 2fr repeat(3, 1fr);\n");
    s.push_str("            gap: 40px;\n");
    s.push_str("            margin-bottom: 60px;\n");
    s.push_str("        }\n");
    s.push_str("        .footer-brand h3 {\n");
    s.push_str("            font-family: var(--font-display);\n");
    s.push_str("            font-size: 1.6rem;\n");
    s.push_str("            font-weight: 900;\n");
    s.push_str("            color: var(--text-hero);\n");
    s.push_str("            margin-bottom: 12px;\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            gap: 10px;\n");
    s.push_str("        }\n");
    s.push_str("        .footer-brand h3 img {\n");
    s.push_str("            width: 24px;\n");
    s.push_str("            height: 24px;\n");
    s.push_str("            filter: drop-shadow(0 0 6px var(--gold-core));\n");
    s.push_str("        }\n");
    s.push_str("        .footer-brand p {\n");
    s.push_str("            color: var(--text-muted);\n");
    s.push_str("            font-size: 0.95rem;\n");
    s.push_str("            max-width: 360px;\n");
    s.push_str("            line-height: 1.6;\n");
    s.push_str("        }\n");
    s.push_str("        .footer-col h4 {\n");
    s.push_str("            font-family: var(--font-display);\n");
    s.push_str("            font-size: 1rem;\n");
    s.push_str("            font-weight: 800;\n");
    s.push_str("            color: var(--text-hero);\n");
    s.push_str("            margin-bottom: 18px;\n");
    s.push_str("            letter-spacing: -0.01em;\n");
    s.push_str("        }\n");
    s.push_str("        .footer-col ul {\n");
    s.push_str("            list-style: none;\n");
    s.push_str("            display: flex;\n");
    s.push_str("            flex-direction: column;\n");
    s.push_str("            gap: 10px;\n");
    s.push_str("        }\n");
    s.push_str("        .footer-col a {\n");
    s.push_str("            color: var(--text-muted);\n");
    s.push_str("            text-decoration: none;\n");
    s.push_str("            font-size: 0.9rem;\n");
    s.push_str("            transition: color 0.2s;\n");
    s.push_str("        }\n");
    s.push_str("        .footer-col a:hover {\n");
    s.push_str("            color: var(--gold-bright);\n");
    s.push_str("        }\n");
    s.push_str("        .footer-bottom {\n");
    s.push_str("            border-top: 1px solid rgba(255, 255, 255, 0.05);\n");
    s.push_str("            padding-top: 30px;\n");
    s.push_str("            display: flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            justify-content: space-between;\n");
    s.push_str("            font-size: 0.85rem;\n");
    s.push_str("            color: var(--text-muted);\n");
    s.push_str("        }\n");
    s.push_str("        .ssr-pill {\n");
    s.push_str("            display: inline-flex;\n");
    s.push_str("            align-items: center;\n");
    s.push_str("            gap: 8px;\n");
    s.push_str("            background: rgba(255, 215, 0, 0.08);\n");
    s.push_str("            border: 1px solid rgba(255, 215, 0, 0.25);\n");
    s.push_str("            color: var(--gold-bright);\n");
    s.push_str("            padding: 4px 12px;\n");
    s.push_str("            border-radius: 9999px;\n");
    s.push_str("            font-family: var(--font-code);\n");
    s.push_str("            font-size: 0.75rem;\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        /* Responsive Breakpoints */\n");
    s.push_str("        @media (max-width: 992px) {\n");
    s.push_str("            .bento-grid {\n");
    s.push_str("                grid-template-columns: 1fr;\n");
    s.push_str("            }\n");
    s.push_str("            .bento-card.col-span-2 {\n");
    s.push_str("                grid-column: span 1;\n");
    s.push_str("            }\n");
    s.push_str("            .footer-grid {\n");
    s.push_str("                grid-template-columns: 1fr 1fr;\n");
    s.push_str("            }\n");
    s.push_str("            .nav-links {\n");
    s.push_str("                display: none;\n");
    s.push_str("            }\n");
    s.push_str("        }\n");
    s.push_str("        @media (max-width: 640px) {\n");
    s.push_str("            .footer-grid {\n");
    s.push_str("                grid-template-columns: 1fr;\n");
    s.push_str("            }\n");
    s.push_str("            .hero-title {\n");
    s.push_str("                font-size: 2.8rem;\n");
    s.push_str("            }\n");
    s.push_str("            .stat-ribbon {\n");
    s.push_str("                grid-template-columns: 1fr 1fr;\n");
    s.push_str("            }\n");
    s.push_str("        }\n");
    s.push_str("</style>\n");
    s
}
