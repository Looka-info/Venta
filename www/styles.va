// ============================================================================
// ⚡ Venta Web Stylesheet Module (100% Pure Venta)
// Design Tokens & Minimalist Monochrome Layout CSS
// ============================================================================

import std::string::String;

pub fn get_showcase_styles() -> String {
    let mut s = String::from_str("<style>\n");
    s.push_str(":root{\n");
    s.push_str("  color-scheme:dark;\n");
    s.push_str("  --bg:#000;--fg:#ededed;--mut:#8f8f8f;--line:#242424;--card:#000;--hi:#fff;--err:#ff4d4d;--ok:#3ecf8e;\n");
    s.push_str("  --sans:\"Geist\",ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",Helvetica,Arial,sans-serif;\n");
    s.push_str("  --mono:\"Geist Mono\",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;\n");
    s.push_str("  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);\n");
    s.push_str("}\n");
    s.push_str("html{scroll-padding-top:env(safe-area-inset-top,0px);background:#000}\n");
    s.push_str("*,*::before,*::after{box-sizing:inherit}\n");
    s.push_str("body{margin:0;background:var(--bg);background-image:linear-gradient(#121212 1px,transparent 1px),linear-gradient(90deg,#121212 1px,transparent 1px);background-size:72px 72px;color:var(--fg);font:400 16px/1.55 var(--sans);-webkit-font-smoothing:antialiased;overflow-x:hidden}\n");
    s.push_str("a{color:inherit}\n");
    s.push_str(":focus-visible{outline:2px solid #fff;outline-offset:3px}\n");
    s.push_str(".wrap{padding:0 clamp(20px,5vw,72px)}\n");
    s.push_str(".mono{font-family:var(--mono)}\n");
    s.push_str(".mut{color:var(--mut)}\n\n");

    // Navigation
    s.push_str("nav{position:fixed;top:0;left:0;right:0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:calc(14px + env(safe-area-inset-top,0px)) clamp(20px,5vw,72px) 14px;mix-blend-mode:difference}\n");
    s.push_str("nav b{font-weight:800;letter-spacing:-.03em;font-size:18px}\n");
    s.push_str("nav a{font-size:14px;text-decoration:none;color:#fff}\n\n");

    // Hero
    s.push_str(".hero{min-height:100vh;min-height:100svh;display:flex;flex-direction:column;justify-content:flex-end;padding-bottom:clamp(28px,6vh,64px);position:relative;overflow:hidden}\n");
    s.push_str(".hero h1{margin:0;font-weight:800;font-size:clamp(88px,29vw,520px);line-height:.78;letter-spacing:-.07em;display:flex;margin-left:-.04em}\n");
    s.push_str(".hero h1 .m{display:block;overflow:hidden;padding-bottom:.08em}\n");
    s.push_str(".hero h1 .m span{display:block;transform:translateY(105%)}\n");
    s.push_str(".hero .row{display:flex;flex-wrap:wrap;gap:24px 48px;align-items:flex-end;justify-content:space-between;margin-top:clamp(24px,5vh,56px)}\n");
    s.push_str(".hero p{margin:0;max-width:34ch;font-size:clamp(18px,2vw,24px);line-height:1.3;letter-spacing:-.02em}\n");
    s.push_str(".cmd{display:flex;align-items:center;gap:12px;border:1px solid var(--line);border-radius:8px;padding:10px 12px 10px 16px;font:500 14px var(--mono);background:#000}\n");
    s.push_str(".cmd button,.btn{font:500 14px var(--sans);border:0;border-radius:6px;padding:8px 14px;cursor:pointer;background:#fff;color:#000}\n");
    s.push_str(".cmd button:hover,.btn:hover{background:#d4d4d4}\n");
    s.push_str(".btn{display:inline-block;text-decoration:none;padding:14px 22px;font-size:16px;border-radius:8px}\n");
    s.push_str(".btn.o{background:#000;color:#fff;border:1px solid #333}\n");
    s.push_str(".btn.o:hover{background:#111}\n");
    s.push_str(".glow{position:absolute;left:50%;top:-10%;width:90vw;height:60vh;transform:translateX(-50%);background:radial-gradient(ellipse at center,rgba(255,255,255,.1),transparent 65%);pointer-events:none}\n\n");

    // Statement Pin
    s.push_str(".stmt{height:100vh;height:100svh;display:grid;place-items:center;position:relative;border-top:1px solid var(--line)}\n");
    s.push_str(".stmt .w{position:absolute;inset:0;display:grid;place-items:center;text-align:center;font-weight:800;font-size:clamp(52px,13vw,260px);line-height:.9;letter-spacing:-.06em;padding:0 5vw;opacity:0}\n");
    s.push_str(".stmt .w i{font-style:normal;color:#555}\n\n");

    // Marquee
    s.push_str(".mq{border-top:1px solid var(--line);border-bottom:1px solid var(--line);overflow:hidden;padding:18px 0;white-space:nowrap}\n");
    s.push_str(".mq div{display:inline-block;font-weight:800;font-size:clamp(40px,8vw,120px);letter-spacing:-.05em;line-height:1;color:transparent;-webkit-text-stroke:1px #444}\n");
    s.push_str(".mq div span{margin-right:.5em}\n\n");

    // Horizontal Track
    s.push_str(".hs{overflow:hidden;position:relative}\n");
    s.push_str(".hs .head{position:absolute;z-index:3;top:calc(76px + env(safe-area-inset-top,0px));left:clamp(20px,5vw,72px);right:clamp(20px,5vw,72px);display:flex;justify-content:space-between;color:var(--mut);font-size:14px;pointer-events:none}\n");
    s.push_str(".track{display:flex;height:100vh;height:100svh;width:max-content;will-change:transform}\n");
    s.push_str(".p{flex:0 0 auto;width:min(78vw,1000px);height:100%;display:flex;flex-direction:column;justify-content:flex-end;padding:0 clamp(24px,4vw,64px) clamp(56px,10vh,110px);border-left:1px solid var(--line)}\n");
    s.push_str(".p.intro{width:min(86vw,900px);border-left:0;padding-left:clamp(20px,5vw,72px)}\n");
    s.push_str(".p h3{margin:0 0 20px;font-weight:800;font-size:clamp(56px,11vw,190px);line-height:.85;letter-spacing:-.06em}\n");
    s.push_str(".p h3 small{display:block;font-size:.34em;letter-spacing:-.04em;color:#555;margin-top:.2em;font-weight:600}\n");
    s.push_str(".p p{margin:0;max-width:40ch;color:var(--mut);font-size:clamp(16px,1.6vw,21px);line-height:1.4}\n");
    s.push_str(".bar{position:absolute;left:0;bottom:0;height:2px;background:#fff;width:100%;transform:scaleX(0);transform-origin:0 50%;z-index:4}\n");
    s.push_str("html.rm .track{overflow-x:auto;width:auto;height:auto;min-height:100vh}\n");
    s.push_str("html.rm .hs .bar,html.rm .hs .head{display:none}\n\n");

    // Benchmarks
    s.push_str(".sec{padding:clamp(56px,9vh,110px) 0;border-top:1px solid var(--line)}\n");
    s.push_str(".sec h2{margin:0 0 clamp(32px,6vh,72px);font-weight:800;font-size:clamp(44px,9vw,150px);line-height:.88;letter-spacing:-.06em;max-width:14ch}\n");
    s.push_str(".grid{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(32px,6vw,96px);align-items:start}\n");
    s.push_str(".bars{display:grid;gap:18px}\n");
    s.push_str(".br .l{display:flex;justify-content:space-between;font:500 14px var(--mono);margin-bottom:8px}\n");
    s.push_str(".br .t{height:10px;background:#111;border-radius:99px;overflow:hidden}\n");
    s.push_str(".br .f{height:100%;width:100%;background:#fff;border-radius:99px;transform:scaleX(0);transform-origin:0 50%}\n");
    s.push_str("table{width:100%;border-collapse:collapse;font-size:15px}\n");
    s.push_str("th,td{padding:14px 12px 14px 0;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}\n");
    s.push_str("th{color:var(--mut);font-weight:500}\n");
    s.push_str("td.v{font:500 15px var(--mono);color:var(--hi)}\n");
    s.push_str(".note{margin-top:20px;font-size:13px;color:var(--mut);max-width:60ch}\n\n");

    // Code
    s.push_str(".code{border:1px solid var(--line);border-radius:12px;background:#000;overflow-x:auto}\n");
    s.push_str(".code .bt{display:flex;gap:7px;padding:14px 16px;border-bottom:1px solid var(--line)}\n");
    s.push_str(".code .bt i{width:11px;height:11px;border-radius:50%;background:#2a2a2a}\n");
    s.push_str(".code pre{margin:0;padding:22px 22px 26px;font:400 clamp(13px,1.5vw,17px)/1.75 var(--mono);min-width:max-content}\n");
    s.push_str(".ln{display:block;opacity:.18}\n");
    s.push_str(".k{color:#ff7ab6}.t{color:#7cc4ff}.s{color:#9ae6b4}.c{color:#666}\n");
    s.push_str(".bad{background:rgba(255,77,77,.12);box-shadow:inset 2px 0 0 var(--err)}\n");
    s.push_str(".err{color:var(--err)}\n\n");

    // Start Steps
    s.push_str(".steps{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:1px solid var(--line);border-radius:12px;overflow:hidden}\n");
    s.push_str(".st{padding:clamp(20px,3vw,36px);border-right:1px solid var(--line)}\n");
    s.push_str(".st:last-child{border-right:0}\n");
    s.push_str(".st h4{margin:0 0 6px;font-size:clamp(24px,3vw,40px);letter-spacing:-.04em;font-weight:800}\n");
    s.push_str(".st p{margin:0 0 20px;color:var(--mut);font-size:15px}\n\n");

    // Watermark backgrounds
    s.push_str(".p{position:relative;overflow:hidden}\n");
    s.push_str(".p::before{position:absolute;top:calc(110px + env(safe-area-inset-top,0px));left:clamp(20px,3vw,48px);font-weight:800;font-size:clamp(90px,17vw,280px);line-height:1;letter-spacing:-.07em;color:transparent;-webkit-text-stroke:1px #2c2c2c;pointer-events:none}\n");
    s.push_str(".p:nth-child(2)::before{content:\"build\"}.p:nth-child(3)::before{content:\"ship\"}.p:nth-child(4)::before{content:\"safe\"}.p:nth-child(5)::before{content:\"opt\"}.p:nth-child(6)::before{content:\"json\"}\n\n");

    // Pipeline
    s.push_str(".pipe{border-top:1px solid var(--line)}\n");
    s.push_str(".pipe .in{height:100vh;height:100svh;display:grid;grid-template-columns:1.4fr 1fr;gap:clamp(24px,5vw,80px);align-items:end;padding-top:90px;padding-bottom:clamp(28px,6vh,64px)}\n");
    s.push_str("#pn{font-weight:800;font-size:clamp(52px,10vw,190px);line-height:.85;letter-spacing:-.06em}\n");
    s.push_str("#pd{max-width:36ch;color:var(--mut);font-size:clamp(16px,1.7vw,22px);line-height:1.35;margin:20px 0 0}\n");
    s.push_str("#pl{list-style:none;margin:0;padding:0;border-top:1px solid var(--line);background:#000}\n");
    s.push_str("#pl li{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid var(--line);color:#4a4a4a;font:500 15px var(--mono);transition:color .25s,padding .25s}\n");
    s.push_str("#pl li.on{color:#fff;padding-left:12px}\n");
    s.push_str("#pl li.done{color:#9a9a9a}\n");
    s.push_str("#pl li.done::after{content:\"✓\"}\n\n");

    // Optimizer Grid
    s.push_str(".opt{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}\n");
    s.push_str(".opt div{padding:clamp(16px,2vw,28px);border-right:1px solid var(--line);border-bottom:1px solid var(--line);min-height:clamp(120px,19vh,190px);display:flex;flex-direction:column;justify-content:space-between;background:#000;color:#fff;transition:background .2s,color .2s}\n");
    s.push_str(".opt b{font-size:clamp(20px,2.5vw,36px);letter-spacing:-.04em;font-weight:800;line-height:1}\n");
    s.push_str(".opt span{font-size:13px;color:var(--mut);transition:color .2s}\n");
    s.push_str(".opt div.lit{background:#fff;color:#000}.opt div.lit span{color:#444}\n\n");

    // Ecosystem
    s.push_str(".eco{display:grid;grid-template-columns:repeat(6,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}\n");
    s.push_str(".eco div{grid-column:span 2;padding:clamp(20px,3vw,40px);border-right:1px solid var(--line);border-bottom:1px solid var(--line);min-height:clamp(220px,36vh,340px);display:flex;flex-direction:column;justify-content:space-between;background:#000}\n");
    s.push_str(".eco .w3{grid-column:span 3}\n");
    s.push_str(".eco b{font-size:clamp(52px,8vw,140px);letter-spacing:-.07em;font-weight:800;line-height:.88}\n");
    s.push_str(".eco h4{margin:0 0 6px;font-size:clamp(18px,1.9vw,26px);letter-spacing:-.03em}\n");
    s.push_str(".eco p{margin:0;color:var(--mut);font-size:15px;max-width:40ch}\n");
    s.push_str("@media(max-width:820px){.pipe .in{grid-template-columns:1fr;align-content:end;gap:20px}#pl li{padding:7px 0;font-size:13px}.opt{grid-template-columns:repeat(2,1fr)}.eco div,.eco .w3{grid-column:span 6}}\n\n");

    // Code Tabs
    s.push_str(".code .bt{align-items:center}\n");
    s.push_str(".tabs{display:flex;gap:4px;margin-left:12px;overflow-x:auto}\n");
    s.push_str(".tab{font:500 13px var(--mono);background:none;border:0;color:#777;padding:3px 10px;border-radius:6px;cursor:pointer;white-space:nowrap}\n");
    s.push_str(".tab:hover{color:#fff}\n");
    s.push_str(".tab[aria-selected=true]{background:#1a1a1a;color:#fff}\n");
    s.push_str(".stat{display:flex;gap:10px;align-items:center;padding:12px 18px;border-top:1px solid var(--line);font:500 13px var(--mono);color:#a1a1a1;min-width:max-content}\n");
    s.push_str(".stat .d{width:8px;height:8px;border-radius:50%;background:var(--err)}\n");
    s.push_str(".stat.ok .d{background:var(--ok)}.stat.n .d{background:#777}\n");
    s.push_str(".gl{list-style:none;margin:28px 0 0;padding:0;border-top:1px solid var(--line);background:#000}\n");
    s.push_str(".gl li{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;padding:16px 0;border-bottom:1px solid var(--line)}\n");
    s.push_str(".gl b{font-size:clamp(24px,3.4vw,48px);letter-spacing:-.05em;line-height:1;font-weight:800}\n");
    s.push_str(".gl span{color:var(--mut);font-size:14px;text-align:right}\n\n");

    // Benchmarks Explorer
    s.push_str(".sx{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line);margin-bottom:clamp(32px,6vh,72px)}\n");
    s.push_str(".sx div{padding:clamp(20px,3vw,40px);border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:#000}\n");
    s.push_str(".sx b{display:block;font-size:clamp(64px,11vw,190px);font-weight:800;letter-spacing:-.07em;line-height:.85}\n");
    s.push_str(".sx p{margin:14px 0 0;color:var(--mut);max-width:30ch}\n");
    s.push_str(".rx{border:1px solid var(--line);border-radius:12px;background:#000;padding:clamp(18px,3vw,36px);margin-bottom:clamp(32px,6vh,72px)}\n");
    s.push_str(".rh{display:flex;justify-content:space-between;gap:10px 32px;flex-wrap:wrap;align-items:baseline;margin-bottom:18px}\n");
    s.push_str(".rh h3,.sh{margin:0;font-size:clamp(22px,2.6vw,36px);letter-spacing:-.04em;line-height:1.05}\n");
    s.push_str(".rh p{margin:0;color:var(--mut);font-size:14px}\n");
    s.push_str(".chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:24px}\n");
    s.push_str(".chip{font:500 13px var(--mono);color:#a1a1a1;background:#000;border:1px solid #2a2a2a;border-radius:99px;padding:6px 12px;cursor:pointer}\n");
    s.push_str(".chip:hover{border-color:#666;color:#fff}\n");
    s.push_str(".chip[aria-pressed=true]{background:#fff;color:#000;border-color:#fff}\n");
    s.push_str(".rr{display:grid;grid-template-columns:96px 1fr 92px;gap:14px;align-items:center;margin:12px 0;font:500 14px var(--mono)}\n");
    s.push_str(".rr .t{height:18px;background:#0e0e0e;border-radius:4px;overflow:hidden}\n");
    s.push_str(".rr .f{height:100%;width:0;border-radius:4px;transition:width .55s cubic-bezier(.2,.8,.2,1)}\n");
    s.push_str(".rr.v .f{background:#fff}.rr.g .f{background:#707070}.rr.r .f{background:#3d3d3d}\n");
    s.push_str(".rr .n{text-align:right}\n");
    s.push_str("#rv{margin:18px 0 0;font-size:clamp(16px,1.8vw,22px);letter-spacing:-.02em;line-height:1.3;max-width:62ch;min-height:2.6em}\n");
    s.push_str("@media(max-width:820px){.sx{grid-template-columns:1fr}.rr{grid-template-columns:72px 1fr 78px;gap:10px;font-size:12px}}\n\n");

    // Footer
    s.push_str(".fin{padding:clamp(80px,16vh,200px) 0 40px;border-top:1px solid var(--line);overflow:hidden}\n");
    s.push_str(".fin h2{margin:0 0 40px;font-weight:800;font-size:clamp(60px,17vw,330px);line-height:.82;letter-spacing:-.07em}\n");
    s.push_str(".fin .acts{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:clamp(48px,10vh,120px)}\n");
    s.push_str(".fin small{color:var(--mut);font-size:13px;display:block}\n\n");

    // Media Queries & Accessibility
    s.push_str("@media(max-width:820px){\n");
    s.push_str("  .grid{grid-template-columns:1fr}\n");
    s.push_str("  .steps{grid-template-columns:1fr}\n");
    s.push_str("  .st{border-right:0;border-bottom:1px solid var(--line)}\n");
    s.push_str("  .st:last-child{border-bottom:0}\n");
    s.push_str("  .p{width:86vw}\n");
    s.push_str("}\n");
    s.push_str("@media(prefers-reduced-motion:reduce){.hero h1 .m span{transform:none}.stmt .w{opacity:1;position:static}.stmt{height:auto;padding:80px 0}}\n");
    s.push_str("</style>\n");
    s
}

pub fn get_luxury_styles() -> String {
    get_showcase_styles()
}
