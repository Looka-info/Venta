// ============================================================================
// ⚡ Venta Native HTTP Web Server (in Pure Venta)
// Serves the Venta Showcase, Release Hub & Developer Guide over HTTP
// ============================================================================

import std::net;
import std::fs;
import std::env;
import std::string::String;
import std::result::Result;
import std::option::Option;

fn print_banner(port: i64) {
    print_str("====================================================================\n");
    print_str("   ⚡ Venta Native HTTP Engine — Pure Venta Language Runtime        \n");
    print_str("====================================================================\n");
    print_str("   Product:      Venta Showcase & v1.0-RC2 Release Hub              \n");
    print_str("   Architecture: System V AMD64 (Native Assembly Backend)           \n");
    print_str("   Port:         ");
    print_i64(port);
    print_str("\n");
    print_str("   Serving:      http://127.0.0.1:");
    print_i64(port);
    print_str("/\n");
    print_str("   API Status:   http://127.0.0.1:");
    print_i64(port);
    print_str("/api/status\n");
    print_str("====================================================================\n\n");
}

fn print_usage() {
    print_str("Usage: vanta run www/server.va [--port <port>] [--once]\n\n");
    print_str("Options:\n");
    print_str("  --port <port>   Set listening TCP port (default: 8080)\n");
    print_str("  --once          Serve single HTTP request and terminate (testing)\n");
    print_str("  -h, --help      Display this help dialog\n");
}

fn load_document() -> String {
    print_str("[Server] Loading showcase document...\n");
    let try_www = fs::read_to_string("www/index.html");
    match try_www {
        Result::Ok(content) => {
            print_str("[Server] Loaded www/index.html (");
            print_i64(content.len_bytes());
            print_str(" bytes)\n");
            return content;
        }
        Result::Err(_) => {}
    }

    let try_docs = fs::read_to_string("docs/index.html");
    match try_docs {
        Result::Ok(content) => {
            print_str("[Server] Loaded docs/index.html (");
            print_i64(content.len_bytes());
            print_str(" bytes)\n");
            return content;
        }
        Result::Err(_) => {}
    }

    print_str("[Server] Fallback to embedded showcase HTML\n");
    String::from_str("<!DOCTYPE html><html><head><title>Venta Showcase</title></head><body style='background:#0d1117;color:#c9d1d9;font-family:sans-serif;padding:40px;'><h1>⚡ Venta Showcase</h1><p>Venta v1.0-RC2 is running via the pure Venta HTTP engine.</p></body></html>")
}

fn main() -> i64 {
    let mut port: i64 = 8080;
    let mut serve_once: bool = false;

    let args_res = env::args();
    match args_res {
        Result::Ok(args) => {
            let mut i: i64 = 1;
            while i < args.len() {
                let arg = args[i].clone();
                if arg.equals("-h") || arg.equals("--help") {
                    print_usage();
                    return 0;
                }
                if arg.equals("--once") {
                    serve_once = true;
                }
                if (arg.equals("--port") || arg.equals("-p")) && (i + 1 < args.len()) {
                    let next_arg = args[i + 1].clone();
                    if next_arg.equals("8080") {
                        port = 8080;
                    } else if next_arg.equals("3000") {
                        port = 3000;
                    } else if next_arg.equals("8000") {
                        port = 8000;
                    } else if next_arg.equals("8099") {
                        port = 8099;
                    }
                    i = i + 1;
                }
                i = i + 1;
            }
        }
        Result::Err(_) => {}
    }

    print_banner(port);

    let html_body = load_document();

    let server_fd = net::listen(port);
    if server_fd < 0 {
        print_str("[Error] Failed to bind TCP listener to port ");
        print_i64(port);
        print_str(" (code: ");
        print_i64(server_fd);
        print_str(")\n");
        return 1;
    }

    print_str("[Server] Listening and ready for incoming HTTP connections...\n");

    let mut running: bool = true;
    let mut req_count: i64 = 0;

    while running {
        let client_fd = net::accept(server_fd);
        if client_fd < 0 {
            print_str("[Server] Warning: Failed to accept socket connection\n");
        } else {
            req_count = req_count + 1;
            print_str("[HTTP #");
            print_i64(req_count);
            print_str("] Client connected. Reading request...\n");

            let mut req = String::new();
            let bytes_read = net::read(client_fd, &mut req);

            let mut is_api_status: bool = false;
            let mut is_health: bool = false;

            if req.len_bytes() >= 15 {
                let p = req.slice_bytes(0, 15);
                match p {
                    Option::Some(prefix) => {
                        if prefix.equals("GET /api/status") {
                            is_api_status = true;
                        }
                    }
                    Option::None => {}
                }
            }

            if req.len_bytes() >= 11 {
                let p_health = req.slice_bytes(0, 11);
                match p_health {
                    Option::Some(prefix) => {
                        if prefix.equals("GET /health") {
                            is_health = true;
                        }
                    }
                    Option::None => {}
                }
            }

            if is_api_status {
                print_str("        --> Handling 200 OK /api/status (JSON)\n");
                let header = "HTTP/1.1 200 OK\r\nContent-Type: application/json; charset=utf-8\r\nAccess-Control-Allow-Origin: *\r\nServer: Venta-Native-HTTP/1.0\r\nConnection: close\r\n\r\n";
                let json_body = "{\"status\":\"online\",\"language\":\"Venta\",\"version\":\"1.0.0-rc.2\",\"architecture\":\"x86_64-unknown-linux-gnu\",\"compiler\":\"vanta-native-ssa\",\"backend\":\"System V AMD64\",\"safety\":\"100% Guaranteed\",\"features\":[\"Ownership & Borrow Checker\",\"Zero-Cost Abstractions\",\"SSA Optimizer\",\"Native Assembly Generator\",\"System V C ABI Interop\"]}\n";
                net::write(client_fd, header);
                net::write(client_fd, json_body);
            } else if is_health {
                print_str("        --> Handling 200 OK /health (JSON)\n");
                let header = "HTTP/1.1 200 OK\r\nContent-Type: application/json; charset=utf-8\r\nServer: Venta-Native-HTTP/1.0\r\nConnection: close\r\n\r\n";
                let json_body = "{\"status\":\"ok\",\"engine\":\"Venta-Native-HTTP/1.0\"}\n";
                net::write(client_fd, header);
                net::write(client_fd, json_body);
            } else {
                print_str("        --> Handling 200 OK Showcase & Guide (HTML, ");
                print_i64(html_body.len_bytes());
                print_str(" bytes)\n");
                let header = "HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nServer: Venta-Native-HTTP/1.0\r\nConnection: close\r\n\r\n";
                net::write(client_fd, header);
                net::write(client_fd, html_body.as_str());
            }

            net::close(client_fd);
            print_str("        --> Connection closed successfully.\n");

            if serve_once {
                print_str("[Server] Flag --once detected. Gracefully shutting down.\n");
                running = false;
            }
        }
    }

    net::close(server_fd);
    print_str("[Server] Server stopped.\n");
    0
}
