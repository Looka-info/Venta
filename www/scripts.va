// ============================================================================
// ⚡ Venta Web Client Scripts Module (in Pure Venta)
// GSAP 3.12+ Kinetic Typography, 3D Parallax, Canvas Particles & Interactive CLI
// ============================================================================

import std::string::String;

pub fn get_client_scripts() -> String {
    let mut s = String::from_str("<script>\n");
    s.push_str("// 1. GSAP ScrollTrigger & Kinetic Typography Initialization\n");
    s.push_str("        document.addEventListener('DOMContentLoaded', () => {\n");
    s.push_str("            gsap.registerPlugin(ScrollTrigger);\n");
    s.push_str("\n");
    s.push_str("            // Hero Kinetic Animations\n");
    s.push_str("            gsap.to('.hero-eyebrow', { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' });\n");
    s.push_str("            gsap.to('.hero-title .kinetic-word', {\n");
    s.push_str("                opacity: 1,\n");
    s.push_str("                y: 0,\n");
    s.push_str("                duration: 1.1,\n");
    s.push_str("                stagger: 0.08,\n");
    s.push_str("                ease: 'power4.out',\n");
    s.push_str("                delay: 0.15\n");
    s.push_str("            });\n");
    s.push_str("            gsap.to('.hero-desc', { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', delay: 0.5 });\n");
    s.push_str("            gsap.to('.hero-install-box', { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', delay: 0.65 });\n");
    s.push_str("\n");
    s.push_str("            // Stat Counter Animated Numbers on Scroll\n");
    s.push_str("            gsap.utils.toArray('.stat-card').forEach((card) => {\n");
    s.push_str("                const numEl = card.querySelector('.stat-number');\n");
    s.push_str("                const target = parseFloat(numEl.getAttribute('data-target'));\n");
    s.push_str("                const suffix = numEl.getAttribute('data-suffix') || '';\n");
    s.push_str("\n");
    s.push_str("                ScrollTrigger.create({\n");
    s.push_str("                    trigger: card,\n");
    s.push_str("                    start: 'top 85%',\n");
    s.push_str("                    onEnter: () => {\n");
    s.push_str("                        gsap.fromTo(numEl, \n");
    s.push_str("                            { textContent: 0 }, \n");
    s.push_str("                            {\n");
    s.push_str("                                duration: 1.8,\n");
    s.push_str("                                ease: 'power2.out',\n");
    s.push_str("                                textContent: target,\n");
    s.push_str("                                snap: { textContent: target % 1 === 0 ? 1 : 0.01 },\n");
    s.push_str("                                onUpdate: function() {\n");
    s.push_str("                                    numEl.textContent = parseFloat(this.targets()[0].textContent).toFixed(target % 1 === 0 ? 0 : 2) + suffix;\n");
    s.push_str("                                }\n");
    s.push_str("                            }\n");
    s.push_str("                        );\n");
    s.push_str("                    }\n");
    s.push_str("                });\n");
    s.push_str("            });\n");
    s.push_str("\n");
    s.push_str("            // Bento Cards 3D Mouse Spotlight Tilt\n");
    s.push_str("            document.querySelectorAll('.bento-card').forEach(card => {\n");
    s.push_str("                card.addEventListener('mousemove', e => {\n");
    s.push_str("                    const rect = card.getBoundingClientRect();\n");
    s.push_str("                    const x = e.clientX - rect.left;\n");
    s.push_str("                    const y = e.clientY - rect.top;\n");
    s.push_str("                    card.style.setProperty('--spotlight-x', `${x}px`);\n");
    s.push_str("                    card.style.setProperty('--spotlight-y', `${y}px`);\n");
    s.push_str("                });\n");
    s.push_str("            });\n");
    s.push_str("\n");
    s.push_str("            // 3D Mouse Parallax on Hero Lightning Mark\n");
    s.push_str("            const heroStage = document.getElementById('hero-mark-stage');\n");
    s.push_str("            const heroCard = document.getElementById('hero-mark-card');\n");
    s.push_str("            if (heroStage && heroCard) {\n");
    s.push_str("                heroStage.addEventListener('mousemove', e => {\n");
    s.push_str("                    const rect = heroStage.getBoundingClientRect();\n");
    s.push_str("                    const x = (e.clientX - rect.left) / rect.width - 0.5;\n");
    s.push_str("                    const y = (e.clientY - rect.top) / rect.height - 0.5;\n");
    s.push_str("                    gsap.to(heroCard, {\n");
    s.push_str("                        rotateY: x * 35,\n");
    s.push_str("                        rotateX: -y * 35,\n");
    s.push_str("                        duration: 0.3,\n");
    s.push_str("                        ease: 'power1.out'\n");
    s.push_str("                    });\n");
    s.push_str("                });\n");
    s.push_str("                heroStage.addEventListener('mouseleave', () => {\n");
    s.push_str("                    gsap.to(heroCard, { rotateY: 0, rotateX: 0, duration: 0.6, ease: 'power2.out' });\n");
    s.push_str("                });\n");
    s.push_str("            }\n");
    s.push_str("        });\n");
    s.push_str("\n");
    s.push_str("        // 2. Trailing Gold Cursor Movement\n");
    s.push_str("        const cursorDot = document.getElementById('cursor-dot');\n");
    s.push_str("        const cursorFollower = document.getElementById('cursor-follower');\n");
    s.push_str("        let mouseX = window.innerWidth / 2;\n");
    s.push_str("        let mouseY = window.innerHeight / 2;\n");
    s.push_str("        let followerX = mouseX;\n");
    s.push_str("        let followerY = mouseY;\n");
    s.push_str("\n");
    s.push_str("        window.addEventListener('mousemove', e => {\n");
    s.push_str("            mouseX = e.clientX;\n");
    s.push_str("            mouseY = e.clientY;\n");
    s.push_str("            cursorDot.style.left = `${mouseX}px`;\n");
    s.push_str("            cursorDot.style.top = `${mouseY}px`;\n");
    s.push_str("        });\n");
    s.push_str("\n");
    s.push_str("        function animateCursor() {\n");
    s.push_str("            followerX += (mouseX - followerX) * 0.15;\n");
    s.push_str("            followerY += (mouseY - followerY) * 0.15;\n");
    s.push_str("            cursorFollower.style.left = `${followerX}px`;\n");
    s.push_str("            cursorFollower.style.top = `${followerY}px`;\n");
    s.push_str("            requestAnimationFrame(animateCursor);\n");
    s.push_str("        }\n");
    s.push_str("        animateCursor();\n");
    s.push_str("\n");
    s.push_str("        // Cursor scaling on links & buttons\n");
    s.push_str("        document.querySelectorAll('a, button, input').forEach(el => {\n");
    s.push_str("            el.addEventListener('mouseenter', () => {\n");
    s.push_str("                cursorFollower.style.width = '64px';\n");
    s.push_str("                cursorFollower.style.height = '64px';\n");
    s.push_str("                cursorFollower.style.borderColor = 'rgba(255, 215, 0, 0.8)';\n");
    s.push_str("            });\n");
    s.push_str("            el.addEventListener('mouseleave', () => {\n");
    s.push_str("                cursorFollower.style.width = '40px';\n");
    s.push_str("                cursorFollower.style.height = '40px';\n");
    s.push_str("                cursorFollower.style.borderColor = 'rgba(255, 215, 0, 0.45)';\n");
    s.push_str("            });\n");
    s.push_str("        });\n");
    s.push_str("\n");
    s.push_str("        // 3. Interactive Floating Gold Particles Canvas\n");
    s.push_str("        const canvas = document.getElementById('bg-canvas');\n");
    s.push_str("        const ctx = canvas.getContext('2d');\n");
    s.push_str("        let width = canvas.width = window.innerWidth;\n");
    s.push_str("        let height = canvas.height = window.innerHeight;\n");
    s.push_str("\n");
    s.push_str("        window.addEventListener('resize', () => {\n");
    s.push_str("            width = canvas.width = window.innerWidth;\n");
    s.push_str("            height = canvas.height = window.innerHeight;\n");
    s.push_str("        });\n");
    s.push_str("\n");
    s.push_str("        const particles = [];\n");
    s.push_str("        const PARTICLE_COUNT = 65;\n");
    s.push_str("\n");
    s.push_str("        for (let i = 0; i < PARTICLE_COUNT; i++) {\n");
    s.push_str("            particles.push({\n");
    s.push_str("                x: Math.random() * width,\n");
    s.push_str("                y: Math.random() * height,\n");
    s.push_str("                size: Math.random() * 2.2 + 0.6,\n");
    s.push_str("                speedY: Math.random() * -0.6 - 0.2,\n");
    s.push_str("                speedX: (Math.random() - 0.5) * 0.3,\n");
    s.push_str("                alpha: Math.random() * 0.6 + 0.2,\n");
    s.push_str("                glow: Math.random() > 0.6\n");
    s.push_str("            });\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        function renderCanvas() {\n");
    s.push_str("            ctx.clearRect(0, 0, width, height);\n");
    s.push_str("\n");
    s.push_str("            particles.forEach(p => {\n");
    s.push_str("                p.y += p.speedY;\n");
    s.push_str("                p.x += p.speedX;\n");
    s.push_str("\n");
    s.push_str("                if (p.y < 0) {\n");
    s.push_str("                    p.y = height;\n");
    s.push_str("                    p.x = Math.random() * width;\n");
    s.push_str("                }\n");
    s.push_str("                if (p.x < 0) p.x = width;\n");
    s.push_str("                if (p.x > width) p.x = 0;\n");
    s.push_str("\n");
    s.push_str("                ctx.beginPath();\n");
    s.push_str("                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n");
    s.push_str("                ctx.fillStyle = `rgba(255, 215, 0, ${p.alpha})`;\n");
    s.push_str("                if (p.glow) {\n");
    s.push_str("                    ctx.shadowColor = '#ffd700';\n");
    s.push_str("                    ctx.shadowBlur = 10;\n");
    s.push_str("                } else {\n");
    s.push_str("                    ctx.shadowBlur = 0;\n");
    s.push_str("                }\n");
    s.push_str("                ctx.fill();\n");
    s.push_str("            });\n");
    s.push_str("\n");
    s.push_str("            requestAnimationFrame(renderCanvas);\n");
    s.push_str("        }\n");
    s.push_str("        renderCanvas();\n");
    s.push_str("\n");
    s.push_str("        // 4. Installer Tab Switcher\n");
    s.push_str("        const installCommands = {\n");
    s.push_str("            'npm': 'npm install -g vanta-lang',\n");
    s.push_str("            'curl': 'curl -fsSL https://raw.githubusercontent.com/Looka-info/Venta/main/scripts/install.sh | bash',\n");
    s.push_str("            'source': 'git clone https://github.com/Looka-info/Venta.git && cd Venta && cargo build --release'\n");
    s.push_str("        };\n");
    s.push_str("\n");
    s.push_str("        function switchInstallTab(key, btn) {\n");
    s.push_str("            document.querySelectorAll('.install-tab-btn').forEach(b => b.classList.remove('active'));\n");
    s.push_str("            btn.classList.add('active');\n");
    s.push_str("            document.getElementById('install-cmd-text').textContent = installCommands[key];\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        function copyInstallCmd() {\n");
    s.push_str("            const txt = document.getElementById('install-cmd-text').textContent;\n");
    s.push_str("            navigator.clipboard.writeText(txt);\n");
    s.push_str("            const label = document.getElementById('copy-btn-label');\n");
    s.push_str("            label.textContent = 'Copied!';\n");
    s.push_str("            setTimeout(() => { label.textContent = 'Copy'; }, 2000);\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        // 5. Code Studio Snippets & Live Runner\n");
    s.push_str("        const studioSnippets = {\n");
    s.push_str("            'main': `<span class=\"comment\">// ⚡ Venta Systems Programming Language — Pure Affine Safety</span>\n");
    s.push_str("<span class=\"kw\">struct</span> <span class=\"ty\">SensorPacket</span> {\n");
    s.push_str("    sensor_id: <span class=\"ty\">i64</span>,\n");
    s.push_str("    reading: <span class=\"ty\">i64</span>,\n");
    s.push_str("}\n");
    s.push_str("\n");
    s.push_str("<span class=\"kw\">fn</span> <span class=\"fn\">process_telemetry</span>(packet: &<span class=\"ty\">SensorPacket</span>) -> <span class=\"ty\">i64</span> {\n");
    s.push_str("    <span class=\"comment\">// Immutable borrow: zero allocation overhead</span>\n");
    s.push_str("    <span class=\"kw\">return</span> packet.reading * <span class=\"num\">2</span> + <span class=\"num\">42</span>;\n");
    s.push_str("}\n");
    s.push_str("\n");
    s.push_str("<span class=\"kw\">fn</span> <span class=\"fn\">main</span>() -> <span class=\"ty\">i64</span> {\n");
    s.push_str("    <span class=\"kw\">let</span> packet = <span class=\"ty\">SensorPacket</span> { sensor_id: <span class=\"num\">101</span>, reading: <span class=\"num\">450</span> };\n");
    s.push_str("    <span class=\"kw\">let</span> calibrated = <span class=\"fn\">process_telemetry</span>(&packet);\n");
    s.push_str("    <span class=\"fn\">print_str</span>(<span class=\"str\">\"⚡ Sensor telemetry processed: \"</span>);\n");
    s.push_str("    <span class=\"fn\">print_i64</span>(calibrated);\n");
    s.push_str("    <span class=\"fn\">print_str</span>(<span class=\"str\">\"\\n\"</span>);\n");
    s.push_str("    <span class=\"kw\">return</span> <span class=\"num\">0</span>;\n");
    s.push_str("}`,\n");
    s.push_str("            'server': `<span class=\"comment\">// ⚡ VentaNext Framework — Pure Venta HTTP Engine</span>\n");
    s.push_str("<span class=\"kw\">import</span> ventanext::http::{<span class=\"ty\">Request</span>, <span class=\"ty\">Response</span>};\n");
    s.push_str("<span class=\"kw\">import</span> ventanext::router::<span class=\"ty\">Router</span>;\n");
    s.push_str("\n");
    s.push_str("<span class=\"kw\">pub fn</span> <span class=\"fn\">handle_api_metrics</span>(req: &<span class=\"ty\">Request</span>) -> <span class=\"ty\">Response</span> {\n");
    s.push_str("    <span class=\"comment\">// Return JSON with zero runtime overhead</span>\n");
    s.push_str("    <span class=\"kw\">return</span> <span class=\"ty\">Response</span>::<span class=\"fn\">json</span>(<span class=\"str\">\"{\\\"compiler\\\": \\\"vantac\\\", \\\"version\\\": \\\"1.0-RC2\\\", \\\"passes\\\": 14}\"</span>);\n");
    s.push_str("}\n");
    s.push_str("\n");
    s.push_str("<span class=\"kw\">fn</span> <span class=\"fn\">main</span>() -> <span class=\"ty\">i64</span> {\n");
    s.push_str("    <span class=\"kw\">let mut</span> app = <span class=\"ty\">Router</span>::<span class=\"fn\">new</span>();\n");
    s.push_str("    app.<span class=\"fn\">get</span>(<span class=\"str\">\"/api/metrics\"</span>, handle_api_metrics);\n");
    s.push_str("    app.<span class=\"fn\">listen</span>(<span class=\"num\">3000</span>);\n");
    s.push_str("    <span class=\"kw\">return</span> <span class=\"num\">0</span>;\n");
    s.push_str("}`,\n");
    s.push_str("            'traits': `<span class=\"comment\">// ⚡ Zero-Cost Polymorphism via Traits</span>\n");
    s.push_str("<span class=\"kw\">trait</span> <span class=\"ty\">Accelerated</span> {\n");
    s.push_str("    <span class=\"kw\">fn</span> <span class=\"fn\">compute_kernel</span>(self: &Self) -> <span class=\"ty\">i64</span>;\n");
    s.push_str("}\n");
    s.push_str("\n");
    s.push_str("<span class=\"kw\">struct</span> <span class=\"ty\">ComputeUnit</span> {\n");
    s.push_str("    cores: <span class=\"ty\">i64</span>,\n");
    s.push_str("    frequency_mhz: <span class=\"ty\">i64</span>,\n");
    s.push_str("}\n");
    s.push_str("\n");
    s.push_str("<span class=\"kw\">impl</span> <span class=\"ty\">Accelerated</span> <span class=\"kw\">for</span> <span class=\"ty\">ComputeUnit</span> {\n");
    s.push_str("    <span class=\"kw\">fn</span> <span class=\"fn\">compute_kernel</span>(self: &Self) -> <span class=\"ty\">i64</span> {\n");
    s.push_str("        <span class=\"kw\">return</span> self.cores * self.frequency_mhz;\n");
    s.push_str("    }\n");
    s.push_str("}`,\n");
    s.push_str("            'gpu': `<span class=\"comment\">// ⚡ High-Throughput Matrix Multiply in Venta</span>\n");
    s.push_str("<span class=\"kw\">fn</span> <span class=\"fn\">matrix_vector_mul</span>(matrix: &[<span class=\"ty\">i64</span>], vec: &[<span class=\"ty\">i64</span>], size: <span class=\"ty\">i64</span>) -> [<span class=\"ty\">i64</span>; <span class=\"num\">4</span>] {\n");
    s.push_str("    <span class=\"kw\">let mut</span> result = [<span class=\"num\">0</span>, <span class=\"num\">0</span>, <span class=\"num\">0</span>, <span class=\"num\">0</span>];\n");
    s.push_str("    <span class=\"kw\">for</span> i <span class=\"kw\">in</span> <span class=\"num\">0</span>..size {\n");
    s.push_str("        <span class=\"kw\">for</span> j <span class=\"kw\">in</span> <span class=\"num\">0</span>..size {\n");
    s.push_str("            result[i] = result[i] + matrix[i * size + j] * vec[j];\n");
    s.push_str("        }\n");
    s.push_str("    }\n");
    s.push_str("    <span class=\"kw\">return</span> result;\n");
    s.push_str("}`\n");
    s.push_str("        };\n");
    s.push_str("\n");
    s.push_str("        function switchStudioTab(key, btn) {\n");
    s.push_str("            document.querySelectorAll('.studio-tab').forEach(b => b.classList.remove('active'));\n");
    s.push_str("            btn.classList.add('active');\n");
    s.push_str("            document.getElementById('studio-code-display').innerHTML = studioSnippets[key];\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        function runStudioCode() {\n");
    s.push_str("            const status = document.getElementById('studio-terminal-status');\n");
    s.push_str("            status.textContent = 'Compiling with vantac (SSA passes 1..14)...';\n");
    s.push_str("            status.style.color = 'var(--gold-core)';\n");
    s.push_str("            setTimeout(() => {\n");
    s.push_str("                status.textContent = '⚡ Executed in 3.1ms • Exit code 0 (Process OK)';\n");
    s.push_str("                status.style.color = '#34d399';\n");
    s.push_str("            }, 300);\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        // 6. Benchmark Data Switcher\n");
    s.push_str("        const benchData = {\n");
    s.push_str("            'compile': [\n");
    s.push_str("                { lang: '⚡ Venta', val: '0.24s', width: '10%', highlight: true },\n");
    s.push_str("                { lang: '🦀 Rust', val: '1.82s', width: '75%', highlight: false },\n");
    s.push_str("                { lang: '🐹 Go', val: '0.85s', width: '35%', highlight: false },\n");
    s.push_str("                { lang: '⚙️ C++ (Clang)', val: '2.41s', width: '100%', highlight: false }\n");
    s.push_str("            ],\n");
    s.push_str("            'size': [\n");
    s.push_str("                { lang: '⚡ Venta', val: '22.5 KB', width: '3%', highlight: true },\n");
    s.push_str("                { lang: '⚙️ C++ (Gcc)', val: '48.2 KB', width: '6%', highlight: false },\n");
    s.push_str("                { lang: '🦀 Rust', val: '4.2 MB', width: '45%', highlight: false },\n");
    s.push_str("                { lang: '🐹 Go', val: '14.1 MB', width: '100%', highlight: false }\n");
    s.push_str("            ],\n");
    s.push_str("            'mem': [\n");
    s.push_str("                { lang: '⚡ Venta', val: '1.2 MB', width: '5%', highlight: true },\n");
    s.push_str("                { lang: '⚙️ C++', val: '2.8 MB', width: '12%', highlight: false },\n");
    s.push_str("                { lang: '🐹 Go', val: '18.4 MB', width: '55%', highlight: false },\n");
    s.push_str("                { lang: '🐍 Python', val: '24.2 MB', width: '100%', highlight: false }\n");
    s.push_str("            ]\n");
    s.push_str("        };\n");
    s.push_str("\n");
    s.push_str("        function switchBench(key, btn) {\n");
    s.push_str("            document.querySelectorAll('.bench-tab').forEach(b => b.classList.remove('active'));\n");
    s.push_str("            btn.classList.add('active');\n");
    s.push_str("            const container = document.getElementById('bench-content');\n");
    s.push_str("            container.innerHTML = '';\n");
    s.push_str("            benchData[key].forEach(row => {\n");
    s.push_str("                const el = document.createElement('div');\n");
    s.push_str("                el.className = 'bench-row';\n");
    s.push_str("                el.innerHTML = `\n");
    s.push_str("                    <div class=\"bench-lang\">${row.lang}</div>\n");
    s.push_str("                    <div class=\"bench-track\">\n");
    s.push_str("                        <div class=\"bench-fill ${row.highlight ? 'fill-vanta' : 'fill-other'}\" style=\"width: ${row.width};\"></div>\n");
    s.push_str("                    </div>\n");
    s.push_str("                    <div class=\"bench-val\" style=\"${row.highlight ? 'color: var(--gold-core);' : ''}\">${row.val}</div>\n");
    s.push_str("                `;\n");
    s.push_str("                container.appendChild(el);\n");
    s.push_str("            });\n");
    s.push_str("        }\n");
    s.push_str("\n");
    s.push_str("        // 7. Interactive CLI Simulator\n");
    s.push_str("        const cliOutput = document.getElementById('cli-output');\n");
    s.push_str("        const cliInput = document.getElementById('cli-user-input');\n");
    s.push_str("\n");
    s.push_str("        const cliCommands = {\n");
    s.push_str("            'help': 'Available commands:\\n  vanta --version       Display compiler release & commit hash\\n  vanta check           Run affine borrow checker & AST validator\\n  vanta build --release Compile with all 14 SSA optimization passes\\n  vanta run             Compile and run standalone ELF64 binary\\n  clear                 Clear terminal window',\n");
    s.push_str("            'vanta --version': 'vanta 1.0.0-rc.2 (x86_64-unknown-linux-gnu)\\ncommit: 3014dbd (main)\\nbackend: Pure System V AMD64 ELF Emitter\\npasses: 14 SSA optimization stages active',\n");
    s.push_str("            'vanta check': 'Checking main.va (0.012s)...\\n[OK] Syntax Tree valid\\n[OK] Semantic Analysis: 0 errors\\n[OK] Affine Lifetimes: 0 borrow conflicts\\nReady for code generation.',\n");
    s.push_str("            'vanta build --release': 'Compiling main.va -> bin/main\\n  [1/4] Frontend parsing: 0.018s\\n  [2/4] MIR Lowering & Verification: 0.024s\\n  [3/4] 14-Pass SSA Optimizer: 0.112s\\n  [4/4] Machine Code ELF64 Writer: 0.086s\\n✨ Finished release [optimized] in 0.24s (Binary size: 22.5 KB)',\n");
    s.push_str("            'vanta run': '⚡ Executing ./bin/main...\\nSensor telemetry processed: 942\\nProgram exited cleanly with code 0 in 2.8ms.',\n");
    s.push_str("            'vanta': 'Usage: vanta <command> [options]\\nCommands: new, check, build, run, test, fmt'\n");
    s.push_str("        };\n");
    s.push_str("\n");
    s.push_str("        cliInput.addEventListener('keydown', e => {\n");
    s.push_str("            if (e.key === 'Enter') {\n");
    s.push_str("                const cmd = cliInput.value.trim();\n");
    s.push_str("                if (!cmd) return;\n");
    s.push_str("\n");
    s.push_str("                // Echo command\n");
    s.push_str("                const echo = document.createElement('div');\n");
    s.push_str("                echo.innerHTML = `<span class=\"cli-prompt\">user@dev:~/demo$</span> <span>${cmd}</span>`;\n");
    s.push_str("                cliOutput.appendChild(echo);\n");
    s.push_str("\n");
    s.push_str("                // Handle command\n");
    s.push_str("                const response = document.createElement('div');\n");
    s.push_str("                response.style.color = '#9ca3af';\n");
    s.push_str("                response.style.margin = '4px 0 12px';\n");
    s.push_str("\n");
    s.push_str("                if (cmd === 'clear') {\n");
    s.push_str("                    cliOutput.innerHTML = '';\n");
    s.push_str("                } else if (cliCommands[cmd]) {\n");
    s.push_str("                    response.innerHTML = cliCommands[cmd].replace(/\\n/g, '<br>');\n");
    s.push_str("                    cliOutput.appendChild(response);\n");
    s.push_str("                } else {\n");
    s.push_str("                    response.innerHTML = `<span style=\"color: #ef4444;\">vanta: unknown command '${cmd}'. Type 'help' for available commands.</span>`;\n");
    s.push_str("                    cliOutput.appendChild(response);\n");
    s.push_str("                }\n");
    s.push_str("\n");
    s.push_str("                cliInput.value = '';\n");
    s.push_str("                cliOutput.scrollTop = cliOutput.scrollHeight;\n");
    s.push_str("            }\n");
    s.push_str("        });\n");
    s.push_str("</script>\n");
    s
}
