// ============================================================================
// ⚡ Venta Web Client Scripts Module (100% Pure Venta)
// GSAP 3.12+ ScrollTrigger, Lenis Smooth Scroll, Interactive Tabs, & Timelines
// ============================================================================

import std::string::String;

pub fn get_client_scripts() -> String {
    let mut s = String::from_str("<script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js\"></script>\n");
    s.push_str("<script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js\"></script>\n");
    s.push_str("<script src=\"https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js\"></script>\n");
    s.push_str("<script>\n");
    s.push_str("(function(){\n");
    s.push_str("  var rm = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n");
    s.push_str("  var big = document.getElementById(\"big\");\n");
    s.push_str("  \"Venta\".split(\"\").forEach(function(ch){\n");
    s.push_str("    var m=document.createElement(\"span\");m.className=\"m\";var s=document.createElement(\"span\");s.textContent=ch;m.appendChild(s);big.appendChild(m);\n");
    s.push_str("  });\n");
    s.push_str("  document.querySelectorAll(\"[data-copy]\").forEach(function(b){\n");
    s.push_str("    b.addEventListener(\"click\",function(){\n");
    s.push_str("      var t=b.getAttribute(\"data-copy\");\n");
    s.push_str("      try{navigator.clipboard.writeText(t)}catch(e){}\n");
    s.push_str("      b.textContent=\"Copied\";setTimeout(function(){b.textContent=\"Copy\"},1400);\n");
    s.push_str("    });\n");
    s.push_str("  });\n\n");

    // Code tabs
    s.push_str("  /* code tabs */\n");
    s.push_str("  var tabs=document.querySelectorAll(\"#tabs .tab\"),panes=[\"pre\",\"p1\",\"p2\",\"p3\"].map(function(id){return document.getElementById(id)}),stat=document.getElementById(\"stat\"),stx=document.getElementById(\"stx\");\n");
    s.push_str("  var ST=[[\"\",\"error E0301: use of moved value\"],[\"ok\",\"Compiles: one borrow, then one move\"],[\"n\",\"Algebraic data types with payloads, taken apart with match\"],[\"n\",\"Traits with zero-cost polymorphism\"]];\n");
    s.push_str("  tabs.forEach(function(t,i){t.addEventListener(\"click\",function(){\n");
    s.push_str("    panes.forEach(function(p,k){p.hidden=k!==i});\n");
    s.push_str("    tabs.forEach(function(b,k){b.setAttribute(\"aria-selected\",k===i?\"true\":\"false\")});\n");
    s.push_str("    stat.className=\"stat \"+ST[i][0];stx.textContent=ST[i][1];\n");
    s.push_str("    if(window.ScrollTrigger)ScrollTrigger.refresh();\n");
    s.push_str("  })});\n\n");

    // Runtime Explorer
    s.push_str("  /* runtime explorer (median ms, lower is better: Venta -O1, GCC -O3, Rust -O3) */\n");
    s.push_str("  var D={unroll_peel:[19.36,6.12,7.89],sroa:[29.75,6.03,7.86],licm:[112.23,58.96,83.03],cse:[46.40,30.67,30.80],inline_leaf:[43.47,20.99,19.52],lsr:[45.98,5.69,7.90],tco:[42.70,37.00,43.83],reg_pressure:[34.88,23.03,19.23],inline_loop:[7.37,5.97,8.04],arith_tree:[15.16,12.35,13.44],collatz:[310.75,76.83,59.89],points:[11.76,9.42,11.72],vec_churn:[21.54,7.17,9.81],string_growth:[6.24,6.31,8.25],fib:[335.86,91.88,95.62]};\n");
    s.push_str("  var names=Object.keys(D),chipBox=document.getElementById(\"chips\"),rrs=document.querySelectorAll(\"#rb .rr\"),rv=document.getElementById(\"rv\"),sb=document.getElementById(\"sb\");\n");
    s.push_str("  var wr=0,wg=0;names.forEach(function(n){if(D[n][0]<D[n][2])wr++;if(D[n][0]<D[n][1])wg++});\n");
    s.push_str("  sb.textContent=\"Venta beats Rust on \"+wr+\" of \"+names.length+\" workloads and GCC on \"+wg+\".\";\n");
    s.push_str("  function cmp(x,who){if(x<.97)return (1/x).toFixed(1)+\"x faster than \"+who;if(x>1.03)return x.toFixed(1)+\"x slower than \"+who;return \"level with \"+who}\n");
    s.push_str("  function show(n){\n");
    s.push_str("    var d=D[n],mx=Math.max.apply(null,d);\n");
    s.push_str("    rrs.forEach(function(r,i){r.querySelector(\".f\").style.width=(d[i]/mx*100)+\"%\";r.querySelector(\".n\").textContent=d[i].toFixed(2)+\" ms\"});\n");
    s.push_str("    rv.textContent=n+\": Venta is \"+cmp(d[0]/d[1],\"GCC\")+\" and \"+cmp(d[0]/d[2],\"Rust\")+\".\";\n");
    s.push_str("    chipBox.querySelectorAll(\".chip\").forEach(function(c){c.setAttribute(\"aria-pressed\",c.textContent===n?\"true\":\"false\")});\n");
    s.push_str("  }\n");
    s.push_str("  names.forEach(function(n){var b=document.createElement(\"button\");b.className=\"chip\";b.type=\"button\";b.textContent=n;b.setAttribute(\"aria-pressed\",\"false\");b.addEventListener(\"click\",function(){show(n)});chipBox.appendChild(b)});\n");
    s.push_str("  if(\"IntersectionObserver\" in window){var io=new IntersectionObserver(function(e){if(e[0].isIntersecting){show(\"fib\");io.disconnect()}},{threshold:.4});io.observe(document.getElementById(\"rb\"))}else{show(\"fib\")}\n\n");

    // Reduced motion handling
    s.push_str("  if(rm){\n");
    s.push_str("    document.documentElement.classList.add(\"rm\");\n");
    s.push_str("    document.querySelectorAll(\".br .f\").forEach(function(f,i){f.style.transform=\"scaleX(\"+(parseFloat(f.parentNode.parentNode.dataset.v)/4.19)+\")\"});\n");
    s.push_str("    document.querySelectorAll(\".ln\").forEach(function(l){l.style.opacity=1});\n");
    s.push_str("    return;\n");
    s.push_str("  }\n");
    s.push_str("  if(!window.gsap||!window.ScrollTrigger){return}\n");
    s.push_str("  gsap.registerPlugin(ScrollTrigger);\n\n");

    // Lenis Smooth Scroll
    s.push_str("  try{\n");
    s.push_str("    var lenis=new Lenis({lerp:.09});\n");
    s.push_str("    lenis.on(\"scroll\",ScrollTrigger.update);\n");
    s.push_str("    gsap.ticker.add(function(t){lenis.raf(t*1000)});\n");
    s.push_str("    gsap.ticker.lagSmoothing(0);\n");
    s.push_str("  }catch(e){}\n\n");

    // Hero Reveal
    s.push_str("  /* hero: one orchestrated reveal */\n");
    s.push_str("  gsap.to(\"#big .m span\",{y:0,duration:1.3,ease:\"expo.out\",stagger:.09,delay:.15});\n");
    s.push_str("  gsap.to(\"#big\",{yPercent:-12,ease:\"none\",scrollTrigger:{trigger:\".hero\",start:\"top top\",end:\"bottom top\",scrub:true}});\n\n");

    // Statement Pinning
    s.push_str("  /* statements, pinned */\n");
    s.push_str("  var ws=gsap.utils.toArray(\"#stmt .w\");\n");
    s.push_str("  var tl=gsap.timeline({scrollTrigger:{trigger:\"#stmt\",start:\"top top\",end:\"+=220%\",pin:true,scrub:.6}});\n");
    s.push_str("  ws.forEach(function(w,i){\n");
    s.push_str("    tl.fromTo(w,{opacity:0,yPercent:18,filter:\"blur(12px)\"},{opacity:1,yPercent:0,filter:\"blur(0px)\",duration:1,ease:\"power2.out\"});\n");
    s.push_str("    if(i<ws.length-1){tl.to(w,{opacity:0,yPercent:-18,filter:\"blur(12px)\",duration:1,ease:\"power2.in\"},\"+=.6\")}\n");
    s.push_str("  });\n\n");

    // Marquee scroll
    s.push_str("  /* marquee driven by scroll */\n");
    s.push_str("  gsap.to(\"#mq\",{xPercent:-45,ease:\"none\",scrollTrigger:{trigger:\".mq\",start:\"top bottom\",end:\"bottom top\",scrub:true}});\n\n");

    // Horizontal Scroll
    s.push_str("  /* horizontal scroll */\n");
    s.push_str("  var track=document.getElementById(\"track\");\n");
    s.push_str("  var dist=function(){return Math.max(0,track.scrollWidth-window.innerWidth)};\n");
    s.push_str("  gsap.to(track,{x:function(){return -dist()},ease:\"none\",scrollTrigger:{trigger:\"#hs\",start:\"top top\",end:function(){return \"+=\"+dist()},pin:true,scrub:.8,invalidateOnRefresh:true,anticipatePin:1}});\n");
    s.push_str("  gsap.to(\"#hbar\",{scaleX:1,ease:\"none\",scrollTrigger:{trigger:\"#hs\",start:\"top top\",end:function(){return \"+=\"+dist()},scrub:true,invalidateOnRefresh:true}});\n\n");

    // Code lines scrub
    s.push_str("  /* code lines light up while pinned */\n");
    s.push_str("  var lines=gsap.utils.toArray(\"#pre .ln\");\n");
    s.push_str("  var ctl=gsap.timeline({scrollTrigger:{trigger:\"#code .code\",start:\"top 70%\",end:\"bottom 35%\",scrub:.5}});\n");
    s.push_str("  lines.forEach(function(l){ctl.to(l,{opacity:1,duration:1,ease:\"none\"})});\n\n");

    // Optimizer bars and counters
    s.push_str("  /* bars + counters */\n");
    s.push_str("  gsap.utils.toArray(\".br\").forEach(function(b,i){\n");
    s.push_str("    var v=parseFloat(b.dataset.v)/4.19;\n");
    s.push_str("    gsap.to(b.querySelector(\".f\"),{scaleX:v,duration:1.2,ease:\"power3.out\",delay:i*.05,scrollTrigger:{trigger:\"#bars\",start:\"top 80%\",once:true}});\n");
    s.push_str("  });\n");
    s.push_str("  gsap.utils.toArray(\".cnt\").forEach(function(c){\n");
    s.push_str("    var to=parseFloat(c.dataset.to),d=parseInt(c.dataset.d,10),o={v:0};\n");
    s.push_str("    gsap.to(o,{v:to,duration:1.6,ease:\"power2.out\",scrollTrigger:{trigger:c,start:\"top 85%\",once:true},onUpdate:function(){c.textContent=o.v.toFixed(d)}});\n");
    s.push_str("  });\n\n");

    // Pipeline scrub
    s.push_str("  /* pipeline, pinned */\n");
    s.push_str("  var pl=gsap.utils.toArray(\"#pl li\"),pn=document.getElementById(\"pn\"),pd=document.getElementById(\"pd\"),cur=-1;\n");
    s.push_str("  function setP(i){\n");
    s.push_str("    if(i===cur)return;cur=i;\n");
    s.push_str("    pl.forEach(function(li,k){li.classList.toggle(\"on\",k===i);li.classList.toggle(\"done\",k<i)});\n");
    s.push_str("    pn.textContent=pl[i].firstChild.textContent;pd.textContent=pl[i].dataset.d;\n");
    s.push_str("    gsap.fromTo([pn,pd],{yPercent:14,opacity:0},{yPercent:0,opacity:1,duration:.4,ease:\"power3.out\",overwrite:true});\n");
    s.push_str("  }\n");
    s.push_str("  setP(0);\n");
    s.push_str("  ScrollTrigger.create({trigger:\"#pipe\",start:\"top top\",end:\"+=320%\",pin:true,onUpdate:function(s){setP(Math.min(pl.length-1,Math.floor(s.progress*pl.length)))}});\n\n");

    // Optimizer sweep
    s.push_str("  /* optimizer sweep */\n");
    s.push_str("  var cells=gsap.utils.toArray(\".opt div\");\n");
    s.push_str("  ScrollTrigger.create({trigger:\".opt\",start:\"top 75%\",end:\"bottom 40%\",scrub:true,onUpdate:function(s){var n=Math.max(1,Math.round(s.progress*cells.length));cells.forEach(function(c,i){c.classList.toggle(\"lit\",s.progress>0&&i===n-1)})}});\n\n");

    // Footer headline
    s.push_str("  /* footer headline */\n");
    s.push_str("  gsap.from(\".fin h2\",{yPercent:30,opacity:0,ease:\"none\",scrollTrigger:{trigger:\".fin\",start:\"top 90%\",end:\"top 40%\",scrub:true}});\n\n");

    s.push_str("  var refresh=function(){ScrollTrigger.refresh()};\n");
    s.push_str("  if(document.fonts&&document.fonts.ready){document.fonts.ready.then(refresh)}\n");
    s.push_str("  window.addEventListener(\"load\",refresh);\n");
    s.push_str("})();\n");
    s.push_str("</script>\n");
    s
}
