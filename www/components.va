// ============================================================================
// ⚡ Venta Web UI Components Module (in Pure Venta)
// Composable, declarative UI components authored 100% in pure Venta
// ============================================================================

import std::string::String;
import dom::{Element, div, section, header, nav, footer, make_element};

// 1. Glassmorphic Floating Navigation Component
pub fn render_navbar() -> Element {
    let mut wrapper = header();
    wrapper.set_class("nav-wrapper");

    let mut pill = nav();
    pill.set_class("nav-pill");

    // Brand
    pill.add_raw("<a href=\"#\" class=\"nav-brand\"><img src=\"vanta-file-icon.svg\" alt=\"Venta\"><span>VENTA</span></a>");

    // Links
    pill.add_raw("<ul class=\"nav-links\"><li><a href=\"#features\" class=\"nav-link\">Features</a></li><li><a href=\"#architecture\" class=\"nav-link\">Architecture</a></li><li><a href=\"#studio\" class=\"nav-link\">Code Studio</a></li><li><a href=\"#benchmarks\" class=\"nav-link\">Benchmarks</a></li><li><a href=\"#cli\" class=\"nav-link\">Terminal</a></li><li><a href=\"#vscode\" class=\"nav-link\">VS Code</a></li></ul>");

    // Actions
    pill.add_raw("<div class=\"nav-actions\"><span class=\"version-badge\"><span class=\"pulse-dot\"></span> v1.0-RC2</span><a href=\"#install\" class=\"btn-magnetic\">Get Venta ⚡</a></div>");

    wrapper.add_child(&pill);
    wrapper
}

// 2. Awwwards Kinetic Hero Component
pub fn render_hero() -> Element {
    let mut hero_sec = section();
    hero_sec.set_class("hero container");

    // Eyebrow
    hero_sec.add_raw("<div class=\"hero-eyebrow\"><img src=\"vanta-file-icon.svg\" alt=\".va\"><span>Venta Systems Programming Language • Next-Gen Compiler</span></div>");

    // Kinetic Title
    hero_sec.add_raw("<h1 class=\"hero-title\"><span class=\"kinetic-line\"><span class=\"kinetic-word\">Pure</span> <span class=\"kinetic-word gold-gradient-text\">Velocity.</span></span><span class=\"kinetic-line\"><span class=\"kinetic-word\">Absolute</span> <span class=\"kinetic-word\">Safety.</span></span><span class=\"kinetic-line\"><span class=\"kinetic-word\">Zero</span> <span class=\"kinetic-word gold-gradient-text\">Overhead.</span></span></h1>");

    // Subtitle
    hero_sec.add_raw("<p class=\"hero-desc\">A memory-safe systems programming language featuring a 14-pass SSA optimizer, native x86-64 machine code generation, and affine borrow semantics. Compiles in 0.24 seconds with zero LLVM bloat.</p>");

    // 3D Lightning Mark Stage
    hero_sec.add_raw("<div class=\"hero-mark-stage\" id=\"hero-mark-stage\"><div class=\"hero-mark-card\" id=\"hero-mark-card\"><img src=\"vanta-file-icon.svg\" alt=\"Venta 3D Gold Lightning Mark\" class=\"hero-bolt-img\"><div class=\"mark-badge-float mark-badge-left\">⚡ 0.24s Cold Compile</div><div class=\"mark-badge-float mark-badge-right\">📦 22.5 KB Native ELF</div></div></div>");

    // Tabbed Installer Box
    hero_sec.add_raw("<div class=\"hero-install-box\" id=\"install\"><div class=\"install-nav\"><button class=\"install-tab-btn active\" onclick=\"switchInstallTab('npm', this)\">Node / npm</button><button class=\"install-tab-btn\" onclick=\"switchInstallTab('curl', this)\">1-Line Curl</button><button class=\"install-tab-btn\" onclick=\"switchInstallTab('source', this)\">Source Build</button></div><div class=\"install-cmd-row\"><div><span class=\"dollar\">$</span><span id=\"install-cmd-text\">npm install -g vanta-lang</span></div><button class=\"btn-copy\" onclick=\"copyInstallCmd()\"><span id=\"copy-btn-label\">Copy</span></button></div></div>");

    // Stat Counters Ribbon
    hero_sec.add_raw("<div class=\"stat-ribbon\"><div class=\"stat-card\"><div class=\"stat-number\" data-target=\"0.24\" data-suffix=\"s\">0.00s</div><div class=\"stat-label\">Compile Speed</div><div class=\"stat-highlight\">7.5x faster than Rust</div></div><div class=\"stat-card\"><div class=\"stat-number\" data-target=\"22.5\" data-suffix=\" KB\">0.0 KB</div><div class=\"stat-label\">Binary Size</div><div class=\"stat-highlight\">520x smaller than Go</div></div><div class=\"stat-card\"><div class=\"stat-number\" data-target=\"14\" data-suffix=\" Passes\">0</div><div class=\"stat-label\">SSA Optimizer</div><div class=\"stat-highlight\">GVN • SROA • Inlining</div></div><div class=\"stat-card\"><div class=\"stat-number\" data-target=\"0.0\" data-suffix=\" ms\">0.0 ms</div><div class=\"stat-label\">Runtime Latency</div><div class=\"stat-highlight\">Zero GC / Bare-metal</div></div></div>");

    hero_sec
}

// 3. 3D Bento Grid Component
pub fn render_bento_grid() -> Element {
    let mut sec = section();
    sec.set_id("features");
    sec.set_class("section container");

    sec.add_raw("<div class=\"section-header\"><span class=\"section-tag\">Core Capabilities</span><h2 class=\"section-title\">Engineered for Hardware Mastery</h2><p class=\"section-desc\">Venta removes intermediate compiler layers to give you sub-second compilation, deterministic memory management, and pure bare-metal execution.</p></div>");

    let mut grid = div();
    grid.set_class("bento-grid");

    // Card 1: 14-Pass SSA Optimizer
    grid.add_raw("<div class=\"bento-card col-span-2\"><div class=\"bento-icon\"><img src=\"vanta-file-icon.svg\" alt=\"SSA\"></div><h3 class=\"bento-title\">14-Pass Mid-Level SSA Optimizer</h3><p class=\"bento-text\">A custom Static Single Assignment (SSA) optimization pipeline transforming high-level Control Flow Graphs (CFG) into hyper-efficient machine representation without LLVM overhead.</p><div class=\"pipeline-stream\"><span class=\"pass-chip\">1. GVN (Value Numbering)</span><span class=\"pass-chip\">2. SCCP (Constant Prop)</span><span class=\"pass-chip\">3. SROA (Scalar Replace)</span><span class=\"pass-chip\">4. Dead Code (DCE)</span><span class=\"pass-chip\">5. LICM (Loop Invariant)</span><span class=\"pass-chip\">6. LSR (Strength Reduct)</span><span class=\"pass-chip\">7. Function Inlining</span><span class=\"pass-chip\">8. Tail Call Opt (TCO)</span><span class=\"pass-chip\">9. Instruction Scheduling</span><span class=\"pass-chip\">10. Block Reordering</span></div></div>");

    // Card 2: Affine Ownership
    grid.add_raw("<div class=\"bento-card\"><div class=\"bento-icon\">🛡</div><h3 class=\"bento-title\">Affine Ownership & Lifetimes</h3><p class=\"bento-text\">Compile-time move semantics and non-overlapping borrow checking. Complete memory safety without garbage collection, ref-counting pauses, or runtime tracing.</p></div>");

    // Card 3: Native x86-64 Machine Code
    grid.add_raw("<div class=\"bento-card\"><div class=\"bento-icon\">⚡</div><h3 class=\"bento-title\">Native x86-64 Machine Code</h3><p class=\"bento-text\">Custom linear-scan register allocator and direct System V AMD64 ELF object writer producing standalone ~22.5 KB executables in 240 milliseconds.</p></div>");

    // Card 4: AI-First JSON Diagnostics
    grid.add_raw("<div class=\"bento-card\"><div class=\"bento-icon\">🤖</div><h3 class=\"bento-title\">AI-First JSON Diagnostics</h3><p class=\"bento-text\">Built-in <code>--emit-json</code> flag outputting machine-parseable syntax trees, spans, and type errors for pairing with AI coding agents and LLM tooling.</p></div>");

    // Card 5: VentaNext Framework
    grid.add_raw("<div class=\"bento-card\"><div class=\"bento-icon\">🌐</div><h3 class=\"bento-title\">VentaNext Framework</h3><p class=\"bento-text\">Next.js-style server-side rendering (SSR), dynamic route parameters, typed API handlers, and native HTTP 1.1 engine written 100% in pure Venta.</p></div>");

    sec.add_child(&grid);
    sec
}

// 4. Interactive Live Code Studio Component
pub fn render_code_studio() -> Element {
    let mut sec = section();
    sec.set_id("studio");
    sec.set_class("section container");

    sec.add_raw("<div class=\"section-header\"><span class=\"section-tag\">Interactive Environment</span><h2 class=\"section-title\">Clean Syntax. Zero Ceremony.</h2><p class=\"section-desc\">Experience expressive language ergonomics with familiar C-family syntax, zero-cost traits, and pattern matching.</p></div>");

    sec.add_raw("<div class=\"studio-wrapper\"><div class=\"studio-header\"><div class=\"studio-tabs\"><button class=\"studio-tab active\" onclick=\"switchStudioTab('main', this)\"><img src=\"vanta-file-icon.svg\" alt=\".va\"> main.va</button><button class=\"studio-tab\" onclick=\"switchStudioTab('server', this)\"><img src=\"vanta-file-icon.svg\" alt=\".va\"> server.va</button><button class=\"studio-tab\" onclick=\"switchStudioTab('traits', this)\"><img src=\"vanta-file-icon.svg\" alt=\".va\"> traits.va</button><button class=\"studio-tab\" onclick=\"switchStudioTab('gpu', this)\"><img src=\"vanta-file-icon.svg\" alt=\".va\"> gpu.va</button></div><div class=\"studio-actions\"><button class=\"btn-run\" onclick=\"runStudioCode()\"><span>▶ Run in Venta</span></button></div></div><div class=\"editor-body\"><pre class=\"code-pre\" id=\"studio-code-display\"><span class=\"comment\">// ⚡ Venta Systems Programming Language — Pure Affine Safety</span>\n<span class=\"kw\">struct</span> <span class=\"ty\">SensorPacket</span> {\n    sensor_id: <span class=\"ty\">i64</span>,\n    reading: <span class=\"ty\">i64</span>,\n}\n\n<span class=\"kw\">fn</span> <span class=\"fn\">process_telemetry</span>(packet: &<span class=\"ty\">SensorPacket</span>) -> <span class=\"ty\">i64</span> {\n    <span class=\"comment\">// Immutable borrow: zero allocation overhead</span>\n    <span class=\"kw\">return</span> packet.reading * <span class=\"num\">2</span> + <span class=\"num\">42</span>;\n}\n\n<span class=\"kw\">fn</span> <span class=\"fn\">main</span>() -> <span class=\"ty\">i64</span> {\n    <span class=\"kw\">let</span> packet = <span class=\"ty\">SensorPacket</span> { sensor_id: <span class=\"num\">101</span>, reading: <span class=\"num\">450</span> };\n    <span class=\"kw\">let</span> calibrated = <span class=\"fn\">process_telemetry</span>(&packet);\n    <span class=\"fn\">print_str</span>(<span class=\"str\">\"⚡ Sensor telemetry processed: \"</span>);\n    <span class=\"fn\">print_i64</span>(calibrated);\n    <span class=\"fn\">print_str</span>(<span class=\"str\">\"\\n\"</span>);\n    <span class=\"kw\">return</span> <span class=\"num\">0</span>;\n}</pre></div><div class=\"terminal-output\"><div><span>Status: </span><span class=\"out-success\" id=\"studio-terminal-status\">Compiled with vantac in 0.24s (0 errors)</span></div><div style=\"font-family: var(--font-code); font-size: 0.8rem; color: #6b7280;\">Target: Linux ELF64 (x86-64)</div></div></div>");

    sec
}

// 5. Interactive Benchmark Arena Component
pub fn render_benchmark_arena() -> Element {
    let mut sec = section();
    sec.set_id("benchmarks");
    sec.set_class("section container");

    sec.add_raw("<div class=\"section-header\"><span class=\"section-tag\">Performance Verification</span><h2 class=\"section-title\">Benchmarked Against the Industry</h2><p class=\"section-desc\">Independent benchmarks on Linux x86-64 (AMD Ryzen 9 7950X, 64GB DDR5).</p></div>");

    sec.add_raw("<div class=\"bench-wrapper\"><div class=\"bench-tabs\"><button class=\"bench-tab active\" onclick=\"switchBench('compile', this)\">Compilation Speed (s)</button><button class=\"bench-tab\" onclick=\"switchBench('size', this)\">Binary Footprint (KB)</button><button class=\"bench-tab\" onclick=\"switchBench('mem', this)\">Idle Memory (MB)</button></div><div class=\"bench-bar-group\" id=\"bench-content\"><div class=\"bench-row\"><div class=\"bench-lang\">⚡ Venta</div><div class=\"bench-track\"><div class=\"bench-fill fill-vanta\" style=\"width: 10%;\"></div></div><div class=\"bench-val\" style=\"color: var(--gold-core);\">0.24s</div></div><div class=\"bench-row\"><div class=\"bench-lang\">🦀 Rust</div><div class=\"bench-track\"><div class=\"bench-fill fill-other\" style=\"width: 75%;\"></div></div><div class=\"bench-val\">1.82s</div></div><div class=\"bench-row\"><div class=\"bench-lang\">🐹 Go</div><div class=\"bench-track\"><div class=\"bench-fill fill-other\" style=\"width: 35%;\"></div></div><div class=\"bench-val\">0.85s</div></div><div class=\"bench-row\"><div class=\"bench-lang\">⚙️ C++ (Clang)</div><div class=\"bench-track\"><div class=\"bench-fill fill-other\" style=\"width: 100%;\"></div></div><div class=\"bench-val\">2.41s</div></div></div></div>");

    sec
}

// 6. Interactive CLI Terminal Simulator Component
pub fn render_cli_simulator() -> Element {
    let mut sec = section();
    sec.set_id("cli");
    sec.set_class("section container");

    sec.add_raw("<div class=\"section-header\"><span class=\"section-tag\">Developer CLI</span><h2 class=\"section-title\">Interactive Terminal Playground</h2><p class=\"section-desc\">Type commands below to test Venta's unified driver and toolchain.</p></div>");

    sec.add_raw("<div class=\"cli-window\"><div class=\"cli-header\"><div class=\"cli-dot dot-red\"></div><div class=\"cli-dot dot-yellow\"></div><div class=\"cli-dot dot-green\"></div><span class=\"cli-title\">vanta-cli — x86_64-unknown-linux-gnu — bash</span></div><div class=\"cli-body\" id=\"cli-output\"><div style=\"color: #6b7280;\">Welcome to Venta Language Terminal (v1.0-RC2). Type <span style=\"color: var(--gold-core);\">help</span> for available commands.</div><div style=\"color: #6b7280; margin-bottom: 12px;\">Try: <span style=\"color: #38bdf8;\">vanta check</span>, <span style=\"color: #38bdf8;\">vanta build --release</span>, <span style=\"color: #38bdf8;\">vanta run</span>, <span style=\"color: #38bdf8;\">vanta --version</span></div></div><div style=\"padding: 0 24px 20px;\"><div class=\"cli-input-line\"><span class=\"cli-prompt\">user@dev:~/demo$</span><input type=\"text\" class=\"cli-input\" id=\"cli-user-input\" placeholder=\"Type a command (e.g. vanta build --release) and press Enter...\" autofocus></div></div></div>");

    sec
}

// 7. VS Code Extension & 3D Gold File Icon Showcase Component
pub fn render_vscode_section() -> Element {
    let mut sec = section();
    sec.set_id("vscode");
    sec.set_class("section container");

    sec.add_raw("<div class=\"bento-card\" style=\"text-align: center; max-width: 900px; margin: 0 auto; border-color: rgba(255, 215, 0, 0.4);\"><div style=\"margin-bottom: 24px;\"><img src=\"vanta-file-icon.svg\" alt=\"Venta File Icon\" style=\"width: 76px; height: 76px; filter: drop-shadow(0 0 25px rgba(255, 215, 0, 0.7));\"></div><h2 class=\"section-title\" style=\"font-size: 2.2rem; margin-bottom: 14px;\">Official VS Code Extension & 3D Gold File Icons</h2><p class=\"section-desc\" style=\"max-width: 680px; margin: 0 auto 30px;\">Enjoy complete TextMate syntax grammar, bracket autocompletion, and the glowing 3D gold faceted lightning file icon for all <code>.va</code> and <code>.vanta</code> files in your editor tabs and explorer.</p><div style=\"background: #090a10; border: 1px solid var(--border-gold); padding: 14px 24px; border-radius: 12px; font-family: var(--font-code); font-size: 0.9rem; max-width: 580px; margin: 0 auto 20px; display: flex; align-items: center; justify-content: space-between;\"><span>cp -r editors/vscode ~/.vscode/extensions/vanta-vscode</span><button class=\"btn-copy\" onclick=\"navigator.clipboard.writeText('cp -r editors/vscode ~/.vscode/extensions/vanta-vscode'); alert('Extension installation command copied!');\">Copy</button></div></div>");

    sec
}

// 8. Luxury Footer Component
pub fn render_footer() -> Element {
    let mut foot = footer();
    foot.set_class("footer");

    foot.add_raw("<div class=\"container\"><div class=\"footer-grid\"><div class=\"footer-brand\"><h3><img src=\"vanta-file-icon.svg\" alt=\"Venta Logo\">VENTA</h3><p>A performance-first, memory-safe systems programming language featuring a 14-pass SSA optimizer, native x86-64 backend, and affine borrow semantics.</p></div><div class=\"footer-col\"><h4>Language</h4><ul><li><a href=\"#features\">14-Pass SSA Optimizer</a></li><li><a href=\"#studio\">Ownership & Borrowing</a></li><li><a href=\"#benchmarks\">Benchmark Results</a></li><li><a href=\"#vscode\">VS Code Extension</a></li></ul></div><div class=\"footer-col\"><h4>Framework</h4><ul><li><a href=\"https://github.com/Looka-info/Venta/tree/main/ventanext\" target=\"_blank\">VentaNext Framework</a></li><li><a href=\"#studio\">SSR Component Engine</a></li><li><a href=\"https://www.npmjs.com/package/vanta-lang\" target=\"_blank\">NPM Package (v1.0)</a></li><li><a href=\"https://github.com/Looka-info/Venta/releases\" target=\"_blank\">Release Candidate (v1.0-RC2)</a></li></ul></div><div class=\"footer-col\"><h4>Ecosystem</h4><ul><li><a href=\"https://github.com/Looka-info/Venta\" target=\"_blank\">GitHub Repository</a></li><li><a href=\"LICENSE-MIT\">MIT License</a></li><li><a href=\"LICENSE-APACHE\">Apache 2.0 License</a></li><li><a href=\"docs/language-spec.md\">Language Specification</a></li></ul></div></div><div class=\"footer-bottom\"><div>⚡ <strong>Venta Systems Programming Language</strong> • Dual Licensed under MIT OR Apache-2.0</div><div><span class=\"ssr-pill\"><span class=\"pulse-dot\"></span> Powered by Pure Venta (www/page.va)</span></div></div></div>");

    foot
}
