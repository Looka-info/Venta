// ============================================================================
// ⚡ Venta Web UI Components Module (100% Pure Venta)
// Showcase sections authored directly in Venta matching the design specification
// ============================================================================

import std::string::String;
import dom::{Element, div, section, header, nav, footer, make_element};

// 1. Navigation
pub fn render_nav() -> Element {
    let mut n = nav();
    n.add_raw("<b>Venta</b><a href=\"https://github.com/Looka-info/Venta\">GitHub</a>");
    n
}

// 2. Hero Header
pub fn render_hero() -> Element {
    let mut h = header();
    h.set_class("hero wrap");
    h.add_raw("<div class=\"glow\"></div>");
    h.add_raw("<h1 id=\"big\" aria-label=\"Venta\"></h1>");
    h.add_raw("<div class=\"row\">");
    h.add_raw("<p>A memory-safe systems language with its own optimizer and native x86-64 backend. No LLVM.</p>");
    h.add_raw("<div class=\"cmd\"><span>npm i -g vanta-lang</span><button data-copy=\"npm i -g vanta-lang\">Copy</button></div>");
    h.add_raw("</div>");
    h
}

// 3. Statement Pinned Section
pub fn render_statement() -> Element {
    let mut s = section();
    s.set_class("stmt");
    s.set_id("stmt");
    s.set_attr("aria-label", "What Venta is");
    s.add_raw("<div class=\"w\">No garbage<br><i>collector.</i></div>");
    s.add_raw("<div class=\"w\">No LLVM.<br><i>No Cranelift.</i></div>");
    s.add_raw("<div class=\"w\">Binaries<br><i>of 22 KB.</i></div>");
    s
}

// 4. Marquee Banner
pub fn render_marquee() -> Element {
    let mut m = div();
    m.set_class("mq");
    m.set_attr("aria-hidden", "true");
    m.add_raw("<div id=\"mq\"><span>ownership</span><span>borrowing</span><span>SSA</span><span>x86-64</span><span>ELF64</span><span>self-hosted</span><span>ownership</span><span>borrowing</span><span>SSA</span><span>x86-64</span><span>ELF64</span><span>self-hosted</span></div>");
    m
}

// 5. Horizontal Track Section
pub fn render_horizontal_track() -> Element {
    let mut s = section();
    s.set_class("hs");
    s.set_id("hs");
    s.add_raw("<div class=\"head\"><span>What you get</span><span>Scroll sideways</span></div>");
    s.add_raw("<div class=\"track\" id=\"track\">");
    s.add_raw("<div class=\"p intro\"><h3>Fast<br>to build.<br>Small<br>to ship.</h3><p>Venta compiles to a standalone native executable across Linux, Windows, and macOS with a toolchain written in Rust and in Venta itself.</p></div>");
    s.add_raw("<div class=\"p\"><h3>0.24s<small>typical compile</small></h3><p>About 8x faster than rustc at -O3 on the same workloads (1.91 s), and close to GCC (0.28 s).</p></div>");
    s.add_raw("<div class=\"p\"><h3>22 KB<small>native ELF</small></h3><p>Standalone binaries around 22.5 KB, against roughly 11.8 MB for a Rust release build.</p></div>");
    s.add_raw("<div class=\"p\"><h3>Safe<small>without a GC</small></h3><p>Affine ownership, moves, and lexical borrow checking catch use-after-free and data races at compile time.</p></div>");
    s.add_raw("<div class=\"p\"><h3>14<small>optimizer passes</small></h3><p>Inlining, SROA, GVN, SCCP, LICM, loop unrolling, tail-call optimization, and trace-based block layout, each switchable from the CLI.</p></div>");
    s.add_raw("<div class=\"p\"><h3>JSON<small>diagnostics</small></h3><p>Pass --json to check, compile, or run and get machine-readable errors for editors, CI, and AI pair programmers.</p></div>");
    s.add_raw("</div>");
    s.add_raw("<div class=\"bar\" id=\"hbar\"></div>");
    s
}

// 6. Code Section with Interactive Tabs & Error Tooltip
pub fn render_code_section() -> Element {
    let mut s = section();
    s.set_class("sec wrap");
    s.set_id("code");
    s.add_raw("<h2>Mistakes fail at compile time.</h2>");
    s.add_raw("<div class=\"grid\">");
    s.add_raw("<div>");
    s.add_raw("<p style=\"font-size:clamp(18px,2vw,26px);line-height:1.3;letter-spacing:-.02em;max-width:30ch;margin:0 0 16px\">Move a value, then touch it, and Venta stops the build with error E0301.</p>");
    s.add_raw("<p class=\"mut\" style=\"max-width:44ch;margin:0\">All of it is checked before a binary exists, with zero runtime overhead and no garbage collector.</p>");
    s.add_raw("<ul class=\"gl\"><li><b>Use after free</b><span>Rejected at compile time</span></li><li><b>Dangling pointers</b><span>Rejected at compile time</span></li><li><b>Data races</b><span>Rejected at compile time</span></li></ul>");
    s.add_raw("<p class=\"mut\" style=\"font-size:14px;margin:18px 0 0\">Scroll to read the example, or switch tabs.</p>");
    s.add_raw("</div>");
    s.add_raw("<div class=\"code\" role=\"group\" aria-label=\"Venta code examples\">");
    s.add_raw("<div class=\"bt\"><i></i><i></i><i></i><div class=\"tabs\" id=\"tabs\"><button class=\"tab\" type=\"button\" aria-selected=\"true\">Move error</button><button class=\"tab\" type=\"button\" aria-selected=\"false\">Fixed</button><button class=\"tab\" type=\"button\" aria-selected=\"false\">Enums</button><button class=\"tab\" type=\"button\" aria-selected=\"false\">Traits</button></div></div>");
    s.add_raw("<pre id=\"pre\"><span class=\"ln\"><span class=\"k\">struct</span> Buffer { capacity: <span class=\"t\">i64</span>, size: <span class=\"t\">i64</span> }</span>\n<span class=\"ln\"> </span>\n<span class=\"ln\"><span class=\"k\">fn</span> process_buffer(b: &amp;Buffer) -&gt; <span class=\"t\">i64</span> {</span>\n<span class=\"ln\">    <span class=\"k\">return</span> b.size;</span>\n<span class=\"ln\">}</span>\n<span class=\"ln\"> </span>\n<span class=\"ln\"><span class=\"k\">fn</span> consume_buffer(b: Buffer) { }</span>\n<span class=\"ln\"> </span>\n<span class=\"ln\"><span class=\"k\">fn</span> main() -&gt; <span class=\"t\">i64</span> {</span>\n<span class=\"ln\">    <span class=\"k\">let</span> buf = Buffer { capacity: <span class=\"t\">1024</span>, size: <span class=\"t\">42</span> };</span>\n<span class=\"ln\">    <span class=\"k\">let</span> s = process_buffer(&amp;buf);   <span class=\"c\">// borrow: buf still valid</span></span>\n<span class=\"ln\">    consume_buffer(buf);            <span class=\"c\">// move: ownership transferred</span></span>\n<span class=\"ln bad\">    consume_buffer(buf);            <span class=\"err\">// E0301: use of moved value</span></span>\n<span class=\"ln\">    <span class=\"k\">return</span> s;</span>\n<span class=\"ln\">}</span></pre>");
    s.add_raw("<pre id=\"p1\" hidden><span class=\"k\">struct</span> Buffer { capacity: <span class=\"t\">i64</span>, size: <span class=\"t\">i64</span> }\n\n<span class=\"k\">fn</span> process_buffer(b: &amp;Buffer) -&gt; <span class=\"t\">i64</span> {\n    <span class=\"k\">return</span> b.size;\n}\n\n<span class=\"k\">fn</span> consume_buffer(b: Buffer) { }\n\n<span class=\"k\">fn</span> main() -&gt; <span class=\"t\">i64</span> {\n    <span class=\"k\">let</span> buf = Buffer { capacity: <span class=\"t\">1024</span>, size: <span class=\"t\">42</span> };\n    <span class=\"k\">let</span> s = process_buffer(&amp;buf);   <span class=\"c\">// borrow: buf still valid</span>\n    consume_buffer(buf);            <span class=\"c\">// move: ownership transferred</span>\n    <span class=\"k\">return</span> s;\n}</pre>");
    s.add_raw("<pre id=\"p2\" hidden><span class=\"k\">enum</span> ResultStatus {\n    Success(<span class=\"t\">i64</span>),\n    Failure(<span class=\"t\">i64</span>),\n    Pending,\n}\n\n<span class=\"k\">fn</span> evaluate(res: ResultStatus) -&gt; <span class=\"t\">i64</span> {\n    <span class=\"k\">match</span> res {\n        ResultStatus::Success(val) =&gt; { <span class=\"k\">return</span> val; }\n        ResultStatus::Failure(err_code) =&gt; { <span class=\"k\">return</span> -err_code; }\n        ResultStatus::Pending =&gt; { <span class=\"k\">return</span> <span class=\"t\">0</span>; }\n    }\n}</pre>");
    s.add_raw("<pre id=\"p3\" hidden><span class=\"k\">trait</span> Formatter {\n    <span class=\"k\">fn</span> format(self: &amp;Self) -&gt; <span class=\"t\">i64</span>;\n}\n\n<span class=\"k\">struct</span> Metric { value: <span class=\"t\">i64</span> }\n\n<span class=\"k\">impl</span> Formatter <span class=\"k\">for</span> Metric {\n    <span class=\"k\">fn</span> format(self: &amp;Self) -&gt; <span class=\"t\">i64</span> {\n        <span class=\"k\">return</span> self.value * <span class=\"t\">10</span>;\n    }\n}</pre>");
    s.add_raw("<div class=\"stat\" id=\"stat\"><span class=\"d\"></span><span id=\"stx\">error E0301: use of moved value</span></div>");
    s.add_raw("</div></div>");
    s
}

// 7. Benchmarks Arena & Workload Explorer
pub fn render_benchmarks() -> Element {
    let mut s = section();
    s.set_class("sec wrap");
    s.set_id("bench");
    s.add_raw("<h2>Where it wins. Where it doesn’t.</h2>");
    s.add_raw("<div class=\"sx\">");
    s.add_raw("<div><b><span class=\"cnt\" data-to=\"8\" data-d=\"0\">8</span>x</b><p>faster to compile than rustc -O3. 0.24 s against 1.91 s.</p></div>");
    s.add_raw("<div><b><span class=\"cnt\" data-to=\"520\" data-d=\"0\">520</span>x</b><p>smaller than a Rust release binary. 22.5 KB against 11.8 MB.</p></div>");
    s.add_raw("<div><b>0</b><p>external backends. No LLVM, no Cranelift, no GCC backend.</p></div>");
    s.add_raw("</div>");
    s.add_raw("<div class=\"rx\">");
    s.add_raw("<div class=\"rh\"><h3>Runtime, workload by workload</h3><p id=\"sb\"></p></div>");
    s.add_raw("<div class=\"chips\" id=\"chips\" role=\"group\" aria-label=\"Pick a workload\"></div>");
    s.add_raw("<div id=\"rb\">");
    s.add_raw("<div class=\"rr v\"><span>Venta -O1</span><div class=\"t\"><div class=\"f\"></div></div><span class=\"n\"></span></div>");
    s.add_raw("<div class=\"rr g\"><span>GCC -O3</span><div class=\"t\"><div class=\"f\"></div></div><span class=\"n\"></span></div>");
    s.add_raw("<div class=\"rr r\"><span>Rust -O3</span><div class=\"t\"><div class=\"f\"></div></div><span class=\"n\"></span></div>");
    s.add_raw("</div>");
    s.add_raw("<p id=\"rv\" aria-live=\"polite\"></p>");
    s.add_raw("</div>");
    s.add_raw("<div class=\"grid\">");
    s.add_raw("<div class=\"bars\" id=\"bars\">");
    s.add_raw("<h3 class=\"sh\">What the optimizer buys you</h3>");
    s.add_raw("<div class=\"br\" data-v=\"4.19\"><div class=\"l\"><span>Unroll and peel</span><span>4.19x</span></div><div class=\"t\"><div class=\"f\"></div></div></div>");
    s.add_raw("<div class=\"br\" data-v=\"2.61\"><div class=\"l\"><span>SROA</span><span>2.61x</span></div><div class=\"t\"><div class=\"f\"></div></div></div>");
    s.add_raw("<div class=\"br\" data-v=\"2.49\"><div class=\"l\"><span>LICM</span><span>2.49x</span></div><div class=\"t\"><div class=\"f\"></div></div></div>");
    s.add_raw("<div class=\"br\" data-v=\"1.87\"><div class=\"l\"><span>CSE and GVN</span><span>1.87x</span></div><div class=\"t\"><div class=\"f\"></div></div></div>");
    s.add_raw("<div class=\"br\" data-v=\"1.85\"><div class=\"l\"><span>Inlining, leaf calls</span><span>1.85x</span></div><div class=\"t\"><div class=\"f\"></div></div></div>");
    s.add_raw("<div class=\"br\" data-v=\"1.49\"><div class=\"l\"><span>Tail-call optimization</span><span>1.49x</span></div><div class=\"t\"><div class=\"f\"></div></div></div>");
    s.add_raw("<p class=\"note\" style=\"margin:6px 0 0\">Speedup of Venta -O1 over Venta -O0.</p>");
    s.add_raw("</div>");
    s.add_raw("<div>");
    s.add_raw("<h3 class=\"sh\" style=\"margin-bottom:14px\">Compile time and size</h3>");
    s.add_raw("<table>");
    s.add_raw("<tr><th></th><th>Venta</th><th>Rust -O3</th><th>GCC -O3</th></tr>");
    s.add_raw("<tr><th>Compile</th><td class=\"v\"><span class=\"cnt\" data-to=\"0.24\" data-d=\"2\">0.24</span> s</td><td class=\"v\">1.91 s</td><td class=\"v\">0.28 s</td></tr>");
    s.add_raw("<tr><th>Binary</th><td class=\"v\"><span class=\"cnt\" data-to=\"22.5\" data-d=\"1\">22.5</span> KB</td><td class=\"v\">11.8 MB</td><td class=\"v\">16.0 KB</td></tr>");
    s.add_raw("<tr><th>Backend</th><td class=\"v\">None</td><td class=\"v\">LLVM</td><td class=\"v\">GCC</td></tr>");
    s.add_raw("</table>");
    s.add_raw("<p class=\"note\">Runtime is a different story: GCC and Rust -O3 are faster than Venta on most workloads in the same suite. Venta’s edge is build time, binary size, and a toolchain with no external backend. Source: benchmarks/results/milestone-25-release-audit.json, AMD x86-64, Linux 6.6.</p>");
    s.add_raw("</div></div>");
    s
}

// 8. Pipeline Pinned Steps
pub fn render_pipeline() -> Element {
    let mut s = section();
    s.set_class("pipe");
    s.set_id("pipe");
    s.set_attr("aria-label", "Compiler pipeline");
    s.add_raw("<div class=\"in wrap\">");
    s.add_raw("<div><div id=\"pn\">Source</div><p id=\"pd\">Your Venta code, in a plain .va file.</p></div>");
    s.add_raw("<ol id=\"pl\">");
    s.add_raw("<li data-d=\"Your Venta code, in a plain .va file.\">Source</li>");
    s.add_raw("<li data-d=\"Scans the text into tokens.\">Lexer</li>");
    s.add_raw("<li data-d=\"Recursive descent with precedence climbing builds the syntax tree.\">Parser</li>");
    s.add_raw("<li data-d=\"Type checks the program and enforces affine borrowing at compile time.\">Borrow checker</li>");
    s.add_raw("<li data-d=\"Lowers to a control-flow graph in static single assignment form.\">SSA MIR</li>");
    s.add_raw("<li data-d=\"Fourteen verified passes rewrite the MIR for speed.\">Optimizer</li>");
    s.add_raw("<li data-d=\"A linear-scan allocator assigns physical registers.\">Register allocator</li>");
    s.add_raw("<li data-d=\"Machine code is encoded directly. No assembler, no LLVM.\">x86-64 encoder</li>");
    s.add_raw("<li data-d=\"A relocatable object file is written by the Rust toolchain itself.\">ELF64 writer</li>");
    s.add_raw("<li data-d=\"Linked with a small C runtime into a native executable of about 22.5 KB.\">Native binary</li>");
    s.add_raw("</ol></div>");
    s
}

// 9. 14-Pass Optimizer Grid
pub fn render_optimizer() -> Element {
    let mut s = section();
    s.set_class("sec wrap");
    s.set_id("opt");
    s.add_raw("<h2>Fourteen passes, one sweep.</h2>");
    s.add_raw("<div class=\"opt\">");
    s.add_raw("<div><b>Inlining</b><span>Small and leaf callees fold into callers.</span></div>");
    s.add_raw("<div><b>SROA</b><span>Splits stack aggregates into scalars.</span></div>");
    s.add_raw("<div><b>GVN / CSE</b><span>Removes repeated computations.</span></div>");
    s.add_raw("<div><b>SCCP</b><span>Propagates constants through branches.</span></div>");
    s.add_raw("<div><b>LICM</b><span>Hoists loop-invariant work out of loops.</span></div>");
    s.add_raw("<div><b>IVO</b><span>Canonicalizes induction variables.</span></div>");
    s.add_raw("<div><b>LSR</b><span>Turns costly operations into recurrences.</span></div>");
    s.add_raw("<div><b>Loop peeling</b><span>Splits off the first iterations.</span></div>");
    s.add_raw("<div><b>Loop unrolling</b><span>Repeats loop bodies 2x or 4x.</span></div>");
    s.add_raw("<div><b>Global DCE</b><span>Drops code that nothing uses.</span></div>");
    s.add_raw("<div><b>Scheduling</b><span>Reorders instructions by latency.</span></div>");
    s.add_raw("<div><b>TCO</b><span>Self tail calls become loops.</span></div>");
    s.add_raw("<div><b>Branch inversion</b><span>Favors fall-through jumps.</span></div>");
    s.add_raw("<div><b>Trace layout</b><span>Orders blocks for the cache.</span></div>");
    s.add_raw("<div><b>Verify in</b><span>Checks MIR invariants before optimizing.</span></div>");
    s.add_raw("<div><b>Verify out</b><span>Re-checks the MIR after optimizing.</span></div>");
    s.add_raw("</div>");
    s.add_raw("<p class=\"note\">Every pass can be turned off from the CLI, for example --no-licm or --unroll-factor=4.</p>");
    s
}

// 10. Ecosystem Cards
pub fn render_ecosystem() -> Element {
    let mut s = section();
    s.set_class("sec wrap");
    s.set_id("eco");
    s.add_raw("<h2>Written in Venta.</h2>");
    s.add_raw("<div class=\"eco\">");
    s.add_raw("<div class=\"w3\"><b>86 KB</b><div><h4>VentaNext</h4><p>A Next.js-style framework in pure Venta: routing, server-side rendering, JSON API routes, and middleware, as one native binary.</p></div></div>");
    s.add_raw("<div class=\"w3\"><b>37 KB</b><div><h4>HTTP server</h4><p>This showcase’s own server is pure Venta on std::net, with no C dependencies.</p></div></div>");
    s.add_raw("<div><b>.va</b><div><h4>VS Code</h4><p>Grammar, brackets, and gold lightning file icons.</p></div></div>");
    s.add_raw("<div><b>npm</b><div><h4>vanta-lang</h4><p>Install the vanta and vantac commands globally.</p></div></div>");
    s.add_raw("<div><b>100%</b><div><h4>Self-hosted</h4><p>A compiler written in Venta that emits System V AMD64 assembly.</p></div></div>");
    s.add_raw("</div>");
    s
}

// 11. Start Steps
pub fn render_start_steps() -> Element {
    let mut s = section();
    s.set_class("sec wrap");
    s.set_id("start");
    s.add_raw("<h2>Run your first program.</h2>");
    s.add_raw("<div class=\"steps\">");
    s.add_raw("<div class=\"st\"><h4>Install</h4><p>From npm. A shell installer and release tarballs also work.</p><div class=\"cmd\"><span>npm i -g vanta-lang</span><button data-copy=\"npm i -g vanta-lang\">Copy</button></div></div>");
    s.add_raw("<div class=\"st\"><h4>Check</h4><p>Type check and borrow check without compiling.</p><div class=\"cmd\"><span>vanta check src/main.va</span><button data-copy=\"vanta check src/main.va\">Copy</button></div></div>");
    s.add_raw("<div class=\"st\"><h4>Run</h4><p>Compile at -O1 and execute in one step.</p><div class=\"cmd\"><span>vanta run src/main.va</span><button data-copy=\"vanta run src/main.va\">Copy</button></div></div>");
    s.add_raw("</div>");
    s
}

// 12. Footer
pub fn render_footer() -> Element {
    let mut f = footer();
    f.set_class("fin wrap");
    f.add_raw("<h2>Build fast.</h2>");
    f.add_raw("<div class=\"acts\"><a class=\"btn\" href=\"https://github.com/Looka-info/Venta\">View on GitHub</a><a class=\"btn o\" href=\"https://github.com/Looka-info/Venta/releases\">Download v1.0-RC2</a></div>");
    f.add_raw("<small>MIT License. Multi-Platform: Linux x86-64, Windows x86-64, macOS Apple Silicon.</small>");
    f
}

// Backward-compatible aliases
pub fn render_navbar() -> Element { render_nav() }
pub fn render_pitch() -> Element { render_statement() }
pub fn render_features() -> Element { render_horizontal_track() }
pub fn render_code_showcase() -> Element { render_code_section() }
pub fn render_self_hosting() -> Element { render_ecosystem() }
pub fn render_get_started() -> Element { render_start_steps() }
