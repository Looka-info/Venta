import std::result::Result;
import std::string::String;

extern "C" {
    pub fn curl_global_init(flags: i64) -> i32;
    pub fn curl_global_cleanup();
    pub fn curl_easy_init() -> i64;
    pub fn curl_easy_cleanup(curl: i64);
    pub fn curl_easy_setopt(curl: i64, option: i32, param: i64) -> i32;
    pub fn curl_easy_getinfo(curl: i64, info: i32, out: &mut i64) -> i32;
    pub fn curl_easy_perform(curl: i64) -> i32;
    pub fn curl_easy_strerror(code: i32) -> i64;
    pub fn curl_slist_append(list: i64, string: i64) -> i64;
    pub fn curl_slist_free_all(list: i64);

    // Runtime bridge functions
    pub fn vanta_ptr_to_i64(p: &mut String) -> i64;
    pub fn vanta_read_stream_to_i64(s: &mut ReadStream) -> i64;
    pub fn vanta_curl_get_write_callback() -> i64;
    pub fn vanta_curl_get_read_callback() -> i64;
}

// Option constants
pub fn opt_url() -> i32 { 10002 }
pub fn opt_writedata() -> i32 { 10001 }
pub fn opt_writefunction() -> i32 { 20011 }
pub fn opt_headerdata() -> i32 { 10029 }
pub fn opt_headerfunction() -> i32 { 20079 }
pub fn opt_followlocation() -> i32 { 52 }
pub fn opt_timeout() -> i32 { 13 }
pub fn opt_useragent() -> i32 { 10018 }
pub fn opt_post() -> i32 { 47 }
pub fn opt_postfields() -> i32 { 10015 }
pub fn opt_postfieldsize() -> i32 { 60 }
pub fn opt_readfunction() -> i32 { 20012 }
pub fn opt_readdata() -> i32 { 10009 }
pub fn opt_httpheader() -> i32 { 10023 }
pub fn opt_customrequest() -> i32 { 10036 }

// Info constants
pub fn info_response_code() -> i32 { 2097154 }

pub fn global_init() -> i32 {
    // CURL_GLOBAL_ALL = 3
    curl_global_init(3)
}

pub fn global_cleanup() {
    curl_global_cleanup();
}

pub struct HeaderList {
    pub handle: i64,
}

pub fn new_header_list() -> HeaderList {
    HeaderList { handle: 0 }
}

impl HeaderList {
    pub fn append(self: &mut Self, header: &str) {
        let s = String::from_str(header);
        self.handle = curl_slist_append(self.handle, s.data_ptr);
    }

    pub fn is_empty(self: &Self) -> bool {
        self.handle == 0
    }

    pub fn cleanup(self: &mut Self) {
        if self.handle != 0 {
            curl_slist_free_all(self.handle);
            self.handle = 0;
        }
    }
}

pub struct ReadStream {
    pub data_ptr: i64,
    pub len: i64,
    pub offset: i64,
}

pub fn new_read_stream(src: &String) -> ReadStream {
    ReadStream {
        data_ptr: src.data_ptr,
        len: src.len,
        offset: 0,
    }
}

pub fn new_read_stream_raw(data_ptr: i64, len: i64) -> ReadStream {
    ReadStream {
        data_ptr: data_ptr,
        len: len,
        offset: 0,
    }
}

pub struct Easy {
    pub handle: i64,
}

pub struct Response {
    pub status_code: i64,
    pub body: String,
    pub headers: String,
}

pub fn new_easy() -> Easy {
    let handle = curl_easy_init();
    Easy { handle: handle }
}

impl Easy {
    pub fn is_valid(self: &Self) -> bool {
        self.handle != 0
    }

    pub fn set_url(self: &Self, url: &str) -> i32 {
        let url_str = String::from_str(url);
        curl_easy_setopt(self.handle, 10002, url_str.data_ptr)
    }

    pub fn set_headers(self: &Self, headers: &HeaderList) -> i32 {
        curl_easy_setopt(self.handle, 10023, headers.handle)
    }

    pub fn clear_headers(self: &Self) -> i32 {
        curl_easy_setopt(self.handle, 10023, 0)
    }

    pub fn set_post(self: &Self, enable: bool) -> i32 {
        let mut val: i64 = 0;
        if enable {
            val = 1;
        }
        curl_easy_setopt(self.handle, 47, val)
    }

    pub fn set_post_fields(self: &Self, data: &String) -> i32 {
        let rc1 = curl_easy_setopt(self.handle, 47, 1);
        let rc2 = curl_easy_setopt(self.handle, 10015, data.data_ptr);
        let rc3 = curl_easy_setopt(self.handle, 60, data.len);
        if rc1 != 0 {
            return rc1;
        }
        if rc2 != 0 {
            return rc2;
        }
        rc3
    }

    pub fn set_post_fields_raw(self: &Self, data_ptr: i64, len: i64) -> i32 {
        let rc1 = curl_easy_setopt(self.handle, 47, 1);
        let rc2 = curl_easy_setopt(self.handle, 10015, data_ptr);
        let rc3 = curl_easy_setopt(self.handle, 60, len);
        if rc1 != 0 {
            return rc1;
        }
        if rc2 != 0 {
            return rc2;
        }
        rc3
    }

    pub fn set_post_field_size(self: &Self, size: i64) -> i32 {
        curl_easy_setopt(self.handle, 60, size)
    }

    pub fn set_custom_request(self: &Self, method: &str) -> i32 {
        let s = String::from_str(method);
        curl_easy_setopt(self.handle, 10036, s.data_ptr)
    }

    pub fn set_read_stream(self: &Self, stream: &mut ReadStream) -> i32 {
        let cb = vanta_curl_get_read_callback();
        let ptr = vanta_read_stream_to_i64(stream);
        let rc1 = curl_easy_setopt(self.handle, 20012, cb);
        let rc2 = curl_easy_setopt(self.handle, 10009, ptr);
        if rc1 != 0 {
            return rc1;
        }
        if rc2 != 0 {
            return rc2;
        }
        curl_easy_setopt(self.handle, 60, stream.len)
    }

    pub fn set_follow_location(self: &Self, enable: bool) -> i32 {
        let mut val: i64 = 0;
        if enable {
            val = 1;
        }
        curl_easy_setopt(self.handle, 52, val)
    }

    pub fn set_timeout(self: &Self, seconds: i64) -> i32 {
        curl_easy_setopt(self.handle, 13, seconds)
    }

    pub fn set_user_agent(self: &Self, user_agent: &str) -> i32 {
        let ua_str = String::from_str(user_agent);
        curl_easy_setopt(self.handle, 10018, ua_str.data_ptr)
    }

    pub fn set_write_buffer(self: &Self, dest: &mut String) -> i32 {
        let cb = vanta_curl_get_write_callback();
        let ptr = vanta_ptr_to_i64(dest);
        let rc1 = curl_easy_setopt(self.handle, 20011, cb);
        let rc2 = curl_easy_setopt(self.handle, 10001, ptr);
        if rc1 != 0 {
            return rc1;
        }
        rc2
    }

    pub fn set_header_buffer(self: &Self, dest: &mut String) -> i32 {
        let cb = vanta_curl_get_write_callback();
        let ptr = vanta_ptr_to_i64(dest);
        let rc1 = curl_easy_setopt(self.handle, 20079, cb);
        let rc2 = curl_easy_setopt(self.handle, 10029, ptr);
        if rc1 != 0 {
            return rc1;
        }
        rc2
    }

    pub fn perform(self: &Self) -> Result<i32, i32> {
        let rc = curl_easy_perform(self.handle);
        if rc == 0 {
            Result::Ok(rc)
        } else {
            Result::Err(rc)
        }
    }

    pub fn response_code(self: &Self) -> i64 {
        let mut code: i64 = 0;
        curl_easy_getinfo(self.handle, 2097154, &mut code);
        code
    }

    pub fn fetch(self: &Self) -> Result<Response, i32> {
        let mut body = String {
            data_ptr: 0,
            len: 0,
            cap: 0,
        };
        let mut headers = String {
            data_ptr: 0,
            len: 0,
            cap: 0,
        };

        self.set_write_buffer(&mut body);
        self.set_header_buffer(&mut headers);

        let perf_res = self.perform();
        match perf_res {
            Result::Ok(_) => {
                let code = self.response_code();
                Result::Ok(Response {
                    status_code: code,
                    body: body,
                    headers: headers,
                })
            },
            Result::Err(e) => {
                Result::Err(e)
            }
        }
    }

    pub fn cleanup(self: &Self) {
        if self.handle != 0 {
            curl_easy_cleanup(self.handle);
        }
    }
}
